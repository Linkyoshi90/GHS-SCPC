+// Work recorded since the last FlushRun: draws (records + texel tables) and CLUT loads that can run as one
+// CLUT dispatch and one tiled draw dispatch. Per 8 KB VRAM page what the run does there, to find hazards:
+// pixels of one frame/Z buffer (same base, width, format) map to distinct addresses, so a thread per pixel
+// keeps their order; a page used by two buffers, or written and read as texture, needs the order between
+// threads, and a CLUT load reads VRAM before the run's draws.
+struct GSGpuBackend::Run
+{
+    struct Box
+    {
+        uint32_t record;
+        int x0, y0, x1, y1;
+    };
+    using Pages = std::bitset<kPages>;
+    struct Buffer
+    {
+        uint32_t page, bw;
+        uint8_t psm;
+        Pages pages;
+        bool same(uint32_t p, uint32_t w, uint8_t f) const { return page == p && bw == w && psm == f; }
+    };
+    std::vector<uint32_t> words; // records and texel tables; at the flush also CLUT loads and tile bins
+    std::vector<uint32_t> loads; // CLUT loads not dispatched yet, kClutLoadWords each
+    uint32_t loadsDone = 0;      // CLUT loads already dispatched (FlushCluts), into versions clutFirst + 1 ...
+    uint32_t clutFirst = 0;      // with loadsDone: the CLUT version of the run's first draw
+    std::vector<Box> boxes;
+    std::vector<uint32_t> tileCount, tiles; // per 16x16 tile (128 x 128 of them): draws, then list position; tiles in use
+    std::vector<Buffer> buffers;            // frame/Z buffers the run uses
+    Pages used, texRead, texReadTop, clutRead;
+
+    // Pages [p0, p1) (clipped to VRAM).
+    static Pages range(uint32_t p0, uint32_t p1)
+    {
+        p1 = std::min(p1, kPages);
+        Pages m;
+        if (p0 >= p1)
+            return m;
+        m.set();
+        m >>= kPages - (p1 - p0);
+        return m <<= p0;
+    }
+    bool empty() const { return boxes.empty() && loads.empty(); }
+    void clear()
+    {
+        words.clear();
+        loads.clear();
+        loadsDone = 0;
+        boxes.clear();
+        buffers.clear();
+        used.reset();
+        texRead.reset();
+        texReadTop.reset();
+        clutRead.reset();
+    }
+    // A buffer's pages used by another buffer or read as texture (a top-byte texture only matters if this
+    // buffer's stores change bits 24-31).
+    bool bufferConflict(uint32_t page, uint32_t bw, uint8_t psm, const Pages &m) const
+    {
+        if ((m & texRead).any() || (!keepsTopByte(psm) && (m & texReadTop).any()))
+            return true;
+        for (const Buffer &b : buffers)
+            if (!b.same(page, bw, psm) && (b.pages & m).any())
+                return true;
+        return false;
+    }
+    void addBuffer(uint32_t page, uint32_t bw, uint8_t psm, const Pages &m)
+    {
+        used |= m;
+        for (Buffer &b : buffers)
+            if (b.same(page, bw, psm))
+            {
+                b.pages |= m;
+                return;
+            }
+        buffers.push_back({page, bw, psm, m});
+    }
+    bool written(const Pages &m, bool topByteOnly) const
+    {
+        if (!(used & m).any())
+            return false;
+        for (const Buffer &b : buffers)
+            if ((b.pages & m).any() && !(topByteOnly && keepsTopByte(b.psm)))
+                return true;
+        return false;
+    }
+};
