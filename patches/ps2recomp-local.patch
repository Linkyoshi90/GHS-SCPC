+            {
+                const GSVertex &v = b.vertices[k];
+                used += std::snprintf(what + used, sizeof(what) - used, " (%.4f %.4f %.0f %u %u %u %u %u uv %u %u stq %g %g %g)", v.x, v.y, v.z, v.r, v.g, v.b, v.a,
