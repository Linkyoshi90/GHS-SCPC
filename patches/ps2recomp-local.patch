diff --git a/ps2xRuntime/src/lib/Kernel/GhsRumble.cpp b/ps2xRuntime/src/lib/Kernel/GhsRumble.cpp
new file mode 100644
index 0000000..9a22c04
--- /dev/null
+++ b/ps2xRuntime/src/lib/Kernel/GhsRumble.cpp
@@ -0,0 +1,32 @@
+// GHS: controller vibration. The game's actuator data (Stubs/Pad.cpp scePadSetActDirect: the small motor on/off and
+// the large one 0-255) goes to XInput controllers (raylib's desktop backend has no vibration); F2 -> Controls turns it
+// off. Windows only; elsewhere a no-op.
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <Xinput.h>
+#pragma comment(lib, "Xinput9_1_0.lib")
+#endif
+#include <cstdint>
+
+extern bool g_ghsRumble; // ps2_pad.cpp
+
+void ghsRumble(uint8_t small, uint8_t large)
+{
+#ifdef _WIN32
+    static int lastSmall = -1, lastLarge = -1;
+    if (!g_ghsRumble)
+        small = large = 0;
+    if (small == lastSmall && large == lastLarge) // the game sends it every frame
+        return;
+    lastSmall = small;
+    lastLarge = large;
+    // XInput: left = the low-frequency (large) motor, right = the high-frequency (small) one.
+    XINPUT_VIBRATION v{static_cast<WORD>(large * 257u), static_cast<WORD>(small != 0u ? 0xC000u : 0u)};
+    for (DWORD pad = 0; pad < XUSER_MAX_COUNT; ++pad) // whichever is connected; the others just fail
+        XInputSetState(pad, &v);
+#else
+    (void)small;
+    (void)large;
+#endif
+}
diff --git a/ps2xRuntime/src/lib/Kernel/GhsStackDump.cpp b/ps2xRuntime/src/lib/Kernel/GhsStackDump.cpp
new file mode 100644
index 0000000..448dfaa
--- /dev/null
+++ b/ps2xRuntime/src/lib/Kernel/GhsStackDump.cpp
@@ -0,0 +1,531 @@
+// GHS-TRACE (temporary): print every thread's call stack, for the watchdog in ps2_runtime.cpp.
+// Separate file because windows.h clashes with raylib. Symbols need the /DEBUG link flag.
+#ifdef _WIN32
+#include <windows.h>
+#include <dbghelp.h>
+#include <fcntl.h>
+#include <io.h>
+#include <tlhelp32.h>
+#include <algorithm>
+#include <atomic>
+#include <cstdio>
+#include <ctime>
+#include <cstring>
+#include <cwchar>
+#include <cstdlib>
+#include <string>
+#include <thread>
+#include <unordered_map>
+#include <vector>
+#pragma comment(lib, "dbghelp.lib")
+
+void ghsDumpAllThreadStacks()
+{
+    HANDLE process = GetCurrentProcess();
+    SymSetOptions(SYMOPT_UNDNAME | SYMOPT_DEFERRED_LOADS);
+    SymInitialize(process, nullptr, TRUE);
+    HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+    THREADENTRY32 te{};
+    te.dwSize = sizeof(te);
+    for (BOOL ok = Thread32First(snap, &te); ok; ok = Thread32Next(snap, &te))
+    {
+        if (te.th32OwnerProcessID != GetCurrentProcessId() || te.th32ThreadID == GetCurrentThreadId())
+            continue;
+        HANDLE th = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_LIMITED_INFORMATION, FALSE, te.th32ThreadID);
+        if (!th)
+            continue;
+        // Only unwind while the thread is suspended (no allocation: it may hold the heap or stderr lock).
+        DWORD64 pcs[40];
+        int n = 0;
+        SuspendThread(th);
+        CONTEXT c{};
+        c.ContextFlags = CONTEXT_FULL;
+        if (GetThreadContext(th, &c))
+        {
+            while (n < 40 && c.Rip != 0)
+            {
+                pcs[n++] = c.Rip;
+                DWORD64 imageBase = 0;
+                PRUNTIME_FUNCTION fn = RtlLookupFunctionEntry(c.Rip, &imageBase, nullptr);
+                if (!fn)
+                { // leaf function: the return address is on top of the stack
+                    c.Rip = *reinterpret_cast<DWORD64 *>(c.Rsp);
+                    c.Rsp += 8;
+                    continue;
+                }
+                void *handlerData = nullptr;
+                DWORD64 establisher = 0;
+                RtlVirtualUnwind(UNW_FLAG_NHANDLER, imageBase, c.Rip, fn, &c, &handlerData, &establisher, nullptr);
+            }
+        }
+        ResumeThread(th);
+
+        PWSTR desc = nullptr;
+        char name[128] = "";
+        if (SUCCEEDED(GetThreadDescription(th, &desc)) && desc)
+        {
+            WideCharToMultiByte(CP_UTF8, 0, desc, -1, name, sizeof(name), nullptr, nullptr);
+            LocalFree(desc);
+        }
+        CloseHandle(th);
+        std::fprintf(stderr, "[GHS-STACK] thread %lu %s\n", te.th32ThreadID, name);
+        for (int i = 0; i < n; ++i)
+        {
+            alignas(SYMBOL_INFO) char buf[sizeof(SYMBOL_INFO) + 256] = {};
+            auto *sym = reinterpret_cast<SYMBOL_INFO *>(buf);
+            sym->SizeOfStruct = sizeof(SYMBOL_INFO);
+            sym->MaxNameLen = 255;
+            DWORD64 disp = 0;
+            if (SymFromAddr(process, pcs[i], &disp, sym))
+                std::fprintf(stderr, "  %s+0x%llx\n", sym->Name, static_cast<unsigned long long>(disp));
+            else
+                std::fprintf(stderr, "  0x%llx\n", static_cast<unsigned long long>(pcs[i]));
+        }
+    }
+    CloseHandle(snap);
+    std::fflush(stderr);
+}
+
+// Samples the thread named "GameThread" every ~1 ms for `seconds` and prints the hottest
+// functions (by symbol). Native PCs, so recompiled guest functions show up as FUN_/entry_ names.
+void ghsProfileGameThread(int seconds, const wchar_t *threadName)
+{
+    HANDLE process = GetCurrentProcess();
+    SymSetOptions(SYMOPT_UNDNAME | SYMOPT_DEFERRED_LOADS | SYMOPT_LOAD_LINES);
+    SymInitialize(process, nullptr, TRUE);
+    HANDLE game = nullptr;
+    HANDLE snap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+    THREADENTRY32 te{};
+    te.dwSize = sizeof(te);
+    for (BOOL ok = Thread32First(snap, &te); ok && !game; ok = Thread32Next(snap, &te))
+    {
+        if (te.th32OwnerProcessID != GetCurrentProcessId())
+            continue;
+        HANDLE th = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_LIMITED_INFORMATION, FALSE, te.th32ThreadID);
+        if (!th)
+            continue;
+        PWSTR desc = nullptr;
+        if (SUCCEEDED(GetThreadDescription(th, &desc)) && desc)
+        {
+            if (wcscmp(desc, threadName) == 0)
+                game = th;
+            LocalFree(desc);
+        }
+        if (game != th)
+            CloseHandle(th);
+    }
+    CloseHandle(snap);
+    if (!game)
+    {
+        std::fprintf(stderr, "[GHS-HOSTPROF] %ls not found\n", threadName);
+        return;
+    }
+
+    // Each sample unwinds the stack (while suspended, no allocation) so the report can show
+    // inclusive time per function, not just the leaf (leaf names can mislead: tiny functions get
+    // folded together by the linker).
+    constexpr int kMaxFrames = 48;
+    std::vector<DWORD64> frames;     // all samples' PCs, kMaxFrames slots per sample
+    std::vector<uint8_t> frameCount; // used slots per sample
+    const DWORD64 end = GetTickCount64() + static_cast<DWORD64>(seconds) * 1000u;
+    while (GetTickCount64() < end)
+    {
+        DWORD64 pcs[kMaxFrames];
+        int n = 0;
+        SuspendThread(game);
+        CONTEXT c{};
+        c.ContextFlags = CONTEXT_FULL;
+        if (GetThreadContext(game, &c))
+        {
+            while (n < kMaxFrames && c.Rip != 0)
+            {
+                pcs[n++] = c.Rip;
+                DWORD64 imageBase = 0;
+                PRUNTIME_FUNCTION fn = RtlLookupFunctionEntry(c.Rip, &imageBase, nullptr);
+                if (!fn)
+                {
+                    c.Rip = *reinterpret_cast<DWORD64 *>(c.Rsp);
+                    c.Rsp += 8;
+                    continue;
+                }
+                void *handlerData = nullptr;
+                DWORD64 establisher = 0;
+                RtlVirtualUnwind(UNW_FLAG_NHANDLER, imageBase, c.Rip, fn, &c, &handlerData, &establisher, nullptr);
+            }
+        }
+        ResumeThread(game);
+        if (n > 0)
+        {
+            frames.insert(frames.end(), pcs, pcs + n);
+            frames.resize(frames.size() + (kMaxFrames - n));
+            frameCount.push_back(static_cast<uint8_t>(n));
+        }
+        Sleep(1);
+    }
+    CloseHandle(game);
+
+    std::unordered_map<DWORD64, std::string> names;
+    const auto nameOf = [&](DWORD64 pc) -> const std::string &
+    {
+        auto it = names.find(pc);
+        if (it != names.end())
+            return it->second;
+        alignas(SYMBOL_INFO) char buf[sizeof(SYMBOL_INFO) + 256] = {};
+        auto *sym = reinterpret_cast<SYMBOL_INFO *>(buf);
+        sym->SizeOfStruct = sizeof(SYMBOL_INFO);
+        sym->MaxNameLen = 255;
+        DWORD64 disp = 0;
+        char fallback[32];
+        std::snprintf(fallback, sizeof(fallback), "0x%llx", static_cast<unsigned long long>(pc));
+        return names.emplace(pc, SymFromAddr(process, pc, &disp, sym) ? std::string(sym->Name) : std::string(fallback)).first->second;
+    };
+    std::unordered_map<std::string, uint32_t> leaf, inclusive;
+    const uint32_t total = static_cast<uint32_t>(frameCount.size());
+    for (uint32_t sample = 0; sample < total; ++sample)
+    {
+        const DWORD64 *pcs = frames.data() + static_cast<size_t>(sample) * kMaxFrames;
+        ++leaf[nameOf(pcs[0])];
+        std::vector<const std::string *> seen;
+        for (int f = 0; f < frameCount[sample]; ++f)
+        {
+            const std::string &name = nameOf(pcs[f]);
+            if (std::find(seen.begin(), seen.end(), &name) == seen.end())
+            {
+                seen.push_back(&name);
+                ++inclusive[name];
+            }
+        }
+    }
+    const auto print = [&](const char *title, const std::unordered_map<std::string, uint32_t> &counts, size_t limit)
+    {
+        std::vector<std::pair<uint32_t, std::string>> sorted;
+        for (auto &[name, count] : counts)
+            sorted.emplace_back(count, name);
+        std::sort(sorted.rbegin(), sorted.rend());
+        std::fprintf(stderr, "[GHS-HOSTPROF] %s, %u samples over %d s (%ls):\n", title, total, seconds, threadName);
+        for (size_t i = 0; i < sorted.size() && i < limit; ++i)
+            std::fprintf(stderr, "  %5.1f%% %s\n", 100.0 * sorted[i].first / (total ? total : 1), sorted[i].second.c_str());
+    };
+    print("leaf", leaf, 30);
+    // The same with template arguments dropped (thousands of staticPair<...>/fmac<...> instances).
+    std::unordered_map<std::string, uint32_t> leafGroups;
+    for (auto &[name, count] : leaf)
+    {
+        std::string group = name.substr(0, name.find('<'));
+        if (const size_t block = group.find("::block_"); block != std::string::npos) // translated VU1 blocks: one entry per image
+            group = group.substr(0, group.rfind('_')) + "_*";
+        leafGroups[group] += count;
+    }
+    print("leaf by function", leafGroups, 30);
+    print("inclusive", inclusive, 60);
+    // Leaf samples by source line (where inside the hot functions the time goes).
+    std::unordered_map<std::string, uint32_t> lines;
+    for (uint32_t sample = 0; sample < total; ++sample)
+    {
+        const DWORD64 pc = frames[static_cast<size_t>(sample) * kMaxFrames];
+        IMAGEHLP_LINE64 line{};
+        line.SizeOfStruct = sizeof(line);
+        DWORD disp = 0;
+        char key[300];
+        if (SymGetLineFromAddr64(process, pc, &disp, &line))
+        {
+            const char *file = std::strrchr(line.FileName, '\\');
+            std::snprintf(key, sizeof(key), "%s:%lu (%s)", file ? file + 1 : line.FileName, line.LineNumber, nameOf(pc).c_str());
+        }
+        else
+            std::snprintf(key, sizeof(key), "%s", nameOf(pc).c_str());
+        ++lines[key];
+    }
+    print("leaf lines", lines, 200);
+    std::unordered_map<std::string, uint32_t> lineGroups; // the same summed over template instances
+    for (auto &[key, count] : lines)
+        lineGroups[key.substr(0, key.find(" ("))] += count;
+    print("leaf lines by line", lineGroups, 50);
+    std::fflush(stderr);
+}
+
+// The log writer (ps2_runtime.cpp starts it). stdout/stderr are fully buffered and every write takes the stream's
+// lock; a flush writes the buffer to the log file while holding it. Log files on a busy disk (or being scanned)
+// made a flush take up to ~280 ms (the render loop's 100 ms flush, [GHS-HOSTPARTS] "log flush"), and the game thread
+// waited at its next log line (door to the hallway: ~40 % of 5 s in fprintf). Now a stream that goes to a file goes
+// through a pipe with a 4 MB buffer instead: a flush only copies into the pipe, and a thread of its own writes the
+// pipe to the file. At exit and at the end of a crash report the pipe is drained (ghsDrainLogs). A console (or
+// anything but a file) stays as it was. GHS-TRACE: GHS_LOG_DIRECT=1 keeps the direct writes.
+namespace
+{
+    struct LogPipe
+    {
+        HANDLE read = nullptr;
+        HANDLE file = nullptr; // the original target (a duplicate of the redirected handle)
+        int fd = -1;
+        std::thread writer;
+        std::atomic<bool> writing{false}; // the writer holds read bytes not in the file yet
+    };
+    LogPipe g_logPipes[2]; // stdout, stderr
+
+    void drainLogs()
+    {
+        std::fflush(stdout);
+        std::fflush(stderr);
+        for (LogPipe &pipe : g_logPipes) // wait until the writers have written everything (at most ~2 s)
+            for (int i = 0, quiet = 0; pipe.read && i < 400 && quiet < 2; ++i) // quiet twice: no gap between read and flag
+            {
+                DWORD avail = 0;
+                if (!PeekNamedPipe(pipe.read, nullptr, 0, nullptr, &avail, nullptr))
+                    break;
+                quiet = avail == 0 && !pipe.writing ? quiet + 1 : 0;
+                Sleep(5);
+            }
+    }
+
+    void stopLogWriters() // atexit: the last output, then end the writers
+    {
+        drainLogs();
+        for (LogPipe &pipe : g_logPipes)
+            if (pipe.writer.joinable())
+            {
+                _close(pipe.fd); // the pipe's only write end: the writer reads to the end and stops
+                pipe.writer.join();
+            }
+    }
+
+    void pipeLog(int index, FILE *stream, int fd)
+    {
+        const HANDLE target = reinterpret_cast<HANDLE>(_get_osfhandle(fd));
+        if (target == INVALID_HANDLE_VALUE || target == nullptr || GetFileType(target) != FILE_TYPE_DISK)
+            return;
+        LogPipe &pipe = g_logPipes[index];
+        HANDLE writeEnd = nullptr;
+        if (!DuplicateHandle(GetCurrentProcess(), target, GetCurrentProcess(), &pipe.file, 0, FALSE, DUPLICATE_SAME_ACCESS))
+            return;
+        if (!CreatePipe(&pipe.read, &writeEnd, nullptr, 4u << 20))
+        {
+            CloseHandle(pipe.file);
+            pipe.file = pipe.read = nullptr;
+            return;
+        }
+        const int pipeFd = _open_osfhandle(reinterpret_cast<intptr_t>(writeEnd), _O_WRONLY | _O_BINARY);
+        std::fflush(stream);
+        if (pipeFd < 0 || _dup2(pipeFd, fd) != 0)
+        {
+            if (pipeFd >= 0)
+                _close(pipeFd);
+            else
+                CloseHandle(writeEnd);
+            CloseHandle(pipe.read);
+            CloseHandle(pipe.file);
+            pipe.file = pipe.read = nullptr;
+            return;
+        }
+        _close(pipeFd); // fd itself is the pipe's write end now
+        pipe.fd = fd;
+        pipe.writer = std::thread([&pipe, index]()
+                                  {
+            SetThreadDescription(GetCurrentThread(), index == 0 ? L"LogWriterOut" : L"LogWriterErr");
+            std::vector<char> buffer(1u << 16);
+            DWORD got = 0;
+            while (ReadFile(pipe.read, buffer.data(), static_cast<DWORD>(buffer.size()), &got, nullptr) && got != 0)
+            {
+                pipe.writing = true; // (set after the read: drainLogs also checks the pipe is empty)
+                DWORD written = 0;
+                for (DWORD at = 0; at < got && WriteFile(pipe.file, buffer.data() + at, got - at, &written, nullptr) && written != 0; at += written)
+                {
+                }
+                pipe.writing = false;
+            } });
+    }
+}
+
+void ghsStartLogWriters()
+{
+    static bool started = false;
+    if (started || std::getenv("GHS_LOG_DIRECT"))
+        return;
+    started = true;
+    pipeLog(0, stdout, _fileno(stdout));
+    pipeLog(1, stderr, _fileno(stderr));
+    if (g_logPipes[0].writer.joinable() || g_logPipes[1].writer.joinable())
+        std::atexit(stopLogWriters);
+}
+
+void ghsDrainLogs()
+{
+    drainLogs();
+}
+
+// Crash reports (main.cpp installs them). An unhandled fault (access violation, illegal instruction, stack overflow,
+// ...) killed the process without a word, and the log's last ~100 ms sat in the stdio buffer (ps2_runtime.cpp
+// buffers stderr). Now: one [GHS-CRASH] line with the exception, the faulting thread's stack, every other thread's
+// stack, a minidump in crash_dumps\ next to the game, and the logs flushed. The report runs on a thread of its
+// own (a stack overflow leaves no stack to run it on) and the faulting thread waits for it at most 20 s; then
+// Windows ends the process as before.
+namespace
+{
+    int unwindStack(CONTEXT c, DWORD64 (&pcs)[48])
+    {
+        int n = 0;
+        while (n < 48 && c.Rip != 0)
+        {
+            pcs[n++] = c.Rip;
+            DWORD64 imageBase = 0;
+            PRUNTIME_FUNCTION fn = RtlLookupFunctionEntry(c.Rip, &imageBase, nullptr);
+            if (!fn)
+            {
+                if (IsBadReadPtr(reinterpret_cast<void *>(c.Rsp), 8))
+                    break;
+                c.Rip = *reinterpret_cast<DWORD64 *>(c.Rsp);
+                c.Rsp += 8;
+                continue;
+            }
+            void *handlerData = nullptr;
+            DWORD64 establisher = 0;
+            RtlVirtualUnwind(UNW_FLAG_NHANDLER, imageBase, c.Rip, fn, &c, &handlerData, &establisher, nullptr);
+        }
+        return n;
+    }
+
+    void printStack(HANDLE process, const DWORD64 *pcs, int n)
+    {
+        for (int i = 0; i < n; ++i)
+        {
+            alignas(SYMBOL_INFO) char buf[sizeof(SYMBOL_INFO) + 256] = {};
+            auto *sym = reinterpret_cast<SYMBOL_INFO *>(buf);
+            sym->SizeOfStruct = sizeof(SYMBOL_INFO);
+            sym->MaxNameLen = 255;
+            DWORD64 disp = 0;
+            IMAGEHLP_LINE64 line{};
+            line.SizeOfStruct = sizeof(line);
+            DWORD lineDisp = 0;
+            const bool named = SymFromAddr(process, pcs[i], &disp, sym) != FALSE;
+            const bool lined = SymGetLineFromAddr64(process, pcs[i], &lineDisp, &line) != FALSE;
+            if (named && lined)
+                std::fprintf(stderr, "  %s+0x%llx (%s:%lu)\n", sym->Name, static_cast<unsigned long long>(disp), line.FileName, line.LineNumber);
+            else if (named)
+                std::fprintf(stderr, "  %s+0x%llx\n", sym->Name, static_cast<unsigned long long>(disp));
+            else
+                std::fprintf(stderr, "  0x%llx\n", static_cast<unsigned long long>(pcs[i]));
+        }
+    }
+
+    struct CrashJob
+    {
+        EXCEPTION_POINTERS *info;
+        DWORD threadId;
+        char threadName[128];
+    };
+
+    DWORD WINAPI writeCrashReport(void *param)
+    {
+        const CrashJob &job = *static_cast<const CrashJob *>(param);
+        const EXCEPTION_RECORD *rec = job.info->ExceptionRecord;
+        std::fprintf(stderr, "\n[GHS-CRASH] exception 0x%08lx at 0x%p in thread %lu %s", static_cast<unsigned long>(rec->ExceptionCode),
+                     rec->ExceptionAddress, static_cast<unsigned long>(job.threadId), job.threadName);
+        if (rec->ExceptionCode == EXCEPTION_ACCESS_VIOLATION && rec->NumberParameters >= 2)
+            std::fprintf(stderr, " (%s address 0x%llx)", rec->ExceptionInformation[0] == 0 ? "reading" : rec->ExceptionInformation[0] == 1 ? "writing" : "executing",
+                         static_cast<unsigned long long>(rec->ExceptionInformation[1]));
+        std::fprintf(stderr, "\n");
+        std::fflush(stderr);
+        HANDLE process = GetCurrentProcess();
+        SymSetOptions(SYMOPT_UNDNAME | SYMOPT_DEFERRED_LOADS | SYMOPT_LOAD_LINES);
+        SymInitialize(process, nullptr, TRUE);
+        DWORD64 pcs[48];
+        const int n = unwindStack(*job.info->ContextRecord, pcs);
+        std::fprintf(stderr, "[GHS-CRASH] stack of the faulting thread:\n");
+        printStack(process, pcs, n);
+        std::fflush(stderr);
+
+        // The minidump: thread stacks and the memory they point at (a few MB), for a debugger with the runner's PDB.
+        char path[MAX_PATH] = "";
+        const std::time_t now = std::time(nullptr);
+        std::tm local{};
+        localtime_s(&local, &now);
+        CreateDirectoryA("crash_dumps", nullptr);
+        std::strftime(path, sizeof(path), "crash_dumps\\ghs_crash_%Y%m%d_%H%M%S.dmp", &local);
+        HANDLE file = CreateFileA(path, GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+        if (file != INVALID_HANDLE_VALUE)
+        {
+            MINIDUMP_EXCEPTION_INFORMATION mei{job.threadId, job.info, FALSE};
+            const BOOL ok = MiniDumpWriteDump(process, GetCurrentProcessId(), file,
+                                              static_cast<MINIDUMP_TYPE>(MiniDumpWithThreadInfo | MiniDumpWithIndirectlyReferencedMemory | MiniDumpWithUnloadedModules),
+                                              &mei, nullptr, nullptr);
+            CloseHandle(file);
+            char full[MAX_PATH] = "";
+            GetFullPathNameA(path, MAX_PATH, full, nullptr);
+            std::fprintf(stderr, "[GHS-CRASH] minidump %s: %s\n", ok ? "written" : "failed", full);
+        }
+        std::fflush(stderr);
+        ghsDumpAllThreadStacks(); // the other threads (it skips this one; the faulting thread is printed above)
+        std::fprintf(stderr, "[GHS-CRASH] end of report\n");
+        drainLogs();
+        return 0;
+    }
+
+    LONG WINAPI crashFilter(EXCEPTION_POINTERS *info)
+    {
+        static std::atomic<bool> reported{false};
+        if (reported.exchange(true)) // a second fault (in another thread, or in the report): let it end
+            return EXCEPTION_CONTINUE_SEARCH;
+        static CrashJob job; // static: no stack needed after a stack overflow
+        job.info = info;
+        job.threadId = GetCurrentThreadId();
+        job.threadName[0] = '\0';
+        PWSTR desc = nullptr;
+        if (SUCCEEDED(GetThreadDescription(GetCurrentThread(), &desc)) && desc)
+        {
+            WideCharToMultiByte(CP_UTF8, 0, desc, -1, job.threadName, sizeof(job.threadName), nullptr, nullptr);
+            LocalFree(desc);
+        }
+        if (HANDLE reporter = CreateThread(nullptr, 1u << 20, writeCrashReport, &job, 0, nullptr))
+        {
+            WaitForSingleObject(reporter, 20000);
+            CloseHandle(reporter);
+        }
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+}
+
+void ghsInstallCrashHandler()
+{
+    SetUnhandledExceptionFilter(crashFilter);
+    // GHS-TRACE: GHS_CRASH_TEST=<s>: a thread writes to address 0 after s seconds (tests the report).
+    if (const char *test = std::getenv("GHS_CRASH_TEST"))
+        CloseHandle(CreateThread(nullptr, 0, [](void *seconds) -> DWORD
+                                 {
+                                     SetThreadDescription(GetCurrentThread(), L"CrashTest");
+                                     Sleep(static_cast<DWORD>(reinterpret_cast<uintptr_t>(seconds)) * 1000u);
+                                     *static_cast<volatile int *>(nullptr) = 1;
+                                     return 0; },
+                                 reinterpret_cast<void *>(static_cast<uintptr_t>(std::atoi(test))), 0, nullptr));
+}
+
+// The calling thread's stack (main.cpp's std::terminate handler: an exception nothing caught).
+void ghsPrintCurrentStack()
+{
+    HANDLE process = GetCurrentProcess();
+    SymSetOptions(SYMOPT_UNDNAME | SYMOPT_DEFERRED_LOADS | SYMOPT_LOAD_LINES);
+    SymInitialize(process, nullptr, TRUE);
+    CONTEXT c{};
+    RtlCaptureContext(&c);
+    DWORD64 pcs[48];
+    const int n = unwindStack(c, pcs);
+    printStack(process, pcs, n);
+    std::fflush(stderr);
+}
+
+// A double-click start (main.cpp, logs in files): hides the console window if it is this process's own (started
+// from a terminal it stays). Hidden, not FreeConsole: after that the log writers' files stayed empty.
+void ghsDetachConsole()
+{
+    DWORD processes[2];
+    if (GetConsoleProcessList(processes, 2) == 1u)
+        ShowWindow(GetConsoleWindow(), SW_HIDE);
+}
+#else
+void ghsDetachConsole() {}
+void ghsDumpAllThreadStacks() {}
+void ghsProfileGameThread(int, const wchar_t *) {}
+void ghsInstallCrashHandler() {}
+void ghsPrintCurrentStack() {}
+void ghsStartLogWriters() {}
+void ghsDrainLogs() {}
+#endif
