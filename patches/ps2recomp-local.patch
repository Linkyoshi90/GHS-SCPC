+    void IopKernel::ghsDumpThreads(uint64_t currentCycle) const // GHS-TRACE (temporary)
+    {
+        static const char *const kStates[] = {"Dormant", "Ready", "Running", "Sleep", "Delay", "Sema", "EventFlag", "Suspended", "Dead"};
+        std::cerr << "[GHS-TRACE] IOP threads @cycle " << currentCycle << '\n';
+        for (const auto &[id, t] : m_threads)
+        {
+            std::cerr << "  thid=" << id << " state=" << kStates[static_cast<int>(t.state)] << std::hex
+                      << " entry=0x" << t.entry << " pc=0x" << t.cpu.pc << " ra=0x" << t.cpu.gpr[31]
+                      << " prio=0x" << t.priority << " waitId=" << std::dec << t.waitId
+                      << " bits=0x" << std::hex << t.waitBits << " wake=" << std::dec << t.wakeCycle << '\n';
+        }
+        for (const auto &[id, s] : m_semaphores)
+            std::cerr << "  sema=" << id << " count=" << s.current << "/" << s.maximum << '\n';
+        for (const auto &[id, e] : m_eventFlags)
+            std::cerr << "  evf=" << id << " bits=0x" << std::hex << e.bits << std::dec << '\n';
+        for (const auto &[id, s] : m_semaphores) // GHS-TRACE: history of semaphores someone waits on
+        {
+            bool waited = false;
+            for (const auto &[tid, t] : m_threads)
+                waited = waited || (t.state == IopThreadState::Semaphore && t.waitId == id);
+            if (!waited)
+                continue;
+            std::cerr << "  sema=" << id << " recent (W/P take, w waiter got it, B blocks, S/s give):";
+            for (size_t k = 0; k < g_semaEvents.size(); ++k)
+            {
+                const SemaEvent &e = g_semaEvents[(g_semaEventNext + k) % g_semaEvents.size()];
+                if (e.sema == id && e.op != 0)
+                    std::cerr << ' ' << e.op << e.thread << "@0x" << std::hex << e.ra << std::dec << "->" << e.countAfter;
+            }
+            std::cerr << '\n';
+        }
+        std::cerr << std::flush;
+    }
+
+    void IopKernel::ghsDumpThreadsCompact(uint64_t currentCycle) const // GHS-TRACE (temporary)
+    {
+        static const char *const kStates[] = {"Dormant", "Ready", "Running", "Sleep", "Delay", "Sema", "EventFlag", "Suspended", "Dead"};
+        std::cerr << "[GHS-FAST] t=" << std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count() << " cyc=" << currentCycle;
+        for (const auto &[id, t] : m_threads)
+        {
+            if (t.state == IopThreadState::Dormant || t.state == IopThreadState::Sleep)
+                continue;
+            std::cerr << " | t" << id << ' ' << kStates[static_cast<int>(t.state)] << std::hex << " e=" << t.entry
+                      << " pc=" << t.cpu.pc << " ra=" << t.cpu.gpr[31] << std::dec << " w=" << t.waitId
+                      << " wk=" << t.wakeCycle;
+        }
+        std::cerr << std::endl;
+    }
+
+    bool IopKernel::wakeFromHostWait(int id)
+    {
+        const auto it = m_threads.find(id);
+        if (it == m_threads.end() || it->second.state != IopThreadState::Sleep)
+            return false;
+        it->second.state = IopThreadState::Ready;
+        return true;
+    }
