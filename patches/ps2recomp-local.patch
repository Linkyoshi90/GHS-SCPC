+                b.vertices[0].y = static_cast<float>((ctx.xyoffset.ofy >> 4) + rnd(150));
+                b.vertices[1].x = b.vertices[0].x + static_cast<float>(w);
+                b.vertices[1].y = b.vertices[0].y + static_cast<float>(hgt);
