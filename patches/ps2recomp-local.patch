+            }
+        }
+        // Compared every few ops, so the GPU batches runs of draws and CLUT loads in between.
+        pending += std::to_string(op) + ": " + what + "\n";
+        // GHS_GS_GPU_SELFTEST_UNBATCHED=1: a run per op, compared after each (tells hazards from kernel bugs).
+        static const bool unbatched = std::getenv("GHS_GS_GPU_SELFTEST_UNBATCHED") != nullptr;
+        if (rnd(16) != 0u && op + 1 != ops && !unbatched)
+            continue;
+        gpu.Sync(GSSyncReason::DebugReadback);
+        {
+            // The CLUTs too (they only show in VRAM through later paletted draws).
+            uint32_t entries[512];
+            if (gpu.ReadClut(entries))
+            {
+                int bad = -1;
+                for (int i = 0; i < 512 && bad < 0; ++i)
+                    if (entries[i] != cpu.ClutForTest()[i])
+                        bad = i;
+                if (bad >= 0)
+                {
+                    std::fprintf(stderr, "[GHS-GSGPU] self-test seed %u: CLUT entry %d differs (CPU 0x%04x, GPU 0x%04x) after ops\n%s", seed, bad,
+                                 cpu.ClutForTest()[bad], entries[bad], pending.c_str());
+                    return false;
+                }
+            }
+        }
+        if (cpuVram != gpuVram)
+        {
+            size_t diff = 0, first = 0;
+            for (size_t i = kVramBytes; i-- > 0;)
+                if (cpuVram[i] != gpuVram[i])
+                    ++diff, first = i;
+            std::fprintf(stderr, "[GHS-GSGPU] self-test seed %u: %zu bytes differ, first at 0x%zx, after ops\n%s", seed, diff, first, pending.c_str());
+            if (const char *dump = std::getenv("GHS_GS_GPU_SELFTEST_DUMP")) // <prefix>: <prefix>_cpu.vram / _gpu.vram
+                for (const auto &[suffix, image] : {std::pair{"_cpu.vram", &cpuVram}, std::pair{"_gpu.vram", &gpuVram}})
+                    if (FILE *f = std::fopen((std::string(dump) + suffix).c_str(), "wb"))
+                    {
+                        std::fwrite(image->data(), 1, image->size(), f);
+                        std::fclose(f);
+                    }
+            return false;
+        }
+        pending.clear();
+    }
+    std::fprintf(stderr, "[GHS-GSGPU] self-test seed %u: %d ops identical (GPU: %llu draws, %llu textured, %llu CLUT loads in %llu runs, %llu uploads, %llu local copies; "
+                         "CPU: %llu draws, %llu other)\n", seed, ops,
+                 static_cast<unsigned long long>(gpu.m_gpuDraws), static_cast<unsigned long long>(gpu.m_gpuTextured), static_cast<unsigned long long>(gpu.m_gpuCluts),
+                 static_cast<unsigned long long>(gpu.m_runs), static_cast<unsigned long long>(gpu.m_gpuUploads), static_cast<unsigned long long>(gpu.m_gpuCopies),
+                 static_cast<unsigned long long>(gpu.m_cpuDraws), static_cast<unsigned long long>(gpu.m_cpuOps));
+    return true;
+}
