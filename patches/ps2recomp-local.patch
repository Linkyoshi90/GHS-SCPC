+// Into shader_cache\ under a temporary name first: a crash mid-write leaves no half file under the real name.
+static void WriteCache(const KernelJob &job)
+{
+    if (!job.code)
+        return;
+    std::error_code ec;
+    std::filesystem::create_directories("shader_cache", ec);
+    const std::string temp = std::string(job.cacheName) + ".tmp";
+    if (FILE *f = std::fopen(temp.c_str(), "wb"))
+    {
+        const bool ok = std::fwrite(job.code->GetBufferPointer(), 1, job.code->GetBufferSize(), f) == job.code->GetBufferSize();
+        if (std::fclose(f) == 0 && ok)
+            std::filesystem::rename(temp, job.cacheName, ec);
+        if (!ok || ec)
+            std::filesystem::remove(temp, ec);
+    }
+}
