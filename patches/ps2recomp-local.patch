+            for (const auto &[idx, off] : b.vfReq)
+                if (off == 0u)
+                    put("    c0 = std::max(c0, vfR[%u]);\n", idx);
+            for (const auto &[r, off] : b.viReq)
+                if (off == 0u)
+                    put("    c0 = std::max(c0, vu.m_viReady[%u]);\n", r);
+            for (const auto &[c, off] : b.accReq)
+                if (off == 0u)
+                    put("    c0 = std::max(c0, vu.m_accReady[%u]);\n", c);
+            // The later VF ready checks four lanes at a time (one AVX2 compare per register and offset).
+            std::map<std::pair<uint32_t, uint32_t>, uint32_t> lateGroups; // (register, offset) -> lanes (x = bit 0)
+            for (const auto &[idx, off] : b.vfReq)
+                if (off != 0u)
+                    lateGroups[{idx / 4u, off}] |= 1u << (idx % 4u);
+            if (!lateGroups.empty())
+            {
+                g += "    __m256i late = _mm256_setzero_si256();\n";
+                for (const auto &[key, lanes] : lateGroups)
+                    put("    late = _mm256_or_si256(late, lateLanes<%uu>(vfR + %u, c0 + %uu));\n", lanes, key.first * 4u, key.second);
+            }
+            put("    if (c0 + %uu >= a.budgetEnd || vu.m_stopRequested || st.branchPending || st.ebit || st.haltAfterDelaySlot", b.issue.back());
+            if (b.needNoFdiv)
+                put(" || (vu.m_fdiv.valid && vu.m_fdiv.readyCycle > c0 + %uu)", b.fdivOff);
+            if (b.needNoEfuResource)
+                put(" || vu.m_efuResourceReady > c0 + %uu", b.efuResourceOff);
+            if (b.needNoEfuEntries)
+                put(" || (vu.m_efu[0].valid && vu.m_efu[0].readyCycle > c0 + %uu) || (vu.m_efu[1].valid && vu.m_efu[1].readyCycle > c0 + %uu)", b.waitPOff, b.waitPOff);
+            if (!lateGroups.empty())
+                g += "\n        || !_mm256_testz_si256(late, late)";
+            for (const auto &[r, off] : b.viReq)
+                if (off != 0u)
+                    put("\n        || vu.m_viReady[%u] > c0 + %uu", r, off);
+            for (const auto &[c, off] : b.accReq)
+                if (off != 0u)
+                    put("\n        || vu.m_accReady[%u] > c0 + %uu", c, off);
+            put("\n        || g_vuCheck || g_vuAllFlags)\n    {\n        ++g_ghsBlockFallbacks;\n        ghsBlockFallback(0x%04xu);\n        return false;\n    }\n    ++g_ghsBlockRuns;\n    {\n", b.start * 8u);
+            g += emitBlockBody(b.start, b.end, b.issue) + "    }\n";
+            std::map<std::pair<uint32_t, uint32_t>, uint32_t> markGroups; // (register, offset) -> lanes
+            for (const auto &[idx, off] : b.vfMark)
+                markGroups[{idx / 4u, off}] |= 1u << (idx % 4u);
+            for (const auto &[key, lanes] : markGroups)
+                if (lanes == 0xFu)
+                    put("    _mm256_storeu_si256(reinterpret_cast<__m256i *>(vfR + %u), _mm256_set1_epi64x(static_cast<long long>(c0 + %uu)));\n", key.first * 4u, key.second);
+                else
+                    for (uint32_t c = 0; c < 4u; ++c)
+                        if (lanes & (1u << c))
+                            put("    vfR[%u] = c0 + %uu;\n", key.first * 4u + c, key.second);
+            for (const auto &[r, off] : b.viMark)
+                put("    vu.m_viReady[%u] = c0 + %uu;\n", r, off);
+            for (const auto &[c, off] : b.accMark)
+                put("    vu.m_accReady[%u] = c0 + %uu;\n", c, off);
+            const uint32_t lastPc = b.end * 8u;
+            const uint32_t nextPc = lastPc + 8u >= 0x4000u ? 0u : lastPc + 8u;
+            // advanceTo's common case inline: no XGKICK and nothing due up to the end
+            put("    if (!vu.m_xgkick.active && c0 + %uu < g_nextOtherCycle[1])\n        vu.m_cycle = c0 + %uu;\n    else\n        advanceTo(vu, c0 + %uu);\n    a.pairs += %uu;\n",
+                b.total, b.total, b.total, b.end - b.start + 1u);
+            put("    if (st.branchPending)\n    {\n        st.pc = st.branchTarget & 0x3FFFu;\n        st.branchPending = false;\n        st.branchDelay = 0;\n    }\n    else\n        st.pc = 0x%04xu;\n    return true;\n}\n", nextPc);
+            blockFns += g;
+            emit("S_%04x:\n{\n    if (!block_%s_%04x(vu, a))\n        goto L_%04x;\n", b.start * 8u, hexName(hash).c_str(), b.start * 8u, b.start * 8u);
+            // static branch target (B/BAL/IBxx) of the block's branch
+            if (b.end >= 1u && isBranch(b.end - 1u) && !pairs[b.end - 1u].iBit)
+            {
+                const uint32_t lop = (pairs[b.end - 1u].lower >> 25) & 0x7Fu;
+                if (lop == 0x20u || lop == 0x21u || (lop >= 0x28u && lop <= 0x2Fu && lop != 0x2Au && lop != 0x2Bu))
+                {
+                    const uint32_t target = ((b.end - 1u) * 8u + 8u + static_cast<uint32_t>(imm11(pairs[b.end - 1u].lower) * 8)) & 0x3FFFu;
+                    if (target / 8u <= last && usable[target / 8u])
+                        emit("    if (st.pc == 0x%04xu) goto %s;\n", target, label(target / 8u).c_str());
+                }
+            }
+            if (nextPc / 8u <= last && usable[nextPc / 8u])
+                emit("    if (st.pc == 0x%04xu) goto %s;\n", nextPc, label(nextPc / 8u).c_str());
+            emit("    goto dispatch;\n}\n");
+        }
+        emit("}\n");
+        // The class (the image function declared, the blocks), then the image function outside it: one switch over
+        // every label and ~2000 gotos that MSVC took ~60 s to optimize per image. Its work is in step<> and the
+        // blocks (noinline, optimized); in one file with every image MSVC skipped optimizing it anyway (size limit).
+        std::fprintf(f, "// VU1 code image %s translated by GHS_VU1GEN (game code: keep local, don't commit)\n", hexName(hash).c_str());
+        std::fprintf(f, "#include \"../ps2_vu1_fast.h\"\n\ntemplate <>\nstruct VU1Fast::Image<0x%sull>\n{\n", hexName(hash).c_str());
+        std::fprintf(f, "static bool image_%s(Interp &vu, Ctx &a);\n", hexName(hash).c_str());
+        std::fputs(blockFns.c_str(), f);
+        std::fprintf(f, "};\n\n#pragma optimize(\"\", off)\n");
+        std::fputs(body.c_str(), f);
+        std::fprintf(f, "#pragma optimize(\"\", on)\n\ntemplate <>\nbool VU1Fast::image<0x%sull>(Interp &vu, Ctx &a) { return Image<0x%sull>::image_%s(vu, a); }\n",
+                     hexName(hash).c_str(), hexName(hash).c_str(), hexName(hash).c_str());
+        std::fclose(f);
+
+        // Index: every vu1_<hash>.cpp in the directory (each its own translation unit, see CMakeLists.txt).
+        std::vector<std::string> names;
+        std::error_code ec;
+        for (const auto &entry : std::filesystem::directory_iterator(dir, ec))
+        {
+            const std::string name = entry.path().filename().string();
+            if (name.size() == 4u + 16u + 4u && name.rfind("vu1_", 0) == 0 && name.substr(name.size() - 4u) == ".cpp")
+                names.push_back(name.substr(4u, 16u));
+        }
+        std::sort(names.begin(), names.end());
+        if (FILE *index = std::fopen((std::string(dir) + "/vu1_index.inc").c_str(), "w"))
+        {
+            std::fprintf(index, "// Translated VU1 code images (GHS_VU1GEN). Game code: keep local, don't commit.\n");
+            for (const std::string &name : names)
+                std::fprintf(index, "template <>\nbool VU1Fast::image<0x%sull>(Interp &, Ctx &);\n", name.c_str());
+            std::fprintf(index, "#define VU1_IMAGE_TABLE");
+            for (size_t k = 0; k < names.size(); ++k)
+                std::fprintf(index, "%s {0x%sull, &image<0x%sull>}", k ? "," : "", names[k].c_str(), names[k].c_str());
+            std::fprintf(index, "\n");
+            std::fclose(index);
+        }
+        // Every step<PairC{...}> the images call, instantiated once (see step) in vu1_steps_<k>.cpp, the file picked
+        // by a hash of the pair: adding an image mostly leaves the other files' contents alone.
+        constexpr uint32_t kStepFiles = 16u;
+        std::set<std::string> steps;
+        for (const std::string &name : names)
+            if (FILE *in = std::fopen((std::string(dir) + "/vu1_" + name + ".cpp").c_str(), "rb"))
+            {
+                std::string text;
+                char buf[65536];
+                for (size_t got; (got = std::fread(buf, 1, sizeof(buf), in)) > 0;)
+                    text.append(buf, got);
+                std::fclose(in);
+                for (size_t at = text.find("step<PairC{"); at != std::string::npos; at = text.find("step<PairC{", at + 1u))
+                    steps.insert(text.substr(at + 5u, text.find("}>(", at) + 1u - (at + 5u))); // PairC{...}
+            }
+        std::vector<std::string> stepFiles(kStepFiles, "// VU1 pairs of the translated images (GHS_VU1GEN). Game code: keep local, don't commit.\n"
+                                                       "#define VU1_DEFINE_STEPS\n#include \"../ps2_vu1_fast.h\"\n\n");
+        for (const std::string &s : steps)
+            stepFiles[hashImage(reinterpret_cast<const uint8_t *>(s.data()), static_cast<uint32_t>(s.size())) % kStepFiles] +=
+                "template bool VU1Fast::step<VU1Fast::" + s + ">(Interp &, Ctx &, uint32_t);\n";
+        for (uint32_t k = 0; k < kStepFiles; ++k)
+            if (FILE *out = std::fopen((std::string(dir) + "/vu1_steps_" + std::to_string(k) + ".cpp").c_str(), "w"))
+            {
+                std::fputs(stepFiles[k].c_str(), out);
+                std::fclose(out);
+            }
+        std::fprintf(stderr, "[GHS-VU1GEN] wrote %s (%u pairs; %u of %u flag writes dead%s; %zu static blocks, %u pairs), index has %zu images\n", path.c_str(),
+                     last + 1u, dead, writers, statusRead ? ", status flags read: all live" : "", plans.size(), staticPairs, names.size());
+    }
+
+    static std::string hexName(uint64_t h)
+    {
+        char buf[32];
+        std::snprintf(buf, sizeof(buf), "%016llx", static_cast<unsigned long long>(h));
+        return buf;
+    }
+    static std::string hex32(uint32_t v)
+    {
+        char buf[16];
+        std::snprintf(buf, sizeof(buf), "0x%08xu", v);
+        return buf;
+    }
+
+    // GHS_VU_CHECK2: run each call translated, then again with loopPairs from the same state, and
+    // compare (VU state, data memory, cycle, pipelines, flags, GIF packets). The loopPairs result
+    // is kept.
+    struct Snapshot
+    {
+        Interp vu;
+        std::vector<uint8_t> data;
+        FlagFifo fifo;
+        uint64_t nextCommit, nextFlag, nextOther;
+        bool mayHold[ArrayCount];
+        explicit Snapshot(const Interp &v, const uint8_t *vuData, uint32_t size) : vu(v), data(vuData, vuData + size)
+        {
+            fifo = g_flagFifo[1];
+            nextCommit = g_nextCommitCycle[1];
+            nextFlag = g_nextFlagCycle[1];
+            nextOther = g_nextOtherCycle[1];
+            std::copy(std::begin(g_mayHoldEntries[1]), std::end(g_mayHoldEntries[1]), mayHold);
+        }
+        void restore(Interp &v, uint8_t *vuData) const
+        {
+            v = vu;
+            std::memcpy(vuData, data.data(), data.size());
+            g_flagFifo[1] = fifo;
+            g_nextCommitCycle[1] = nextCommit;
+            g_nextFlagCycle[1] = nextFlag;
+            g_nextOtherCycle[1] = nextOther;
+            std::copy(std::begin(mayHold), std::end(mayHold), g_mayHoldEntries[1]);
+        }
+    };
+
+    template <class Body>
+    static void runChecked2(Interp &vu, uint8_t *vuData, uint32_t dataSize, PS2Memory *memory, const Body &body)
+    {
+        const auto before = std::make_unique<Snapshot>(vu, vuData, dataSize);
+        std::vector<std::vector<uint8_t>> packetsA, packetsB;
+        g_gifCapture = &packetsA;
+        body(true);
+        const auto afterA = std::make_unique<Snapshot>(vu, vuData, dataSize);
+        before->restore(vu, vuData);
+        g_gifCapture = &packetsB;
+        body(false);
+        g_gifCapture = nullptr;
+        const auto afterB = std::make_unique<Snapshot>(vu, vuData, dataSize);
+        std::string what;
+        static uint64_t calls = 0, mismatches = 0;
+        ++calls;
+        if (!sameResult(*afterA, *afterB, what) || packetsA != packetsB)
+        {
+            if (packetsA != packetsB) what += " gif";
+            { // which state byte differs
+                const auto *x = reinterpret_cast<const uint8_t *>(&afterA->vu.m_state);
+                const auto *y = reinterpret_cast<const uint8_t *>(&afterB->vu.m_state);
+                for (size_t k = 0; k < sizeof(VU1State); ++k)
+                    if (x[k] != y[k])
+                    {
+                        what += " @" + std::to_string(k) + "(" + std::to_string(x[k]) + "/" + std::to_string(y[k]) + ")";
+                        break;
+                    }
+            }
+            if (++mismatches <= 20u)
+                std::fprintf(stderr, "[GHS-VUCHECK2] mismatch:%s (pc 0x%x -> 0x%x / 0x%x, cycle %llu / %llu)\n", what.c_str(), before->vu.m_state.pc,
+                             afterA->vu.m_state.pc, afterB->vu.m_state.pc, static_cast<unsigned long long>(afterA->vu.m_cycle),
+                             static_cast<unsigned long long>(afterB->vu.m_cycle));
+        }
+        if ((calls % 2000u) == 0u)
+            std::fprintf(stderr, "[GHS-VUCHECK2] %llu calls checked, %llu mismatches\n", static_cast<unsigned long long>(calls),
+                         static_cast<unsigned long long>(mismatches));
+        for (const auto &packet : packetsB) // the reference run's GIF output goes to the GS
+            memory->submitGifPacket(GifPathId::Path1, packet.data(), static_cast<uint32_t>(packet.size()));
+    }
+
+    template <class Body>
+    static void runChecked3(Interp &vu, uint8_t *vuData, uint32_t dataSize, PS2Memory *memory, const Body &body)
+    {
+        const auto before = std::make_unique<Snapshot>(vu, vuData, dataSize);
+        std::vector<std::vector<uint8_t>> packetsA, packetsB;
+        g_gifCapture = &packetsA;
+        g_vuAllFlags = false;
+        body(true);
+        const auto afterA = std::make_unique<Snapshot>(vu, vuData, dataSize);
+        before->restore(vu, vuData);
+        g_gifCapture = &packetsB;
+        g_vuAllFlags = true;
+        body(true);
+        g_gifCapture = nullptr;
+        const auto afterB = std::make_unique<Snapshot>(vu, vuData, dataSize);
+        // Dead flag results differ by design: compare everything else.
+        afterA->vu.m_state.mac = afterB->vu.m_state.mac;
+        afterA->vu.m_state.status = afterB->vu.m_state.status;
+        std::string what;
+        static uint64_t calls = 0, mismatches = 0;
+        ++calls;
+        if (!sameResult(*afterA, *afterB, what, false) || packetsA != packetsB)
+        {
+            if (packetsA != packetsB) what += " gif";
+            if (++mismatches <= 20u)
+                std::fprintf(stderr, "[GHS-VUCHECK3] mismatch:%s (pc 0x%x)\n", what.c_str(), before->vu.m_state.pc);
+        }
+        if ((calls % 2000u) == 0u)
+            std::fprintf(stderr, "[GHS-VUCHECK3] %llu calls checked, %llu mismatches\n", static_cast<unsigned long long>(calls),
+                         static_cast<unsigned long long>(mismatches));
+        for (const auto &packet : packetsB)
+            memory->submitGifPacket(GifPathId::Path1, packet.data(), static_cast<uint32_t>(packet.size()));
+    }
+
+    static bool sameResult(const Snapshot &x, const Snapshot &y, std::string &what, bool compareFlags = true)
+    {
+        const Interp &a = x.vu, &b = y.vu;
+        if (std::memcmp(&a.m_state, &b.m_state, sizeof(a.m_state)) != 0) what += " state";
+        if (a.m_cycle != b.m_cycle) what += " cycle";
+        if (x.data != y.data) what += " data";
+        if (std::memcmp(&a.m_vfReady, &b.m_vfReady, sizeof(a.m_vfReady)) != 0 || a.m_viReady != b.m_viReady || a.m_accReady != b.m_accReady) what += " ready";
+        if (a.m_workingClip != b.m_workingClip || (compareFlags && !sameFifo(x.fifo, y.fifo))) what += " flags";
+        if (a.m_fdiv.valid != b.m_fdiv.valid || a.m_fdiv.readyCycle != b.m_fdiv.readyCycle) what += " fdiv";
+        for (size_t k = 0; k < a.m_viWritePipeline.size(); ++k)
+            if (a.m_viWritePipeline[k].valid != b.m_viWritePipeline[k].valid || a.m_viWritePipeline[k].value != b.m_viWritePipeline[k].value ||
+                a.m_viWritePipeline[k].readyCycle != b.m_viWritePipeline[k].readyCycle)
+            {
+                what += " vi-queue";
+                break;
+            }
+        if (a.m_xgkick.active != b.m_xgkick.active || a.m_xgkick.copiedBytes != b.m_xgkick.copiedBytes) what += " xgkick";
+        return what.empty();
+    }
+
+    // Runs the program until it ends, the budget is used up or a stop is requested. Returns false
+    // (before doing anything) when the code is not the unit's micro memory; run() then uses the
+    // generic loop.
+    static bool runFast(Interp &vu, uint8_t *vuCode, uint32_t codeSize, uint8_t *vuData, uint32_t dataSize,
+                        GS &gs, PS2Memory *memory, uint64_t budgetEnd, bool &programEnded, uint64_t &pairsRun)
+    {
+        const bool vu1 = vu.m_unit == Interp::Unit::VU1;
+        if (!memory || vuCode != (vu1 ? memory->getVU1Code() : memory->getVU0Code()) || codeSize / 8u > kTimingPairs)
+            return false;
+        // GHS_VU1REGEN_FROM=<dir of 16 KB code images (<hash>.bin)> with GHS_VU1GEN=<dir>: at the first VU1 program,
+        // translate every image there (after a translator change: all images, not only those the game uploads
+        // in the scenes visited) and exit. GHS_VU1REGEN_RECIPES=<recomp\vu1_recipes.txt> adds the images built from
+        // pieces of the game's ELF (SLES_519.33 in the working directory), so a fresh build needs no captured images.
+        static const char *regenFrom = std::getenv("GHS_VU1REGEN_FROM"), *recipes = std::getenv("GHS_VU1REGEN_RECIPES");
+        if (vu1 && (regenFrom || recipes) && std::getenv("GHS_VU1GEN"))
+        {
+            int count = 0, bad = 0;
+            if (recipes)
+            {
+                std::vector<uint8_t> elf;
+                if (FILE *in = std::fopen("SLES_519.33", "rb"))
+                {
+                    std::fseek(in, 0, SEEK_END);
+                    elf.resize(static_cast<size_t>(std::ftell(in)));
+                    std::fseek(in, 0, SEEK_SET);
+                    elf.resize(std::fread(elf.data(), 1, elf.size(), in));
+                    std::fclose(in);
+                }
+                FILE *list = std::fopen(recipes, "r");
+                char line[8192];
+                while (list && std::fgets(line, sizeof(line), list))
+                {
+                    char name[17];
+                    int pos = 0, n = 0;
+                    if (line[0] == '#' || std::sscanf(line, "%16s%n", name, &pos) != 1)
+                        continue;
+                    std::vector<uint8_t> image(0x4000u);
+                    unsigned dst, off, len;
+                    bool ok = true;
+                    while (ok && std::sscanf(line + pos, " %x:%x:%x%n", &dst, &off, &len, &n) == 3)
+                    {
+                        ok = dst + len <= image.size() && size_t(off) + len <= elf.size();
+                        if (ok)
+                            std::memcpy(image.data() + dst, elf.data() + off, len);
+                        pos += n;
+                    }
+                    if (!ok || hashImage(image.data(), 0x4000u) != std::strtoull(name, nullptr, 16))
+                    {
+                        std::fprintf(stderr, "[GHS-VU1REGEN] recipe %s doesn't match this SLES_519.33, skipped\n", name);
+                        ++bad;
+                        continue;
+                    }
+                    emitImage(vu, image.data(), 0x4000u, hashImage(image.data(), 0x4000u), std::getenv("GHS_VU1GEN"));
+                    ++count;
+                }
+                if (list)
+                    std::fclose(list);
+            }
+            for (const auto &entry : regenFrom ? std::filesystem::directory_iterator(regenFrom) : std::filesystem::directory_iterator())
+            {
+                if (entry.path().extension() != ".bin" || entry.file_size() != 0x4000u)
+                    continue;
+                std::vector<uint8_t> image(0x4000u);
+                if (FILE *in = std::fopen(entry.path().string().c_str(), "rb"))
+                {
+                    const size_t got = std::fread(image.data(), 1, image.size(), in);
+                    std::fclose(in);
+                    if (got != image.size())
+                        continue;
+                }
+                emitImage(vu, image.data(), 0x4000u, hashImage(image.data(), 0x4000u), std::getenv("GHS_VU1GEN"));
+                ++count;
+            }
+            std::fprintf(stderr, "[GHS-VU1REGEN] translated %d images (%d recipes skipped), exiting\n", count, bad);
+            std::fflush(stderr);
+            std::exit(0);
+        }
+        Table &t = table(vu1);
+        const uint64_t generation = vu1 ? memory->getVU1CodeGeneration() : memory->getVU0CodeGeneration();
+        if (t.code != vuCode || t.memory != memory || t.generation != generation)
+        {
+            t.code = vuCode;
+            t.memory = memory;
+            t.generation = generation;
+            if (++t.epoch == 0u) // wrapped: clear the stamps
+            {
+                std::fill(std::begin(t.stamp), std::end(t.stamp), 0u);
+                t.epoch = 1u;
+            }
+            t.image = nullptr;
+            static const char *genDir = std::getenv("GHS_VU1GEN");
+            static const bool noImages = std::getenv("GHS_VU_NOREC") != nullptr;
+            if (vu1 && codeSize == 0x4000u && (genDir || !noImages))
+            {
+                const uint64_t hash = cachedImageHash(vuCode, codeSize);
+                g_ghsCurImageHash = hash; // GHS-TRACE
+                t.image = noImages ? nullptr : findImage(hash);
+                // A microprogram set the translator hasn't seen runs ~4x slower (generic loop): save it once, so it
+                // can be translated (GHS_VU1REGEN_FROM). Folder: GHS_VU1NEW_DIR, else vu1_untranslated in the
+                // working directory (game\ with the tools' launch).
+                static std::set<uint64_t> untranslated;
+                if (!findImage(hash) && untranslated.insert(hash).second)
+                {
+                    static const std::filesystem::path dir = std::getenv("GHS_VU1NEW_DIR") ? std::getenv("GHS_VU1NEW_DIR") : "vu1_untranslated";
+                    std::error_code ec;
+                    std::filesystem::create_directories(dir, ec);
