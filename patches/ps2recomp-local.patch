+    // Upper instructions that queue MAC/status flags (the FMAC forms), when dest != 0.
+    static constexpr bool writesMacStatus(uint32_t upper)
+    {
+        if (((upper >> 21) & 0xFu) == 0u)
+            return false;
+        const uint32_t code = upper & 0x3Fu;
+        if (code < 0x3Cu)
+            return code <= 0x0Fu || (code >= 0x18u && code <= 0x1Cu) || code == 0x1Eu || (code >= 0x20u && code <= 0x2Au) ||
+                   (code >= 0x2Cu && code <= 0x2Eu);
+        const uint32_t special = (upper & 0x3u) | ((upper >> 4) & 0x7Cu);
+        return special <= 0x0Fu || (special >= 0x18u && special <= 0x1Cu) || special == 0x1Eu || (special >= 0x20u && special <= 0x2Au) ||
+               (special >= 0x2Cu && special <= 0x2Eu);
+    }
+
+    // GHS_VU_CHECK=1: run execUpper and the fast handler from the same state, compare.
+    static void runChecked(Interp &vu, const Op &op)
+    {
+        const bool vu1 = vu.m_unit == Interp::Unit::VU1;
+        const VU1State before = vu.m_state;
+        const FlagFifo fifoBefore = g_flagFifo[vu1 ? 1 : 0];
+        const uint32_t clipBefore = vu.m_workingClip;
+        const uint64_t nextBefore = g_nextCommitCycle[vu1 ? 1 : 0];
+        const uint64_t nextFlagBefore = g_nextFlagCycle[vu1 ? 1 : 0];
+
+        vu.execUpper(op.instr);
+        const VU1State slow = vu.m_state;
+        const FlagFifo fifoSlow = g_flagFifo[vu1 ? 1 : 0];
+        const uint32_t clipSlow = vu.m_workingClip;
+
+        vu.m_state = before;
+        g_flagFifo[vu1 ? 1 : 0] = fifoBefore;
+        vu.m_workingClip = clipBefore;
+        g_nextCommitCycle[vu1 ? 1 : 0] = nextBefore;
+        g_nextFlagCycle[vu1 ? 1 : 0] = nextFlagBefore;
+        op.fn(vu, op);
+
+        const bool slotsEqual = sameFifo(fifoSlow, g_flagFifo[vu1 ? 1 : 0]);
+        static uint64_t checked = 0, mismatches = 0;
+        ++checked;
+        if (std::memcmp(&slow, &vu.m_state, sizeof(slow)) != 0 || !slotsEqual || clipSlow != vu.m_workingClip)
+        {
+            if (++mismatches <= 20u)
+                std::fprintf(stderr, "[GHS-VUCHECK] mismatch upper=0x%08x pc=0x%x (state %d, flags %d, clip %d)\n", op.instr, vu.m_state.pc,
+                             std::memcmp(&slow, &vu.m_state, sizeof(slow)) != 0, !slotsEqual, clipSlow != vu.m_workingClip);
+            vu.m_state = slow; // keep the reference result
+        }
+        if ((checked & 0xFFFFFFu) == 0u)
+            std::fprintf(stderr, "[GHS-VUCHECK] %llu upper ops checked, %llu mismatches\n", static_cast<unsigned long long>(checked),
+                         static_cast<unsigned long long>(mismatches));
+    }
+
+    // ---------------------------------------------------------------- fast pair loop
+    // One record per instruction pair with everything the loop needs (decoded once, lazily, on the
+    // first execution after a code upload), so a pair touches one or two cache lines instead of the
+    // InstructionUsage structs. Same steps and order as the generic loop in VU1Interpreter::run.
+    struct Pair
+    {
+        Op upper;
+        uint32_t lower = 0;
+        uint16_t viRead = 0;          // VI registers read (without vi0)
+        uint16_t viWrite = 0;         // VI registers written (without vi0)
+        uint8_t vfReadCount = 0;
+        uint8_t vfRead[16] = {};      // reg * 4 + component
+        uint8_t accRead = 0;          // component bits
+        uint8_t accWrite = 0;         // component bits
+        uint8_t lowerVfReg = 0, lowerVfLanes = 0, lowerVfLatency = 0;   // lower VF write (0 = none/suppressed)
+        uint8_t upperVfReg = 0, upperVfLanes = 0, upperVfLatency = 0;   // upper VF write
+        uint8_t viLatency = 0;
+        uint8_t writtenVi = 0;        // first VI written (as the generic loop's writtenVi)
+        uint8_t shadowReg = 0;        // upperVfShadowReg
+        uint8_t pipeline = 0;         // lower pipeline
+        uint8_t lowerLatency = 0;     // lower usage latency (Q/P result delay for FDIV/EFU ops)
+        bool iBit = false, eBit = false, dBit = false, tBit = false;
+        bool waitQ = false, waitP = false, lowerNop = false, delaysNextBranchRead = false;
+        bool reserved = false, reservedUpper = false;
+        bool lowerTouchesVf = false;                  // lower reads or writes a VF register
+        uint8_t lowerVfWrite = 0xFF, upperVfWrite = 0xFF; // VF register written (0xFF = none)
+        bool upperWritesAcc = false;
+    };
+
+    static Pair build(const Interp::DecodedInstructionPair &d)
+    {
+        Pair f;
+        f.upper = decode(d.upper);
+        f.lower = d.lower;
+        f.iBit = d.iBit;
+        f.eBit = d.eBit;
+        f.dBit = d.dBit;
+        f.tBit = d.tBit;
+        f.reserved = d.upperUsage.reserved || d.lowerUsage.reserved;
+        f.reservedUpper = d.upperUsage.reserved;
+        f.lowerNop = d.lower == 0x00000000u || d.lower == 0x8000033Cu; // execLower's NOP test
+        f.shadowReg = d.upperVfShadowReg;
+        f.pipeline = d.lowerUsage.pipeline;
+        f.lowerLatency = d.lowerUsage.latency;
+        f.waitQ = d.lowerUsage.waitQ;
+        f.waitP = d.lowerUsage.waitP;
+        f.delaysNextBranchRead = d.lowerUsage.delaysNextBranchRead;
+        f.lowerTouchesVf = d.lowerUsage.vfReadCount != 0u || d.lowerUsage.vfWrite.lanes != 0u;
+        f.lowerVfWrite = d.lowerUsage.vfWrite.lanes != 0u ? d.lowerUsage.vfWrite.reg : 0xFFu;
+        f.upperVfWrite = d.upperUsage.vfWrite.lanes != 0u ? d.upperUsage.vfWrite.reg : 0xFFu;
+        f.upperWritesAcc = d.upperUsage.accWrite != 0u;
+        for (const Interp::InstructionUsage *usage : {&d.upperUsage, &d.lowerUsage})
+        {
+            for (uint32_t index = 0; index < usage->vfReadCount; ++index)
+                for (uint32_t component = 0; component < 4u; ++component)
+                    if ((usage->vfRead[index].lanes & laneForComponent(component)) != 0u)
+                        f.vfRead[f.vfReadCount++] = static_cast<uint8_t>(usage->vfRead[index].reg * 4u + component);
+            f.viRead |= usage->viRead & 0xFFFEu;
+            for (uint32_t component = 0; component < 4u; ++component)
+                if ((usage->accRead & laneForComponent(component)) != 0u)
+                    f.accRead |= static_cast<uint8_t>(1u << component);
+        }
+        if (d.lowerUsage.vfWrite.reg != 0u && d.suppressedLowerVf != d.lowerUsage.vfWrite.reg)
+        {
+            f.lowerVfReg = d.lowerUsage.vfWrite.reg;
+            f.lowerVfLanes = d.lowerUsage.vfWrite.lanes;
+            f.lowerVfLatency = d.lowerUsage.vfLatency != 0u ? d.lowerUsage.vfLatency : d.lowerUsage.latency;
+        }
+        if (d.upperUsage.vfWrite.reg != 0u)
+        {
+            f.upperVfReg = d.upperUsage.vfWrite.reg;
+            f.upperVfLanes = d.upperUsage.vfWrite.lanes;
+            f.upperVfLatency = d.upperUsage.vfLatency != 0u ? d.upperUsage.vfLatency : d.upperUsage.latency;
+        }
+        f.viWrite = d.lowerUsage.viWrite & 0xFFFEu;
+        f.writtenVi = f.viWrite != 0u ? static_cast<uint8_t>(std::countr_zero(static_cast<uint32_t>(f.viWrite))) : 0u;
+        f.viLatency = d.lowerUsage.viLatency != 0u ? d.lowerUsage.viLatency : d.lowerUsage.latency;
+        for (uint32_t component = 0; component < 4u; ++component)
+            if ((d.upperUsage.accWrite & laneForComponent(component)) != 0u)
+                f.accWrite |= static_cast<uint8_t>(1u << component);
+        return f;
+    }
+
+    struct Ctx;
+    struct Table
+    {
+        Pair pairs[kTimingPairs];
+        uint32_t stamp[kTimingPairs] = {};
+        uint32_t epoch = 1;
+        const uint8_t *code = nullptr;
+        const PS2Memory *memory = nullptr;
+        uint64_t generation = ~0ull;
+        bool (*image)(Interp &, Ctx &) = nullptr; // translated program for this code image
+    };
+    static Table &table(bool vu1)
+    {
+        static Table tables[2];
+        return tables[vu1 ? 1 : 0];
+    }
+
+    static void markVfWrite(Interp &vu, uint8_t reg, uint8_t lanes, uint8_t latency)
+    {
+        for (uint32_t component = 0; component < 4u; ++component)
+            if ((lanes & laneForComponent(component)) != 0u)
+                vu.m_vfReady[reg][component] = vu.m_cycle + latency;
+    }
+
+    static uint64_t &nextCommitOf(const Interp &vu) { return g_nextCommitCycle[vu.m_unit == Interp::Unit::VU1 ? 1 : 0]; }
+
+    // Fast paths apply flag results (MAC/status/clip) lazily: they stay in the ring until an
+    // instruction reads them (execLower/lowerOp call commitReadyPipelines first), their slot is
+    // reused, another queue commits, or the run returns. A slot is applied only once due (issue + 4),
+    // in issue order, so every reader sees what the per-cycle commit gave. The per-cycle check
+    // below only looks at the other queues (Q/P, stores, VI/VF/ACC).
+    static uint64_t &nextOtherOf(const Interp &vu) { return g_nextOtherCycle[vu.m_unit == Interp::Unit::VU1 ? 1 : 0]; }
+
+    // m_state.cycles is set when run() returns (nothing reads it during a run).
+    static void advanceOne(Interp &vu)
+    {
+        ++vu.m_cycle;
+        if (vu.m_cycle >= nextOtherOf(vu))
+            vu.commitReadyPipelines();
+        if (vu.m_xgkick.active)
+            vu.progressXgkick();
+    }
+
+    // Stalls: without an active XGKICK nothing happens between queue commits, so the clock jumps to
+    // the next commit (or the target) at once. With one, VU memory still only changes at queue
+    // commits (stores), so the qwords PATH1 copies before the next commit are copied in one go: the
+    // same bytes and finish point as one cycle at a time.
+    static void advanceTo(Interp &vu, uint64_t target)
+    {
+        while (vu.m_cycle < target)
+        {
+            if (vu.m_xgkick.active)
+            {
+                const uint64_t to = std::min(target, std::max(nextOtherOf(vu), vu.m_cycle + 1u));
+                const uint64_t quiet = (to >= nextOtherOf(vu) ? to - 1u : to) - vu.m_cycle; // cycles without a commit
+                if (quiet == 0u)
+                {
+                    advanceOne(vu); // commit first, then PATH1's qword (advanceOneCycle's order)
+                    continue;
+                }
+                vu.m_cycle += quiet;
+                vu.m_xgkick.cycleCredit += static_cast<uint32_t>(std::min<uint64_t>(quiet - 1u, 1u << 20)); // progressXgkick adds the last
+                vu.progressXgkick();
+                continue;
+            }
+            const uint64_t to = std::min(target, std::max(nextOtherOf(vu), vu.m_cycle + 1u));
+            vu.m_cycle = to;
+            if (vu.m_cycle >= nextOtherOf(vu))
+                vu.commitReadyPipelines();
+        }
+    }
+
+    // Before an FMAC/CLIP/FSSET/FCSET adds this cycle's flag results: a full FIFO applies its due
+    // entries first.
+    static void beforeFlagWrite(Interp &vu)
+    {
+        FlagFifo &f = g_flagFifo[vu.m_unit == Interp::Unit::VU1 ? 1 : 0];
+        if (f.count == kFlagFifoSize && f.tail().issueCycle != vu.m_cycle)
+            vu.commitReadyPipelines();
+    }
+
+    // VI results commit at once in the fast paths (every VI read stalls until the register is ready,
+    // like VF; a branch right after the write still sees the old value through recordViWriteForBranch).
+    // The sequence bump makes a still-queued older write to the register stale.
+    static void viWritten(Interp &vu, uint8_t reg)
+    {
+        vu.m_viLatestWrite[reg] = ++vu.m_nextWriteSequence;
+    }
+
+    // The pair loop (see VU1Interpreter::run for the generic version with the per-pair traces).
+    static void loopPairs(Interp &vu, Table &t, uint8_t *vuCode, uint32_t codeSize, uint8_t *vuData, uint32_t dataSize,
+                          GS &gs, PS2Memory *memory, uint64_t budgetEnd, bool &programEnded, uint64_t &pairs)
+    {
+        uint64_t &nextCommit = nextOtherOf(vu);
+        VU1State &st = vu.m_state;
+        uint64_t *vfReady = &vu.m_vfReady[0][0];
+        while (vu.m_cycle < budgetEnd && !vu.m_stopRequested)
+        {
+            if (vu.m_cycle >= nextCommit)
+                vu.commitReadyPipelines();
+            const uint32_t pc = st.pc;
+            if (pc + 8u > codeSize)
+                break;
+            const uint32_t index = pc / 8u;
+            if (t.stamp[index] != t.epoch)
+            {
+                t.pairs[index] = build(vu.decodeInstructionPair(vuCode, pc & ~7u));
+                t.stamp[index] = t.epoch;
+            }
+            const Pair &f = t.pairs[index];
+            if (f.reserved)
+            {
+                vu.reportReservedInstruction(f.reservedUpper, f.reservedUpper ? f.upper.instr : f.lower);
+                break;
+            }
+
+            const auto readyCycle = [&]()
+            {
+                uint64_t ready = vu.m_cycle;
+                for (uint32_t i = 0; i < f.vfReadCount; ++i)
+                    ready = std::max(ready, vfReady[f.vfRead[i]]);
+                for (uint32_t bits = f.viRead; bits != 0u; bits &= bits - 1u)
+                    ready = std::max(ready, vu.m_viReady[static_cast<uint32_t>(std::countr_zero(bits))]);
+                for (uint32_t bits = f.accRead; bits != 0u; bits &= bits - 1u)
+                    ready = std::max(ready, vu.m_accReady[static_cast<uint32_t>(std::countr_zero(bits))]);
+                if (f.pipeline == Interp::PipelineFdiv && vu.m_fdiv.valid)
+                    ready = std::max(ready, vu.m_fdiv.readyCycle);
+                if (f.pipeline == Interp::PipelineEfu)
+                    ready = std::max(ready, vu.m_efuResourceReady);
+                if (f.waitQ && vu.m_fdiv.valid)
+                    ready = std::max(ready, vu.m_fdiv.readyCycle);
+                if (f.waitP)
+                    for (const auto &entry : vu.m_efu)
+                        if (entry.valid)
+                            ready = std::max(ready, entry.readyCycle);
+                if (f.pipeline == Interp::PipelineXgkick && vu.m_xgkick.active)
+                    ready = std::max(ready, vu.m_cycle + 1u);
+                return ready;
+            };
+            uint64_t ready = readyCycle();
+            while (ready > vu.m_cycle)
+            {
+                if (ready >= budgetEnd)
+                {
+                    advanceTo(vu, budgetEnd);
+                    break;
+                }
+                g_ghsStallSteps += ready - vu.m_cycle; // GHS-TRACE
+                advanceTo(vu, ready);
+                ready = readyCycle();
+            }
+            if (vu.m_cycle >= budgetEnd)
+                break;
+            ++pairs;
+
+            const uint8_t writtenVi = f.writtenVi;
+            const int32_t oldVi = writtenVi != 0u ? st.vi[writtenVi] : 0;
+
+            const auto runUpper = [&]()
+            {
+                if (!f.upper.fn)
+                    vu.execUpper(f.upper.instr);
+                else if (g_vuCheck)
+                    runChecked(vu, f.upper);
+                else
+                    f.upper.fn(vu, f.upper);
+            };
+            if (f.iBit)
+            {
+                runUpper();
+                float immediate = 0.0f;
+                std::memcpy(&immediate, &f.lower, sizeof(immediate));
+                st.i = vuNormalizeOperand(immediate);
+            }
+            else if (f.shadowReg != 0u)
+            {
+                float oldVf[4];
+                float upperVf[4];
+                std::memcpy(oldVf, st.vf[f.shadowReg], sizeof(oldVf));
+                runUpper();
+                std::memcpy(upperVf, st.vf[f.shadowReg], sizeof(upperVf));
+                std::memcpy(st.vf[f.shadowReg], oldVf, sizeof(oldVf));
+                vu.execLower(f.lower, vuData, dataSize, gs, memory, f.upper.instr);
+                std::memcpy(st.vf[f.shadowReg], upperVf, sizeof(upperVf));
+            }
+            else
+            {
+                runUpper();
+                if (!f.lowerNop)
+                    vu.execLower(f.lower, vuData, dataSize, gs, memory, f.upper.instr);
+            }
+
+            vu.m_viBranchBackupValid = false;
+            if (writtenVi != 0u)
+                viWritten(vu, writtenVi);
+
+            // markPairWrites: lower VF, upper VF, VI, ACC.
+            if (f.lowerVfReg != 0u)
+                markVfWrite(vu, f.lowerVfReg, f.lowerVfLanes, f.lowerVfLatency);
+            if (f.upperVfReg != 0u)
+                markVfWrite(vu, f.upperVfReg, f.upperVfLanes, f.upperVfLatency);
+            for (uint32_t bits = f.viWrite; bits != 0u; bits &= bits - 1u)
+                vu.m_viReady[static_cast<uint32_t>(std::countr_zero(bits))] = vu.m_cycle + f.viLatency;
+            for (uint32_t bits = f.accWrite; bits != 0u; bits &= bits - 1u)
+                vu.m_accReady[static_cast<uint32_t>(std::countr_zero(bits))] = vu.m_cycle + Interp::kAccForwardLatency;
+            if (writtenVi != 0u && f.delaysNextBranchRead)
+                vu.recordViWriteForBranch(writtenVi, oldVi);
+
+            st.vf[0][0] = 0.0f;
+            st.vf[0][1] = 0.0f;
+            st.vf[0][2] = 0.0f;
+            st.vf[0][3] = 1.0f;
+            st.vi[0] = 0;
+
+            uint32_t nextPc = pc + 8u;
+            if (nextPc >= codeSize)
+                nextPc = 0u;
+            st.pc = nextPc;
+            if (st.branchPending)
+            {
+                if (st.branchDelay == 0u)
+                {
+                    st.pc = st.branchTarget & vu.microAddressMask();
+                    st.branchPending = false;
+                }
+                else
+                    --st.branchDelay;
+            }
+
+            const bool dHalt = f.dBit && st.dBitEnabled;
+            const bool tHalt = f.tBit && st.tBitEnabled;
+            const bool haltBit = dHalt || tHalt;
+            const bool haltBranch = haltBit && f.pipeline == Interp::PipelineBranch;
+            if (st.haltAfterDelaySlot)
+            {
+                st.stoppedByD = vu.m_pendingHaltD;
+                st.stoppedByT = vu.m_pendingHaltT;
+                programEnded = true;
+            }
+            else if (st.ebit)
+                programEnded = true;
+            else if (haltBit && !haltBranch)
+            {
+                st.stoppedByD = dHalt;
+                st.stoppedByT = tHalt;
+                programEnded = true;
+            }
+            else if (f.eBit)
+                st.ebit = true;
+            else if (haltBranch)
+            {
+                st.haltAfterDelaySlot = true;
+                vu.m_pendingHaltD = dHalt;
+                vu.m_pendingHaltT = tHalt;
+            }
+
+            advanceOne(vu);
+            if (programEnded)
+                break;
+        }
+    }
+
+    // ---------------------------------------------------------------- translated microprograms
+    // GHS_VU1GEN=<dir> writes each VU1 code image the game uploads as C++ (<dir>\vu1_<hash>.cpp plus
+    // the index vu1_index.inc). Built from src/lib/vu/generated/ (one file per image), a known image runs
+    // as straight code: one step<PairC{...}>() per instruction pair, every field a compile-time
+    // constant (the same steps as loopPairs), direct jumps between consecutive pairs. Unknown images
+    // and addresses outside the translated range use loopPairs. The generated files contain game
+    // code: they stay local (untracked, not in the patch).
+    struct PairC // Pair as a template argument
+    {
+        uint32_t upper = 0;
+        uint32_t lower = 0;
+        uint16_t viRead = 0;
+        uint16_t viWrite = 0;
+        uint8_t vfReadCount = 0;
+        uint8_t vfRead[16] = {};
+        uint8_t accRead = 0;
+        uint8_t accWrite = 0;
+        uint8_t lowerVfReg = 0, lowerVfLanes = 0, lowerVfLatency = 0;
+        uint8_t upperVfReg = 0, upperVfLanes = 0, upperVfLatency = 0;
+        uint8_t viLatency = 0, writtenVi = 0, shadowReg = 0, pipeline = 0;
+        bool iBit = false, eBit = false, dBit = false, tBit = false;
+        bool waitQ = false, waitP = false, lowerNop = false, delaysNextBranchRead = false;
+        bool noFlags = false; // MAC/status results provably unread (emitImage)
+    };
+
+    struct Ctx
+    {
+        uint8_t *vuData;
+        uint32_t dataSize;
+        GS &gs;
+        PS2Memory *memory;
+        uint64_t budgetEnd;
+        bool &programEnded;
+        uint64_t pairs = 0;
+    };
+
+    static constexpr int16_t imm11(uint32_t i) { return static_cast<int16_t>(static_cast<int32_t>(i << 21) >> 21); }
+
+    // Lower instructions with constant fields: the frequent ones inline (same code as execLower),
+    // the rest through execLower.
+    template <uint32_t I>
+    static void lowerOp(Interp &vu, Ctx &a, uint32_t pc)
+    {
+        VU1State &st = vu.m_state;
+        constexpr uint32_t op = (I >> 25) & 0x7Fu;
+        constexpr uint8_t vfT = static_cast<uint8_t>((I >> 16) & 0x1Fu);
+        constexpr uint8_t vfS = static_cast<uint8_t>((I >> 11) & 0x1Fu);
+        constexpr uint8_t viT = static_cast<uint8_t>((I >> 16) & 0xFu);
+        constexpr uint8_t viS = static_cast<uint8_t>((I >> 11) & 0xFu);
+        constexpr uint8_t viD = static_cast<uint8_t>((I >> 6) & 0xFu);
+        constexpr uint8_t dest = static_cast<uint8_t>((I >> 21) & 0xFu);
+        constexpr int16_t imm = imm11(I);
+        constexpr uint32_t pcMask = 0x3FFFu; // VU1 (microAddressMask)
+        const auto load = [&](uint32_t addr, uint8_t reg)
+        {
+            addr &= (a.dataSize - 1);
+            if (addr + 16 <= a.dataSize)
+            {
+                float tmp[4];
+                std::memcpy(tmp, a.vuData + addr, 16);
+                vu.applyDest(st.vf[reg], tmp, dest);
+            }
+        };
+        const auto store = [&](uint32_t addr, uint8_t reg)
+        {
+            addr &= (a.dataSize - 1);
+            if (addr + 16 <= a.dataSize)
+            {
+                uint32_t words[4]{};
+                std::memcpy(words, st.vf[reg], sizeof(words));
+                vu.queueStore(addr, words, dest);
+            }
+        };
+        const auto branch = [&](uint32_t target)
+        {
+            st.branchPending = true;
+            st.branchTarget = target;
+            st.branchDelay = 1;
+        };
+        constexpr uint32_t relTargetOffset = static_cast<uint32_t>(8 + imm * 8);
+        if constexpr (op == 0x00u) // LQ
+            load(static_cast<uint32_t>(static_cast<int32_t>(st.vi[viS] + imm)) * 16u, vfT);
+        else if constexpr (op == 0x01u) // SQ
+            store(static_cast<uint32_t>(static_cast<int32_t>(st.vi[viT] + imm)) * 16u, vfS);
+        else if constexpr (op == 0x04u) // ILW
+        {
+            uint32_t addr = static_cast<uint32_t>(static_cast<int32_t>(st.vi[viS] + imm)) * 16u;
+            addr &= (a.dataSize - 1);
+            if (addr + 16 <= a.dataSize)
+            {
+                constexpr int comp = (dest & 0x8) ? 0 : (dest & 0x4) ? 1 : (dest & 0x2) ? 2 : 3;
+                uint32_t v;
+                std::memcpy(&v, a.vuData + addr + comp * 4, 4);
+                if constexpr (viT != 0)
+                    st.vi[viT] = static_cast<int32_t>(static_cast<int16_t>(v & 0xFFFF));
+            }
+        }
+        else if constexpr (op == 0x05u) // ISW
+        {
+            uint32_t addr = static_cast<uint32_t>(static_cast<int32_t>(st.vi[viS] + imm)) * 16u;
+            addr &= (a.dataSize - 1);
+            if (addr + 16 <= a.dataSize)
+            {
+                const uint32_t val = static_cast<uint32_t>(static_cast<uint16_t>(st.vi[viT] & 0xFFFF));
+                const uint32_t words[4] = {val, val, val, val};
+                vu.queueStore(addr, words, dest);
+            }
+        }
+        else if constexpr (op == 0x08u || op == 0x09u) // IADDIU / ISUBIU
+        {
+            constexpr int16_t immu = static_cast<int16_t>(static_cast<int16_t>(I & 0x7FF) | ((I >> 10) & 0x7800));
+            if constexpr (viT != 0)
+                st.vi[viT] = op == 0x08u ? static_cast<int16_t>(st.vi[viS] + immu) : static_cast<int16_t>(st.vi[viS] - immu);
+        }
+        else if constexpr (op == 0x11u) // FCSET
+            vu.queueFcset(I & 0xFFFFFFu);
+        else if constexpr (op == 0x12u) // FCAND
+        {
+            vu.commitReadyPipelines(); // due flag results
+            st.vi[1] = ((st.clip & (I & 0xFFFFFFu)) != 0) ? 1 : 0;
+        }
+        else if constexpr (op == 0x15u) // FSSET
+            vu.queueFsset(static_cast<uint16_t>((((I >> 21) & 0x1u) << 11) | (I & 0x7FFu)));
+        else if constexpr (op == 0x1Au) // FMAND
+        {
+            vu.commitReadyPipelines(); // due flag results
+            if constexpr (viT != 0)
+                st.vi[viT] = static_cast<int32_t>(st.mac & static_cast<uint32_t>(static_cast<uint16_t>(st.vi[viS])));
+        }
+        else if constexpr (op == 0x1Cu) // FCGET
+        {
+            vu.commitReadyPipelines(); // due flag results
+            if constexpr (viT != 0)
+                st.vi[viT] = static_cast<int32_t>(st.clip & 0x0FFFu);
+        }
+        else if constexpr (op == 0x20u) // B
+            branch((pc + relTargetOffset) & pcMask);
+        else if constexpr (op == 0x21u) // BAL
+        {
+            if constexpr (viT != 0)
+                st.vi[viT] = static_cast<int32_t>((pc + 16) / 8);
+            branch((pc + relTargetOffset) & pcMask);
+        }
+        else if constexpr (op == 0x24u) // JR
+            branch((static_cast<uint32_t>(static_cast<uint16_t>(vu.readBranchVi(viS))) * 8u) & pcMask);
+        else if constexpr (op == 0x25u) // JALR
+        {
+            const uint32_t target = (static_cast<uint32_t>(static_cast<uint16_t>(vu.readBranchVi(viS))) * 8u) & pcMask;
+            if constexpr (viT != 0)
+                st.vi[viT] = static_cast<int32_t>((pc + 16) / 8);
+            branch(target);
+        }
+        else if constexpr (op == 0x28u || op == 0x29u || op == 0x2Cu || op == 0x2Du || op == 0x2Eu || op == 0x2Fu) // IBxx
+        {
+            const int16_t s = static_cast<int16_t>(vu.readBranchVi(viS));
+            bool taken;
+            if constexpr (op == 0x28u) taken = s == static_cast<int16_t>(vu.readBranchVi(viT));
+            else if constexpr (op == 0x29u) taken = s != static_cast<int16_t>(vu.readBranchVi(viT));
+            else if constexpr (op == 0x2Cu) taken = s < 0;
+            else if constexpr (op == 0x2Du) taken = s > 0;
+            else if constexpr (op == 0x2Eu) taken = s <= 0;
+            else taken = s >= 0;
+            if (taken)
+                branch((pc + relTargetOffset) & pcMask);
+        }
+        else if constexpr (op == 0x40u && (I & 0x3Fu) < 0x3Cu)
+        {
+            constexpr uint32_t funct = I & 0x3Fu;
+            if constexpr (funct == 0x30u) { if constexpr (viD != 0) st.vi[viD] = static_cast<int16_t>(st.vi[viS] + st.vi[viT]); }
+            else if constexpr (funct == 0x31u) { if constexpr (viD != 0) st.vi[viD] = static_cast<int16_t>(st.vi[viS] - st.vi[viT]); }
+            else if constexpr (funct == 0x32u)
+            {
+                constexpr int16_t imm5 = static_cast<int16_t>(static_cast<int32_t>((I >> 6) & 0x1F) << 27 >> 27);
+                if constexpr (viT != 0)
+                    st.vi[viT] = static_cast<int16_t>(st.vi[viS] + imm5);
+            }
+            else if constexpr (funct == 0x34u) { if constexpr (viD != 0) st.vi[viD] = st.vi[viS] & st.vi[viT]; }
+            else if constexpr (funct == 0x35u) { if constexpr (viD != 0) st.vi[viD] = st.vi[viS] | st.vi[viT]; }
+            else
+                vu.execLower(I, a.vuData, a.dataSize, a.gs, a.memory, 0u);
+        }
+        else if constexpr (op == 0x40u)
+        {
+            constexpr uint32_t funct2 = (I & 0x3u) | ((I >> 4) & 0x7Cu);
+            if constexpr (funct2 == 0x30u) // MOVE
+            {
+                float tmp[4];
+                std::memcpy(tmp, st.vf[vfS], 16);
+                vu.applyDest(st.vf[vfT], tmp, dest);
+            }
+            else if constexpr (funct2 == 0x31u) // MR32
+            {
+                float tmp[4] = {st.vf[vfS][1], st.vf[vfS][2], st.vf[vfS][3], st.vf[vfS][0]};
+                vu.applyDest(st.vf[vfT], tmp, dest);
+            }
+            else if constexpr (funct2 == 0x34u) // LQI
+            {
+                load(static_cast<uint32_t>(static_cast<uint16_t>(st.vi[viS])) * 16u, vfT);
+                if constexpr (viS != 0)
+                    st.vi[viS] = static_cast<int16_t>(st.vi[viS] + 1);
+            }
+            else if constexpr (funct2 == 0x35u) // SQI
+            {
+                store(static_cast<uint32_t>(static_cast<uint16_t>(st.vi[viT])) * 16u, vfS);
+                if constexpr (viT != 0)
+                    st.vi[viT] = static_cast<int16_t>(st.vi[viT] + 1);
+            }
+            else if constexpr (funct2 == 0x36u) // LQD
+            {
+                if constexpr (viS != 0)
+                    st.vi[viS] = static_cast<int16_t>(st.vi[viS] - 1);
+                load(static_cast<uint32_t>(static_cast<uint16_t>(st.vi[viS])) * 16u, vfT);
+            }
+            else if constexpr (funct2 == 0x37u) // SQD
+            {
+                if constexpr (viT != 0)
+                    st.vi[viT] = static_cast<int16_t>(st.vi[viT] - 1);
+                store(static_cast<uint32_t>(static_cast<uint16_t>(st.vi[viT])) * 16u, vfS);
+            }
+            else if constexpr (funct2 == 0x3Bu || funct2 == 0x7Bu) // WAITQ / WAITP
+            {
+            }
+            else if constexpr (funct2 == 0x3Cu) // MTIR
+            {
+                constexpr uint32_t comp = (I >> 21) & 0x3u;
+                uint32_t fval;
+                std::memcpy(&fval, &st.vf[vfS][comp], 4);
+                if constexpr (viT != 0)
+                    st.vi[viT] = static_cast<int32_t>(static_cast<int16_t>(fval & 0xFFFF));
+            }
+            else if constexpr (funct2 == 0x3Du) // MFIR
+            {
+                float result[4];
+                const int32_t val = static_cast<int32_t>(static_cast<int16_t>(st.vi[viS] & 0xFFFF));
+                std::memcpy(&result[0], &val, 4);
+                result[1] = result[0];
+                result[2] = result[0];
+                result[3] = result[0];
+                vu.applyDest(st.vf[vfT], result, dest);
+            }
+            else if constexpr (funct2 == 0x64u) // MFP
+            {
+                const float result[4] = {st.p, st.p, st.p, st.p};
+                vu.applyDest(st.vf[vfT], result, dest);
+            }
+            else if constexpr (funct2 == 0x68u) { if constexpr (viT != 0) st.vi[viT] = static_cast<int32_t>(st.top & 0x3FFu); } // XTOP
+            else if constexpr (funct2 == 0x69u) { if constexpr (viT != 0) st.vi[viT] = static_cast<int32_t>(st.itop & 0x3FFu); } // XITOP
+            else if constexpr (funct2 == 0x6Cu) // XGKICK
+                vu.startXgkick(static_cast<uint32_t>(static_cast<uint16_t>(st.vi[viS])));
+            else
+                vu.execLower(I, a.vuData, a.dataSize, a.gs, a.memory, 0u);
+        }
+        else
+            vu.execLower(I, a.vuData, a.dataSize, a.gs, a.memory, 0u);
+    }
+
+    // The execute part of a pair (upper/lower, VI write, branch backup, vf0/vi0), shared by step
+    // and the statically scheduled blocks.
+    template <PairC P>
+    static __forceinline void execPair(Interp &vu, Ctx &a, uint32_t pc)
+    {
+        VU1State &st = vu.m_state;
+        constexpr uint8_t writtenVi = P.writtenVi;
+        const int32_t oldVi = writtenVi != 0u ? st.vi[writtenVi] : 0;
+        static constexpr Op kUpper = decode(P.upper);
+        static constexpr Op kUpperNoFlags = decode(P.upper, false);
+        const auto runUpper = [&]() [[msvc::forceinline]]
+        {
+            if constexpr (kUpper.fn == nullptr)
+                vu.execUpper(P.upper);
+            else if (g_vuCheck)
+                runChecked(vu, kUpper);
+            else if (P.noFlags && !g_vuAllFlags)
+            {
+                static constexpr FmacShape kShape = fmacShape(P.upper);
+                if constexpr (kShape.valid)
+                    fmacNoFlags<kShape.form, kShape.rhs, kShape.toAcc>(vu, kUpperNoFlags);
+                else
+                    kUpperNoFlags.fn(vu, kUpperNoFlags);
+            }
+            else
+                kUpper.fn(vu, kUpper);
+        };
+        if constexpr (P.iBit)
+        {
+            runUpper();
+            float immediate = 0.0f;
+            std::memcpy(&immediate, &P.lower, sizeof(immediate));
+            st.i = vuNormalizeOperand(immediate);
+        }
+        else if constexpr (P.shadowReg != 0u)
+        {
+            float oldVf[4];
+            float upperVf[4];
+            std::memcpy(oldVf, st.vf[P.shadowReg], sizeof(oldVf));
+            runUpper();
+            std::memcpy(upperVf, st.vf[P.shadowReg], sizeof(upperVf));
+            std::memcpy(st.vf[P.shadowReg], oldVf, sizeof(oldVf));
+            lowerOp<P.lower>(vu, a, pc);
+            std::memcpy(st.vf[P.shadowReg], upperVf, sizeof(upperVf));
+        }
+        else
+        {
+            runUpper();
+            if constexpr (!P.lowerNop)
+                lowerOp<P.lower>(vu, a, pc);
+        }
+
+        vu.m_viBranchBackupValid = false;
+        if constexpr (writtenVi != 0u)
+            viWritten(vu, writtenVi);
+        if constexpr (writtenVi != 0u && P.delaysNextBranchRead)
+            vu.recordViWriteForBranch(writtenVi, oldVi);
+
+        st.vf[0][0] = 0.0f;
+        st.vf[0][1] = 0.0f;
+        st.vf[0][2] = 0.0f;
+        st.vf[0][3] = 1.0f;
+        st.vi[0] = 0;
+
+    }
+
+    // A pair inside a statically scheduled block: its issue cycle is known, so no ready check,
+    // stall, ready-cycle marks or cycle stepping (the block does those once).
+    template <PairC P>
+    static __declspec(noinline) __declspec(safebuffers) void staticPair(Interp &vu, Ctx &a, uint32_t pc, uint64_t cycle)
+    {
+        // The cycles since the previous pair (stalls included), with their commits and XGKICK progress;
+        // usually nothing happens in between and the clock just moves.
+        if (!vu.m_xgkick.active && cycle < g_nextOtherCycle[1])
+            vu.m_cycle = cycle;
+        else
+            advanceTo(vu, cycle);
+        if (vu.m_cycle >= g_nextOtherCycle[1])
+            vu.commitReadyPipelines();
+        execPair<P>(vu, a, pc);
+    }
+
+    // One pair of a translated program: loopPairs' iteration with every field constant. Returns true
+    // when the run stops (program end, budget, stop request).
+    template <PairC P>
+    static __declspec(noinline) __declspec(safebuffers) bool step(Interp &vu, Ctx &a, uint32_t pc); // defined below
+
+    // A translated code image (generated/vu1_<hash>.cpp; nested, so it has VU1Fast's access to VU1Interpreter)
+    // and its entry point, defined there and listed in generated/vu1_index.inc.
+    template <uint64_t H>
+    struct Image;
+    template <uint64_t H>
+    static bool image(Interp &vu, Ctx &a);
+    struct Driver; // the rest of the fast path (ps2_vu1_core.cpp)
+};
+
+#ifdef VU1_DEFINE_STEPS
+// step's body, only in generated/vu1_steps_<k>.cpp: those instantiate each distinct pair once for all images (each
+// image instantiating its own ~750 of them made it ~20x slower to compile than one file with every image).
+template <VU1Fast::PairC P>
+bool VU1Fast::step(Interp &vu, Ctx &a, uint32_t pc)
+{
+    VU1State &st = vu.m_state;
+    if (vu.m_cycle >= a.budgetEnd || vu.m_stopRequested)
+        return true;
+    if (vu.m_cycle >= nextOtherOf(vu))
+        vu.commitReadyPipelines();
+
+    const auto readyCycle = [&]()
+    {
+        uint64_t ready = vu.m_cycle;
+        const uint64_t *vfReady = &vu.m_vfReady[0][0];
+        for (uint32_t i = 0; i < P.vfReadCount; ++i)
+            ready = std::max(ready, vfReady[P.vfRead[i]]);
+        for (uint32_t r = 1; r < 16u; ++r)
+            if ((P.viRead >> r) & 1u)
+                ready = std::max(ready, vu.m_viReady[r]);
+        for (uint32_t c = 0; c < 4u; ++c)
+            if ((P.accRead >> c) & 1u)
+                ready = std::max(ready, vu.m_accReady[c]);
+        if constexpr (P.pipeline == Interp::PipelineFdiv)
+            if (vu.m_fdiv.valid)
+                ready = std::max(ready, vu.m_fdiv.readyCycle);
+        if constexpr (P.pipeline == Interp::PipelineEfu)
+            ready = std::max(ready, vu.m_efuResourceReady);
+        if constexpr (P.waitQ)
+            if (vu.m_fdiv.valid)
+                ready = std::max(ready, vu.m_fdiv.readyCycle);
+        if constexpr (P.waitP)
+            for (const auto &entry : vu.m_efu)
+                if (entry.valid)
+                    ready = std::max(ready, entry.readyCycle);
+        if constexpr (P.pipeline == Interp::PipelineXgkick)
+            if (vu.m_xgkick.active)
+                ready = std::max(ready, vu.m_cycle + 1u);
+        return ready;
+    };
+    uint64_t ready = readyCycle();
+    while (ready > vu.m_cycle)
+    {
+        if (ready >= a.budgetEnd)
+        {
+            advanceTo(vu, a.budgetEnd);
+            break;
+        }
+        g_ghsStallSteps += ready - vu.m_cycle; // GHS-TRACE
+        advanceTo(vu, ready);
+        ready = readyCycle();
+    }
+    if (vu.m_cycle >= a.budgetEnd)
+        return true;
+    ++a.pairs;
+    ++g_ghsStepPairs[(pc >> 3) & 0x7FFu]; // GHS-TRACE
+
+    execPair<P>(vu, a, pc);
+    if constexpr (P.lowerVfReg != 0u)
+        markVfWrite(vu, P.lowerVfReg, P.lowerVfLanes, P.lowerVfLatency);
