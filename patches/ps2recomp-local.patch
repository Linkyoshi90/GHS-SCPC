+#pragma once
+#include <cstdint>
+
+// AVX2 per-pixel work of GSCpuBackend::DrawTriangle (docs\GS_RASTERIZER_PLAN.md, option B): 8 pixels of a row at
+// a time, every lane doing exactly the scalar code's float operations in the same order (no FMA, no reciprocal
+// approximations), so the bytes stay the same. Compiled with /arch:AVX2 in its own file; the caller's scalar code
+// still does the pixel writes and samples the lanes whose texels aren't in the decoded-texel cache yet.
+namespace gs_simd
+{
+    struct TriangleSetup
+    {
+        float fx0, fy0, fx1, fy1, fx2, fy2, winding, invAbsDenom;
+        double z0, z1, z2;
+        float r[3], g[3], b[3], a[3], fog[3], s[3], t[3], q[3], u[3], v[3]; // vertex values as the scalar code converts them
+        uint32_t flatRgba;                                                   // v2's colour (no Gouraud)
+        bool iip, tme, fst, linear, tcc;
+        int tfx;
+        // Decoded-texel cache of the draw's texture; texels == nullptr: every textured lane samples on the scalar path.
+        int texW, texH;
+        uint8_t wrapU, wrapV;
+        const uint32_t *texels, *stamps;
+        int decW, decH;
+        uint32_t stamp;
+    };
+
+    enum : uint8_t
+    {
+        kInside = 1,     // passes the edge test
+        kNeedSample = 2, // texel from the scalar SampleWith (s/t/q or u/v below), then combined with rgba (the shade colour)
+    };
+
+    // Per pixel of a span (index x - xStart); every array needs room for 8 more entries than the span.
+    struct RowPixels
+    {
+        uint8_t *flags;
+        double *z;      // before the + 0.5 and the conversion to u32
+        uint32_t *rgba; // final colour, or the shade colour with kNeedSample
+        uint32_t *fog;
+        float *s, *t, *q;
+        uint32_t *u, *v; // FST texel coordinates as uint16_t
+    };
+
+    // GSCpuBackend::DrawTriangle's writeFast for 8 pixels at a time: CT24 or CT16/CT16S frame, Z24/Z32, no DATE,
+    // no FBMSK (the caller checks). Fog, alpha test, Z test, blending (PABE), FBA, stores.
+    struct WriteSetup
+    {
+        uint8_t *vram;
+        bool frame16, z24; // CT16/CT16S frame (else CT24); Z24 (else Z32)
+        uint32_t ztst;     // TEST.ZTST (not 0)
+        bool zmask;
+        uint64_t test; // TEST (alpha test fields)
+        bool fge;
+        uint32_t fogR, fogG, fogB;
+        bool abe, pabe, fba;
+        uint32_t selA, selB, selC, selD, fix;
+    };
+
+    // Pixels with kInside in flags, colours final (kNeedSample already resolved), z already converted to u32;
+    // zAddr/cAddr: byte addresses of each pixel's Z and colour (cAddr + 4 must stay inside VRAM).
+    void writeRow(const WriteSetup &setup, int count, const uint8_t *flags, const uint32_t *rgba, const uint32_t *fog, const uint32_t *z,
+                  const uint32_t *zAddr, const uint32_t *cAddr);
+
+    bool available(); // AVX2 present and not switched off (GHS_GS_NO_SIMD=1)
+    void triangleRow(const TriangleSetup &setup, float py, int xStart, int xEnd, const RowPixels &out);
+}
