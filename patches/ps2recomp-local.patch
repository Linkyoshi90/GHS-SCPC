+// GHS: keyboard and controller bindings (F2 -> Controls, F4): two keys per action (raylib KeyboardKey codes, 0 = none)
+// and one controller button (raylib GamepadButton, 0 = none), saved as key_<id>=a,b and pad_<id>=n lines in
+// ghs_settings.ini. ps2_pad.cpp reads them, ps2_debug_panel.cpp edits them.
+#pragma once
+
+enum GhsKeyAction
+{
+    kGhsDpadUp, kGhsDpadDown, kGhsDpadLeft, kGhsDpadRight,
+    kGhsMoveUp, kGhsMoveDown, kGhsMoveLeft, kGhsMoveRight,
+    kGhsWalk, kGhsSlowWalk,
+    kGhsCross, kGhsCircle, kGhsSquare, kGhsTriangle,
+    kGhsL1, kGhsR1, kGhsL2, kGhsR2, kGhsL3, kGhsR3,
+    kGhsStart, kGhsSelect,
+    kGhsFastForward, // host action: the game runs unpaced while it is held (EeScheduler)
+    kGhsKeyActionCount
+};
+
+struct GhsKeyActionInfo
+{
+    const char *id;    // in ghs_settings.ini
+    const char *label; // in the Controls tab
+    int defaults[2];
+    int padDefault;    // -1: not a controller button (the left stick moves; walking speed is its tilt)
+};
+
+extern const GhsKeyActionInfo g_ghsKeyActionInfo[kGhsKeyActionCount];
+extern int g_ghsKeys[kGhsKeyActionCount][2];
+extern int g_ghsPadButtons[kGhsKeyActionCount];
+extern int g_ghsKeySuppressed; // a key just bound in the Controls tab: the game doesn't see it until it is released
+extern int g_ghsPadSuppressed; // the same for a controller button
+
+bool ghsKeyActionDown(GhsKeyAction action);
+bool ghsPadActionDown(GhsKeyAction action);
+const char *ghsKeyName(int key);         // the key's label on the current keyboard layout
+const char *ghsPadButtonName(int button); // Xbox / PlayStation names
+void ghsResetKeys();                      // keyboard and controller defaults
