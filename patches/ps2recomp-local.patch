+            switch (code)
+            {
+            case 0x1Cu: form = Mul; scalar = q; useScalar = true; break;
+            case 0x1Eu: form = Mul; scalar = i; useScalar = true; break;
+            case 0x20u: form = Add; scalar = q; useScalar = true; break;
+            case 0x21u: form = MulAdd; scalar = q; useScalar = true; break;
+            case 0x22u: form = Add; scalar = i; useScalar = true; break;
+            case 0x23u: form = MulAdd; scalar = i; useScalar = true; break;
+            case 0x24u: form = Sub; scalar = q; useScalar = true; break;
+            case 0x25u: form = MulSub; scalar = q; useScalar = true; break;
+            case 0x26u: form = Sub; scalar = i; useScalar = true; break;
+            case 0x27u: form = MulSub; scalar = i; useScalar = true; break;
+            case 0x28u: form = Add; break;
+            case 0x29u: form = MulAdd; break;
+            case 0x2Au: form = Mul; break;
+            case 0x2Cu: form = Sub; break;
+            case 0x2Du: form = MulSub; break;
+            case 0x2Eu:
