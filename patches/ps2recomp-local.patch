+// in batch; 12 words each: cpsm, csm, csa, cbp, cbw, cou, cov, first entry, entry end, four-bit texture),
+// 1 load count, 2 version before the run, 3 first version written (the versions written never include 2:
+// FlushRun's ring rule).
+uint bw(uint i) { return batch.Load(i * 4u); }
