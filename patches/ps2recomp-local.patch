+[numthreads(512, 1, 1)]
+void CSClut(uint3 group : SV_GroupID, uint gi : SV_GroupIndex)
+{
+    loadTables(gi, 512u);
+    const uint e = gi; // 0-511
+    const uint k = group.y * 65535u + group.x;
+    if (k >= cb(1))
+        return;
+    const uint L = cb(0) + k * 12u;
+    const uint cpsm = bw(L), csm = bw(L + 1u);
+    const bool sixteen = cpsm == 0x02u || cpsm == 0x0Au;
+    const uint base = (sixteen ? (bw(L + 2u) & 0x1Fu) : (bw(L + 2u) & 0x0Fu)) << 4;
+    const bool suffix = csm == 0u && !sixteen && bw(L + 9u) == 0u;
+    // The entry stored at e (a load writes dst = (base + entry) & mask, and dst + 256 for the high halves of 32-bit CLUTs).
+    const uint slot = sixteen ? e : (e & 0xFFu);
+    const uint entry = sixteen ? ((slot - base) & 0x1FFu) : ((suffix ? slot : slot - base) & 0xFFu);
+    uint value = 0xFFFFFFFFu;
+    if (entry >= bw(L + 7u) && entry < bw(L + 8u))
+    {
+        uint sx, sy, sw;
+        if (csm == 0u)
+        {
+            const uint si = (entry & ~0x18u) | ((entry & 0x08u) << 1) | ((entry & 0x10u) >> 1); // CSM1 swaps bits 3 and 4
+            sx = si & 0x0Fu;
+            sy = si >> 4;
+            sw = 1u;
+        }
+        else
+        {
+            sw = bw(L + 4u) != 0u ? bw(L + 4u) : 1u;
+            sx = (bw(L + 5u) << 4) + entry;
+            sy = bw(L + 6u);
+        }
+        const uint raw = readPixel(cpsm, bw(L + 3u), sw, sx, sy);
+        value = (!sixteen && e >= 256u) ? (raw >> 16) : (raw & 0xFFFFu);
+    }
+    clut.Store((cb(3) + 1u + k) * 2048u + e * 4u, value);
+}
+
+[numthreads(64, 1, 1)]
+void CSClutCarry(uint3 id : SV_DispatchThreadID)
+{
+    const uint e = id.x; // 0-511
+    uint value = clut.Load(cb(2) * 2048u + e * 4u);
+    clut.Store(cb(3) * 2048u + e * 4u, value);
+    const uint n = cb(1);
+    for (uint k = 0u; k < n; k += 8u)
+    {
+        uint w[8];
+        [unroll] for (uint j = 0u; j < 8u; ++j) // the loads first, so they overlap
+            w[j] = k + j < n ? clut.Load((cb(3) + 1u + k + j) * 2048u + e * 4u) : 0u;
+        [unroll] for (uint j = 0u; j < 8u; ++j)
+            if (k + j < n)
+            {
+                if (w[j] == 0xFFFFFFFFu)
+                    clut.Store((cb(3) + 1u + k + j) * 2048u + e * 4u, value);
+                else
+                    value = w[j];
+            }
+    }
+}
