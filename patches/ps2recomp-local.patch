+// GHS: cheats (F5, ps2_debug_panel.cpp). The game-specific side (overrides\zz_ghs_cheats.cpp, in the runner) reads
+// these once a frame on the game thread and changes EE RAM.
+#pragma once
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+
+// One actor for the guest radar: its slot (6 = Catherine), its AI mode flags (actor +0x08), its position.
+struct GhsGuestView
+{
+    int slot;
+    uint32_t flags;
+    float x, z;
+};
+
+struct GhsCheats
+{
+    std::atomic<bool> infiniteHealth{false};   // the mental gauge stays full
+    std::atomic<bool> infiniteItems{false};    // items aren't used up
+    std::atomic<bool> infiniteKeyItems{false}; // key items aren't used up
+    std::atomic<bool> invulnerable{false};     // guests' catches don't start
+    std::atomic<bool> noDetection{false};      // hunting guests don't see or hear the player (and so neither catch him)
+    std::atomic<float> timeScale{1.0f};        // in-game clock speed (only the clock, not the game)
+    std::atomic<int> giveItem{-1};             // an item id to add once (0-129 items, 130 and up key items); -1 none
+    std::atomic<int> removeItem{-1};           // an item id to take one of away once; -1 none
+    std::atomic<bool> speedUp{false};          // the Speed Up item's effect never runs out
+    std::atomic<bool> noConditions{false};     // the six conditions (tiredness ... darkness) are cured at once
+    // Item randomizer (F5 submenu; classes kept in ghs_randomizer.ini): Roll shuffles the item placements of the ticked
+    // classes once (the game side takes randomizerRoll's seed). Class bits: see itemClass in zz_ghs_cheats.cpp.
+    std::atomic<uint32_t> randomizerClasses{0x3Fu};
+    std::atomic<uint32_t> randomizerSeed{0}; // the last roll's seed (shown)
+    std::atomic<uint32_t> randomizerRoll{0}; // a seed to shuffle with now; 0 none
+    std::atomic<bool> randomizerMove{false}; // also move lying items to new floor spots (any room that holds items)
+    std::atomic<bool> guestShuffle{false};   // shuffle the guests' one-off visits each night (with randomizerSeed)
+    // Warp: the game side lists the rooms a door definition leads into (warpRooms[0..warpRoomCount), filled once in
+    // play) and the room the player is in; warpTo is a room to go to now (-1 none).
+    std::array<int16_t, 128> warpRooms{};
+    std::atomic<int> warpRoomCount{0};
+    std::atomic<int> currentRoom{-1};
+    std::atomic<int> warpTo{-1};
+    std::atomic<int> spinMine{0};              // roulette board game: your spins land on this number (1-8; 0 normal)
+    std::atomic<int> spinTheirs{0};            // and the computer opponent's (Gregory)
+    std::atomic<bool> radar{false};            // the guest radar overlay: the game side fills the fields below
+    std::mutex radarLock;
+    std::array<GhsGuestView, 64> guests{};
+    int guestCount = 0;
+    float playerX = 0.0f, playerZ = 0.0f;
+};
+extern GhsCheats g_ghsCheats;
