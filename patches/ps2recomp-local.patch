diff --git a/ps2xRuntime/include/runtime/gs/gs_gpu_backend.h b/ps2xRuntime/include/runtime/gs/gs_gpu_backend.h
new file mode 100644
index 0000000..729c574
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_gpu_backend.h
@@ -0,0 +1,139 @@
+#pragma once
+
+#include "runtime/gs/gs_cpu_backend.h"
+
+#include <array>
+#include <bitset>
+#include <memory>
+#include <mutex>
+
+// GHS: GS rasterizer on the GPU (docs\GS_RASTERIZER_PLAN.md, option A; D3D11 compute on its own device,
+// Windows only), the default (GHS_GS_GPU=0: the CPU backend). PS2 VRAM lives on the GPU as a 4 MB buffer in the PS2 layout.
+// Milestones 1-2 run host->local uploads, local->local copies, CLUT loads and sprites/triangles (texturing,
+// Z, blending, alpha/destination-alpha test, fog, FBMSK) there; draws and CLUT loads are batched into runs
+// (one CLUT and one tiled draw dispatch each, milestone 4); everything else (lines, points, clears,
+// self-sampling or self-aliasing draws, local->host) goes to a wrapped GSCpuBackend on the same VRAM, with a
+// full 4 MB copy whenever the side holding the newest VRAM changes. Sync() leaves the newest VRAM in the
+// caller's array, except Sync(Finish): the presenter's FINISH copy comes from StartFinishCopy.
+class GSGpuBackend final : public GSRasterBackend
+{
+public:
+    GSGpuBackend();
+    ~GSGpuBackend() override;
+
+    void Initialize(uint8_t *vram, uint32_t vramSize) override;
+    void Reset() override;
+
+    void Submit(const GSPrimitiveBatch &batch) override;
+    void LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut) override;
+    void LoadClutValues(const GSTex0Reg &tex0, const GSTexClutReg &texclut, const uint32_t *raws) override;
+
+    void BeginTransfer(const GSTransferCommand &command) override;
+    void UploadImage(const uint8_t *data, uint32_t sizeBytes) override;
+
+    void Flush() override;
+    void TextureFlush() override;
+    void InvalidateTextureRange(uint32_t beginBytes, uint32_t endBytes, bool keepTopByteTextures = false) override;
+    void Sync(GSSyncReason reason) override;
+    PresentationFrame Present(const GSPresentationRequest &request) override;
+
+    bool ClearFramebuffer(const GSContext &context, uint32_t rgba) override;
+    uint32_t ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes) override;
+
+    uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const override;
+    void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) override;
+    void SnapshotVram(std::vector<uint8_t> &out) const override;
+    GSTransferSnapshot GetTransferSnapshot() const override;
+
+    // FINISH's copy for the presenter (gs_frontend.cpp, GHS_PRESENT_FINISH): the pages PresentFromSnapshot reads
+    // for `request` (display buffers, preferred source, context frames), copied on the GPU without waiting.
+    // 0: the CPU array is current, use it. FinishCopyData puts them into `out` (4 MB, other pages left as
+    // they are) when the frame is presented; false: the copy was overwritten by newer ones.
+    uint64_t StartFinishCopy(const GSPresentationRequest &request);
+    bool FinishCopyData(uint64_t ticket, std::vector<uint8_t> &out);
+    // GHS_GS_SCALE=N: `frame` (PresentFromSnapshot's 1x frame of that FINISH, its pixels not needed) replaced by the
+    // scaled display buffer, N times as wide and high, packed rows; false (frame unchanged) for displays it doesn't cover.
+    // The image is built in `spare` (a buffer kept by the caller: no fresh 6 MB per frame at 3x), swapped with frame's.
+    bool ScaleFrame(uint64_t ticket, const GSPresentationRequest &request, PresentationFrame &frame, std::vector<uint8_t> &spare);
+    // The resolution scale, also while running (the F2 settings window): 1-4, 1 = no scaled surfaces. New
+    // surfaces start from VRAM at the next FINISH, so a frame or two after a change look like 1x.
+    void SetScale(uint32_t scale);
+    uint32_t Scale() const;
+    // Scaled modes: the light-map composite reads a filtered light map (smooth shadows; default on). 1x unchanged.
+    void SetSmoothShadows(bool on);
+    // False: no D3D11 compute device; everything would run on the wrapped single-thread CPU backend.
+    bool OnGpu() const { return m_dev != nullptr; }
