diff --git a/ps2xIOP/tests/iop_spu2_tests.cpp b/ps2xIOP/tests/iop_spu2_tests.cpp
new file mode 100644
index 0000000..bf16830
--- /dev/null
+++ b/ps2xIOP/tests/iop_spu2_tests.cpp
@@ -0,0 +1,179 @@
+﻿#include "iop_compat_test_support.h"
+
+#include "emulator/core/iop_memory.h"
+
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+namespace
+{
+    using namespace iop_test;
+    using namespace ps2x::iop::detail;
+
+    constexpr uint32_t kSpu = 0x1F900000u;
+    constexpr uint32_t kCore1 = kSpu + 0x400u;
+
+    std::vector<int16_t> render(IopMemory &memory, uint64_t &cycle, uint32_t samples)
+    {
+        std::vector<int16_t> out;
+        if (cycle == 0u)
+            memory.spu2().render(cycle = 1u, out); // first call only sets the start time
+        cycle += static_cast<uint64_t>(samples) * Spu2::kCyclesPerSample;
+        memory.spu2().render(cycle, out);
+        return out;
+    }
+
+    void setMasterVolumes(IopMemory &memory)
+    {
+        for (uint32_t core = 0u; core < 2u; ++core)
+        {
+            memory.write16(kSpu + 0x760u + core * 0x28u, 0x3FFFu); // MVOL: fixed, full
+            memory.write16(kSpu + 0x762u + core * 0x28u, 0x3FFFu);
+        }
+        memory.write16(kSpu + 0x788u + 8u, 0x7FFFu); // core 1 AVOL: core 0 output at full volume
+        memory.write16(kSpu + 0x788u + 10u, 0x7FFFu);
+        memory.write16(kSpu + 0x198u, 0x0FC0u);   // core 0 MMIX: voices dry+wet, AutoDMA input dry (as the game sets it)
+        memory.write16(kCore1 + 0x198u, 0x0FCCu); // core 1 MMIX: also core 0's output dry
+    }
+
+    void voicePlaysLoopsAndReleases()
+    {
+        IopMemory memory;
+        setMasterVolumes(memory);
+        // One ADPCM block at 0x1000 via manual transfer: shift 0, filter 0, flags end+repeat+loop start,
+        // every nibble 7 -> each sample is 7 << 12 = 28672.
+        memory.write16(kCore1 + 0x1A8u, 0x0000u);
+        memory.write16(kCore1 + 0x1AAu, 0x1000u);
+        memory.write16(kCore1 + 0x1ACu, 0x0700u);
+        for (int i = 0; i < 7; ++i)
+            memory.write16(kCore1 + 0x1ACu, 0x7777u);
+
+        memory.write16(kCore1 + 0x1C0u, 0x0000u); // voice 0 SSA
+        memory.write16(kCore1 + 0x1C2u, 0x1000u);
+        memory.write16(kCore1 + 0x00u, 0x3FFFu);  // VOLL/VOLR fixed, full
+        memory.write16(kCore1 + 0x02u, 0x3FFFu);
+        memory.write16(kCore1 + 0x04u, 0x1000u);  // pitch 1.0
+        memory.write16(kCore1 + 0x06u, 0x000Fu);  // fastest linear attack, sustain level max
+        memory.write16(kCore1 + 0x08u, 0x0000u);  // sustain holds, fastest release
+        memory.write16(kCore1 + 0x188u, 0x0001u); // voice 0 to the dry mix, both sides
+        memory.write16(kCore1 + 0x190u, 0x0001u);
+
+        uint64_t cycle = 0u;
+        memory.write16(kCore1 + 0x1A0u, 0x0001u); // KON voice 0
+        const std::vector<int16_t> on = render(memory, cycle, 64u);
+        require(on.size() == 128u, "64 stereo samples expected");
+        require(on[126] > 27000 && on[127] > 27000, "voice should play the decoded level at full envelope");
+        require(memory.read16(kCore1 + 0x0Au) == 0x7FFFu, "ENVX should read the full envelope");
+        require((memory.read16(kCore1 + 0x340u) & 1u) != 0u, "ENDX should flag the looped end block");
+
+        memory.write16(kCore1 + 0x1A4u, 0x0001u); // KOFF voice 0
+        const std::vector<int16_t> off = render(memory, cycle, 16u);
+        require(off[30] == 0 && off[31] == 0, "release at rate 0 should silence the voice quickly");
+        require(memory.read16(kCore1 + 0x0Au) == 0u, "ENVX should read 0 after the release");
+    }
+
+    void autoDmaInputReachesOutput()
+    {
+        IopMemory memory;
+        setMasterVolumes(memory);
+        memory.write16(kSpu + 0x1B0u, 0x0001u);         // core 0 AutoDMA on
+        memory.write16(kSpu + 0x760u + 12u, 0x7FFFu);   // core 0 BVOL (AutoDMA input) full
+        memory.write16(kSpu + 0x760u + 14u, 0x7FFFu);
+        std::vector<uint8_t> block(0x400u);
+        for (size_t i = 0; i < 256u; ++i)
+        {
+            const int16_t left = 1000, right = -1000;
+            std::memcpy(block.data() + i * 2u, &left, 2u);
+            std::memcpy(block.data() + 0x200u + i * 2u, &right, 2u);
+        }
+        memory.spu2().dma(0, block.data(), block.size(), true);
+        uint64_t cycle = 0u;
+        const std::vector<int16_t> out = render(memory, cycle, 8u);
+        require(std::abs(out[0] - 1000) <= 10 && std::abs(out[1] + 1000) <= 10,
+                "AutoDMA samples should pass core 0 BVOL/MVOL and core 1 AVOL/MVOL at unity gain");
+    }
+
+    void autoDmaRingPlaysOnTheSpu2Clock()
+    {
+        IopMemory memory;
+        setMasterVolumes(memory);
+        memory.write16(kSpu + 0x760u + 12u, 0x7FFFu); // core 0 BVOL full
+        memory.write16(kSpu + 0x760u + 14u, 0x7FFFu);
+        // 12 KB ring at 0x10000 (GHS's movie ring): block n holds the sample value 100 * (n + 1)
+        std::vector<uint8_t> ring(0x3000u);
+        for (size_t i = 0; i < ring.size() / 2u; ++i)
+        {
+            const int16_t value = static_cast<int16_t>(100 * (i / 0x200u + 1u));
+            std::memcpy(ring.data() + i * 2u, &value, 2u);
+        }
+        require(memory.writeRam(0x10000u, ring.data(), ring.size()), "ring write");
+        memory.spu2().autoDmaRing(0, memory.ramData(), 0x10000u, 0x3000u, 0x2C00u); // starts at the last block
+        uint64_t cycle = 0u;
+        std::vector<int16_t> out = render(memory, cycle, 256u);
+        require(std::abs(out[0] - 1200) <= 10, "first block read from the start offset");
+        require(memory.spu2().autoDmaPoll(0) == 0u, "read position wraps to the ring start");
+        out = render(memory, cycle, 256u * 12u);
+        require(std::abs(out[0] - 100) <= 10, "then the ring start");
+        require(std::abs(out[2u * 256u * 10u] - 1100) <= 10, "11 blocks may play without a poll");
+        require(out[2u * 256u * 11u] == 0, "without a poll the core stops one block short of a lap");
+        require(memory.spu2().autoDmaPoll(0) == 0x2C00u, "11 blocks read since the last poll");
+        out = render(memory, cycle, 256u);
+        require(std::abs(out[0] - 1200) <= 10, "a poll lets it continue");
+        memory.spu2().autoDmaRing(0, nullptr, 0u, 0u, 0u);
+        out = render(memory, cycle, 256u * 2u);
+        require(out[2u * 300u] == 0, "a stopped ring plays nothing");
+    }
+
+    void reverbProducesDecayingTail()
+    {
+        IopMemory memory;
+        setMasterVolumes(memory);
+        memory.write16(kCore1 + 0x1B0u, 0x0002u);        // core 1 AutoDMA on
+        memory.write16(kCore1 + 0x198u, 0x0030u);        // MMIX: AutoDMA input wet only
+        memory.write16(kCore1 + 0x19Au, 0x0080u);        // ATTR: effects on
+        memory.write16(kCore1 + 0x2E0u, 0x000Eu);        // ESA 0xE0000, EEA 0xEFFFF
+        memory.write16(kCore1 + 0x2E2u, 0x0000u);
+        memory.write16(kCore1 + 0x33Cu, 0x000Eu);
+        const uint32_t offsets[][2] = {{0x2ECu, 0x400u}, {0x2F0u, 0x500u}, {0x30Cu, 0x600u}, {0x310u, 0x700u},
+                                       {0x2F4u, 0x3F0u}, {0x2F8u, 0x4F0u}, {0x2E4u, 0x40u}, {0x2E8u, 0x20u},
+                                       {0x32Cu, 0x900u}, {0x330u, 0xA00u}, {0x334u, 0xB00u}, {0x338u, 0xC00u}};
+        for (const auto &[reg32, value] : offsets)
+            memory.write16(kCore1 + reg32 + 2u, static_cast<uint16_t>(value));
+        const uint32_t vol = kSpu + 0x788u;
+        const uint16_t coefficients[][2] = {{0x0Cu, 0x7FFFu}, {0x0Eu, 0x7FFFu}, {0x04u, 0x7FFFu}, {0x06u, 0x7FFFu}, // BVOL, EVOL
+                                            {0x14u, 0x6000u}, {0x16u, 0x5000u}, {0x1Eu, 0x4000u}, {0x20u, 0x4000u},
+                                            {0x22u, 0x3000u}, {0x24u, 0x7FFFu}, {0x26u, 0x7FFFu}};
+        for (const auto &[offset, value] : coefficients)
+            memory.write16(vol + offset, value);
+
+        std::vector<uint8_t> block(0x400u);
+        const int16_t impulse = 20000;
+        std::memcpy(block.data(), &impulse, 2u);
+        std::memcpy(block.data() + 0x200u, &impulse, 2u);
+        memory.spu2().dma(1, block.data(), block.size(), true);
+        uint64_t cycle = 0u;
+        const std::vector<int16_t> out = render(memory, cycle, 48000u);
+        auto energy = [&](size_t from, size_t count)
+        {
+            double sum = 0.0;
+            for (size_t i = from * 2u; i < (from + count) * 2u; ++i)
+                sum += static_cast<double>(out[i]) * out[i];
+            return sum;
+        };
+        require(energy(0u, 16u) == 0.0, "the input is wet only, so the first samples carry no dry signal");
+        require(energy(1000u, 4000u) > 0.0, "the delay lines should return the impulse later");
+        require(energy(40000u, 4000u) < energy(1000u, 4000u), "the tail should decay");
+    }
+}
+
+int main()
+{
+    const Test tests[] = {
+        {"SPU2 voice plays, loops and releases", voicePlaysLoopsAndReleases},
+        {"SPU2 AutoDMA input reaches the output", autoDmaInputReachesOutput},
+        {"SPU2 AutoDMA ring plays on the SPU2 clock", autoDmaRingPlaysOnTheSpu2Clock},
+        {"SPU2 reverb returns a decaying tail", reverbProducesDecayingTail},
+    };
+    return run(tests);
+}
