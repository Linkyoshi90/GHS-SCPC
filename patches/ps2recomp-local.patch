diff --git a/ps2xRuntime/src/lib/ps2_thread_placement.cpp b/ps2xRuntime/src/lib/ps2_thread_placement.cpp
new file mode 100644
index 0000000..4e49100
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_thread_placement.cpp
@@ -0,0 +1,59 @@
+// GHS: VU1 (the VIF1 worker) is the one stage that can't be split across threads. Sharing its physical core with a
+// GS band, the GIF worker or the game thread through hyperthreading cost it ~15 % (12.9 -> 11 ns per instruction
+// pair when it had the core alone). So it gets the last physical core to itself and the other busy threads keep off
+// that core. GHS_VU1_CORE=0: no placement. Machines with fewer than 6 cores: no placement either.
+#include <cstdlib>
+#include <thread>
+#include <vector>
+#ifdef _WIN32
+#include <windows.h>
+#endif
+
+namespace
+{
+#ifdef _WIN32
+    // The last physical core's logical processors (all of them on a machine without SMT: one).
+    DWORD_PTR lastCoreMask()
+    {
+        static const DWORD_PTR mask = []() -> DWORD_PTR
+        {
+            if (const char *v = std::getenv("GHS_VU1_CORE"); v && v[0] == '0')
+                return 0;
+            DWORD bytes = 0;
+            GetLogicalProcessorInformation(nullptr, &bytes);
+            std::vector<SYSTEM_LOGICAL_PROCESSOR_INFORMATION> info(bytes / sizeof(SYSTEM_LOGICAL_PROCESSOR_INFORMATION));
+            if (info.empty() || !GetLogicalProcessorInformation(info.data(), &bytes))
+                return 0;
+            DWORD_PTR last = 0;
+            int cores = 0;
+            for (const auto &entry : info)
+                if (entry.Relationship == RelationProcessorCore)
+                {
+                    ++cores;
+                    if (entry.ProcessorMask > last)
+                        last = entry.ProcessorMask;
+                }
+            return cores >= 6 ? last : 0;
+        }();
+        return mask;
+    }
+#endif
+}
+
+// vu1: the calling thread is the VIF1 worker; else another busy thread that should keep off VU1's core.
+void ghsPlaceThread(bool vu1)
+{
+#ifdef _WIN32
+    const DWORD_PTR core = lastCoreMask();
+    if (core == 0)
+        return;
+    DWORD_PTR process = 0, system = 0;
+    if (!GetProcessAffinityMask(GetCurrentProcess(), &process, &system))
+        return;
+    const DWORD_PTR mask = vu1 ? (core & (~core + 1)) : (process & ~core); // VU1: the core's first logical processor
+    if (mask != 0)
+        SetThreadAffinityMask(GetCurrentThread(), mask);
+#else
+    (void)vu1;
+#endif
+}
