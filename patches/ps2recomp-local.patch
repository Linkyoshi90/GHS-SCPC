+GSTransferSnapshot GSGpuBackend::GetTransferSnapshot() const
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    return m_transferOnGpu ? m_transferState : m_cpu.GetTransferSnapshot();
+}
+
+bool GSGpuBackend::SelfTest(uint32_t seed, int ops)
+{
+    std::mt19937 rng(seed);
+    const auto rnd = [&](uint32_t n) { return static_cast<uint32_t>(rng() % n); };
+    std::vector<uint8_t> cpuVram(kVramBytes), gpuVram;
+    for (uint8_t &b : cpuVram)
+        b = static_cast<uint8_t>(rng());
+    gpuVram = cpuVram;
+    void gsDisableRowParallelismOnThisThread(); // gs_cpu_backend.cpp: big triangles in row bands on other threads race where pixels alias
+    gsDisableRowParallelismOnThisThread();
+    GSCpuBackend cpu;
+    GSGpuBackend gpu;
+    if (!gpu.m_dev)
+        return false;
+    cpu.Initialize(cpuVram.data(), kVramBytes);
+    gpu.Initialize(gpuVram.data(), kVramBytes);
+    static const uint8_t psms[] = {GS_PSM_CT32, GS_PSM_CT24, GS_PSM_CT16, GS_PSM_CT16S, GS_PSM_T8, GS_PSM_T4, GS_PSM_T8H,
+                                   GS_PSM_T4HL, GS_PSM_T4HH, GS_PSM_Z32, GS_PSM_Z24, GS_PSM_Z16, GS_PSM_Z16S};
+    static const uint8_t frames[] = {GS_PSM_CT32, GS_PSM_CT24, GS_PSM_CT16, GS_PSM_CT16S};
+    static const uint8_t zbufs[] = {GS_PSM_Z32, GS_PSM_Z24, GS_PSM_Z16, GS_PSM_Z16S};
+    std::string pending; // ops since the last comparison
+    decltype(GSContext::frame) lastFrame{};
+    decltype(GSContext::zbuf) lastZbuf{};
+    for (int op = 0; op < ops; ++op)
+    {
+        char what[2048];
+        const uint32_t kind = rnd(5);
+        if (kind <= 1u) // transfer: host->local in random chunks, or local->local
+        {
+            GSTransferCommand c{};
+            c.direction = kind == 0u ? 0u : 2u;
+            c.bitbltbuf.spsm = psms[rnd(13)];
+            c.bitbltbuf.sbp = rnd(8192);
+            c.bitbltbuf.sbw = static_cast<uint8_t>(1u + rnd(10));
+            c.bitbltbuf.dpsm = psms[rnd(13)];
+            c.bitbltbuf.dbp = (kind == 0u ? 0u : 8192u) + rnd(8192);
+            c.bitbltbuf.dbw = static_cast<uint8_t>(1u + rnd(10));
+            c.trxpos.ssax = static_cast<uint16_t>(rnd(300));
+            c.trxpos.ssay = static_cast<uint16_t>(rnd(300));
+            c.trxpos.dsax = static_cast<uint16_t>(rnd(300));
+            c.trxpos.dsay = static_cast<uint16_t>(rnd(300));
+            c.trxpos.dir = static_cast<uint8_t>(rnd(4));
+            c.trxreg.rrw = static_cast<uint16_t>(1u + rnd(80));
+            c.trxreg.rrh = static_cast<uint16_t>(1u + rnd(40));
+            if (rnd(4) != 0u) // mostly destinations wide enough for the rectangle (else it stays on the CPU)
+                c.bitbltbuf.dbw = static_cast<uint8_t>(std::max<uint32_t>(c.bitbltbuf.dbw, ((c.trxpos.dsax + c.trxreg.rrw + 127u) / 128u) * 2u));
+            cpu.BeginTransfer(c);
+            gpu.BeginTransfer(c);
+            uint32_t bytes = 0;
+            if (kind == 0u)
+            {
+                bytes = c.trxreg.rrw * c.trxreg.rrh * GSMem::BitsPerPixel(static_cast<GSMem::PixelStorageMode>(c.bitbltbuf.dpsm)) / 8u + rnd(8);
+                std::vector<uint8_t> data(bytes);
+                for (uint8_t &b : data)
+                    b = static_cast<uint8_t>(rng());
+                for (uint32_t pos = 0; pos < bytes;)
+                {
+                    const uint32_t n = std::min(bytes - pos, 1u + rnd(bytes));
+                    cpu.UploadImage(data.data() + pos, n);
+                    gpu.UploadImage(data.data() + pos, n);
+                    pos += n;
+                }
+            }
+            std::snprintf(what, sizeof(what), "%s spsm %x sbp %x sbw %u dpsm %x dbp %x dbw %u %ux%u from %u,%u to %u,%u dir %u, %u bytes",
+                          kind == 0u ? "upload" : "local copy", c.bitbltbuf.spsm, c.bitbltbuf.sbp, c.bitbltbuf.sbw, c.bitbltbuf.dpsm, c.bitbltbuf.dbp,
+                          c.bitbltbuf.dbw, c.trxreg.rrw, c.trxreg.rrh, c.trxpos.ssax, c.trxpos.ssay, c.trxpos.dsax, c.trxpos.dsay, c.trxpos.dir, bytes);
+        }
+        else if (kind == 4u) // CLUT load (CLD rules, CSM1/CSM2, every CLUT format, some invalid)
+        {
+            static const uint8_t clutPsms[] = {GS_PSM_T8, GS_PSM_T8H, GS_PSM_T4, GS_PSM_T4HL, GS_PSM_T4HH, GS_PSM_CT32};
+            GSTex0Reg t{};
+            t.psm = clutPsms[rnd(6)];
+            t.cpsm = rnd(8) == 0u ? GS_PSM_T8 : frames[rnd(4)];
+            t.csm = static_cast<uint8_t>(rnd(2));
+            t.csa = static_cast<uint8_t>(rnd(32));
+            t.cbp = (rnd(6) == 0u ? rnd(200) : 400u + rnd(40)) * 32u + rnd(32); // sometimes a palette the draws write (run hazards)
+            t.cld = static_cast<uint8_t>(rnd(8));
+            GSTexClutReg c{};
+            c.cbw = static_cast<uint8_t>(rnd(4) != 0u ? 1u + rnd(10) : 0u);
+            c.cou = static_cast<uint8_t>(rnd(16));
+            c.cov = static_cast<uint16_t>(rnd(512));
+            cpu.LoadClut(t, c);
+            gpu.LoadClut(t, c);
+            std::snprintf(what, sizeof(what), "CLUT load psm %x cpsm %x csm %u csa %u cbp %x cld %u cbw %u cou %u cov %u", t.psm, t.cpsm, t.csm, t.csa, t.cbp,
+                          t.cld, c.cbw, c.cou, c.cov);
+        }
+        else // sprite or triangle with random pixel state, often textured
+        {
+            GSPrimitiveBatch b{};
+            GSDrawState &st = b.state;
+            GSContext &ctx = st.context;
+            const bool sprite = rnd(3) == 0u;
+            const uint32_t lineKind = sprite ? 0u : rnd(4); // 1 line (or line strip segment), 2 point, else a triangle
+            st.prim.type = sprite ? GS_PRIM_SPRITE : lineKind == 1u ? (rnd(2) != 0u ? GS_PRIM_LINE : GS_PRIM_LINESTRIP) : lineKind == 2u ? GS_PRIM_POINT : GS_PRIM_TRIANGLE;
+            b.vertexCount = sprite || lineKind == 1u ? 2u : lineKind == 2u ? 1u : 3u;
+            st.prim.iip = rnd(2) != 0u;
+            st.prim.abe = rnd(2) != 0u;
+            st.prim.fge = rnd(2) != 0u;
+            st.pabe = rnd(4) == 0u;
+            ctx.frame.psm = frames[rnd(4)];
+            ctx.frame.fbp = rnd(200);
+            ctx.frame.fbw = 1u + rnd(10);
+            ctx.frame.fbmsk = rnd(4) == 0u ? static_cast<uint32_t>(rng()) : 0u;
+            ctx.zbuf.psm = zbufs[rnd(4)];
+            ctx.zbuf.zbp = 250u + rnd(80);
+            ctx.zbuf.zmask = rnd(3) == 0u;
+            ctx.scissor.x0 = static_cast<uint16_t>(rnd(100));
+            ctx.scissor.x1 = static_cast<uint16_t>(ctx.scissor.x0 + rnd(300));
+            ctx.scissor.y0 = static_cast<uint16_t>(rnd(100));
+            ctx.scissor.y1 = static_cast<uint16_t>(ctx.scissor.y0 + rnd(200));
+            if (rnd(4) != 0u) // mostly frames wide enough for the scissor
+                ctx.frame.fbw = std::max<uint32_t>(ctx.frame.fbw, ctx.scissor.x1 / 64u + 1u);
+            if (rnd(2) != 0u) // often the last draw's frame and Z buffer, like a game's draw lists: long runs of overlapping draws
+            {
+                ctx.frame.psm = lastFrame.psm;
+                ctx.frame.fbp = lastFrame.fbp;
+                ctx.frame.fbw = lastFrame.fbw;
+                ctx.zbuf.psm = lastZbuf.psm;
+                ctx.zbuf.zbp = lastZbuf.zbp;
+            }
+            lastFrame = ctx.frame;
+            lastZbuf = ctx.zbuf;
+            ctx.xyoffset.ofx = static_cast<uint16_t>((1000u + rnd(100)) << 4);
+            ctx.xyoffset.ofy = static_cast<uint16_t>((1000u + rnd(100)) << 4);
+            ctx.test = rnd(2) | (rnd(8) << 1) | (rnd(256) << 4) | (rnd(4) << 12) | (rnd(2) << 14) | (rnd(2) << 15) | (1u << 16) | ((1u + rnd(3)) << 17);
+            ctx.alpha = rnd(256) | (static_cast<uint64_t>(rnd(256)) << 32);
+            ctx.fba = rnd(2);
+            st.fogR = static_cast<uint8_t>(rng());
+            st.fogG = static_cast<uint8_t>(rng());
+            st.fogB = static_cast<uint8_t>(rng());
+            if (sprite && rnd(3) == 0u) // textured, but alpha test NEVER keeps the texture out (DrawSprite's rule)
+            {
+                st.prim.tme = true;
+                ctx.test = (ctx.test & ~0x300Full) | 1u | (rnd(2) << 13);
+            }
+            else if (rnd(3) != 0u) // textured: every texture format, CLUT mode, TEXA, wrap mode and filter
+            {
+                st.prim.tme = true;
+                GSTex0Reg &t = ctx.tex0;
+                t.psm = psms[rnd(13)];
+                t.tbp0 = (rnd(6) == 0u ? rnd(200) : 400u + rnd(40)) * 32u + (rnd(4) == 0u ? rnd(32) : 0u); // sometimes where draws write
+                t.tbw = static_cast<uint8_t>(rnd(8) == 0u ? 0u : 1u + rnd(8));
+                t.tw = static_cast<uint8_t>(rnd(9));
+                t.th = static_cast<uint8_t>(rnd(8));
+                t.tcc = static_cast<uint8_t>(rnd(2));
+                t.tfx = static_cast<uint8_t>(rnd(4));
+                t.cpsm = frames[rnd(4)];
+                t.csm = static_cast<uint8_t>(rnd(2));
+                t.csa = static_cast<uint8_t>(rnd(32));
+                st.textureWidth = static_cast<uint16_t>(1u << t.tw);
+                st.textureHeight = static_cast<uint16_t>(1u << t.th);
+                const auto region = [&](uint32_t size) { return static_cast<uint64_t>(rnd(size * 2u)); };
+                ctx.clamp = rnd(2) != 0u ? rnd(2) | (rnd(2) << 2)
+                                         : rnd(4) | (rnd(4) << 2) | (region(st.textureWidth) << 4) | (region(st.textureWidth) << 14) |
+                                               (region(st.textureHeight) << 24) | (region(st.textureHeight) << 34);
+                st.texa.ta0 = static_cast<uint8_t>(rng());
+                st.texa.aem = rnd(2) != 0u;
+                st.texa.ta1 = static_cast<uint8_t>(rng());
+                st.linearFilter = rnd(2) != 0u;
+                st.prim.fst = rnd(2) != 0u;
+            }
+            if (lineKind == 1u || lineKind == 2u)
+                st.prim.tme = false; // lines/points run on the GPU untextured only
+            const bool bigZ = ctx.zbuf.psm == GS_PSM_Z32 && rnd(2) != 0u;
+            for (uint32_t k = 0; k < b.vertexCount; ++k)
+            {
+                GSVertex &v = b.vertices[k];
+                v.x = static_cast<float>((ctx.xyoffset.ofx >> 4) * 16u + rnd(400u * 16u) - 50u * 16u) / 16.0f;
+                v.y = static_cast<float>((ctx.xyoffset.ofy >> 4) * 16u + rnd(300u * 16u) - 50u * 16u) / 16.0f;
+                v.z = static_cast<double>(bigZ ? static_cast<uint32_t>(rng()) : rnd(1u << 24));
+                v.r = static_cast<uint8_t>(rng());
+                v.g = static_cast<uint8_t>(rng());
+                v.b = static_cast<uint8_t>(rng());
+                v.a = static_cast<uint8_t>(rng());
+                v.fog = static_cast<uint8_t>(rng());
+                v.u = static_cast<uint16_t>(rnd(st.textureWidth * 32u));
+                v.v = static_cast<uint16_t>(rnd(st.textureHeight * 32u));
+                v.s = static_cast<float>(rnd(4001)) / 2000.0f - 0.5f;
+                v.t = static_cast<float>(rnd(4001)) / 2000.0f - 0.5f;
+                v.q = rnd(10) == 0u ? static_cast<float>(rnd(100)) * 1.0e-9f : (0.25f + static_cast<float>(rnd(2000)) / 1000.0f) * (rnd(8) == 0u ? -1.0f : 1.0f);
+            }
+            if (sprite && rnd(6) == 0u) // GHS's light-map composite: CT16S texels 1:1 onto an RGB24 frame, Cd - Cd * As
+            {
+                st.prim.tme = st.prim.fst = st.prim.abe = true;
+                st.prim.fge = st.pabe = false;
+                ctx.frame.psm = GS_PSM_CT24;
+                ctx.frame.fbmsk = 0u;
+                ctx.zbuf.zmask = true;
+                ctx.test = rnd(2) != 0u ? (1u << 16) | (1u << 17) : (rnd(4) << 17); // ZTE with ALWAYS, or ZTE off
+                ctx.alpha = (1u + rnd(2)) | ((1u + rnd(2)) << 2) | (rnd(3) << 4) | ((1u + rnd(2)) << 6) | (static_cast<uint64_t>(rnd(256)) << 32);
