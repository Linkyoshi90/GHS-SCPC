+            used += std::snprintf(what + used, sizeof(what) - used, " fbp %x fbw %u zbp %x scissor %u,%u-%u,%u ofs %u,%u fog %u,%u,%u |",
+                                  ctx.frame.fbp, ctx.frame.fbw, ctx.zbuf.zbp, ctx.scissor.x0, ctx.scissor.y0, ctx.scissor.x1, ctx.scissor.y1,
+                                  ctx.xyoffset.ofx >> 4, ctx.xyoffset.ofy >> 4, st.fogR, st.fogG, st.fogB);
