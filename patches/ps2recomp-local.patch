+            case Sub: out[c] = vs(c) - rhs; break;
+            case MulAdd: out[c] = acc(c) + vs(c) * rhs; break;
+            case MulSub: out[c] = acc(c) - vs(c) * rhs; break;
+            case Mul: out[c] = vs(c) * rhs; break;
+            }
+        }
+        return true;
+    }
