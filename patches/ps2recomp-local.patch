+        desc = {};
+        desc.ByteWidth = kVramBytes;
+        desc.Usage = D3D11_USAGE_STAGING;
+        desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        if (FAILED(hr = d->device->CreateBuffer(&desc, nullptr, &d->staging)))
+            return fail("readback buffer", hr);
+        if (FAILED(hr = d->device->CreateBuffer(&desc, nullptr, &d->checkpoint)))
+            return fail("snapshot buffer", hr);
+
+        desc = {};
+        desc.ByteWidth = kParamWords * 4u;
+        desc.Usage = D3D11_USAGE_DEFAULT;
+        desc.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+        if (FAILED(hr = d->device->CreateBuffer(&desc, nullptr, &d->params)))
+            return fail("parameter buffer", hr);
+
+        static_assert(GSMem::kSwizzleTableWords == 1216, "the shader's g_tables");
+        uint32_t words[GSMem::kSwizzleTableWords];
+        GSMem::CopySwizzleTables(words);
+        const D3D11_SUBRESOURCE_DATA init{words, 0, 0};
+        desc = {};
+        desc.ByteWidth = sizeof(words);
+        desc.Usage = D3D11_USAGE_IMMUTABLE;
+        desc.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+        desc.MiscFlags = D3D11_RESOURCE_MISC_BUFFER_ALLOW_RAW_VIEWS;
+        if (FAILED(hr = d->device->CreateBuffer(&desc, &init, &d->tables)) || FAILED(hr = d->RawView(d->tables.Get(), sizeof(words), &d->tablesSrv)))
+            return fail("swizzle tables", hr);
+
+        // fxc's integer folding is wrong for selects of constants used as masks ((csa & (sixteen ? 0x1F : 0x0F))
+        // became csa & 0x0F at every level; found by SelfTest): the kernels mask inside the select instead
+        // (sixteen ? (csa & 0x1F) : (csa & 0x0F)), and are optimised (O3: hallway replay at 2x 9.9 -> 9.0 ms;
+        // SelfTest seeds 1-16 identical).
+        // The optimised compile takes ~40 s (one kernel; unoptimised ~12 s for all, at every start before): the
+        // optimised bytecode is cached in shader_cache\ next to the game, named by a hash of everything that goes into
+        // it (a damaged file fails CreateComputeShader and is compiled again). Without a cache entry the kernels start
+        // unoptimised (compiled in parallel: a few seconds; same results, slower) and a background thread compiles the
+        // optimised ones, writes the cache and hands them over (FlushRun, between runs).
+        // GHS-TRACE: GHS_GS_FXC_OD=1: unoptimised only. GHS_GS_SHADER_DEFINE=<name>: compiled with that macro defined.
+        static const char *const s_define = std::getenv("GHS_GS_SHADER_DEFINE");
+        static const bool s_unoptimisedOnly = std::getenv("GHS_GS_FXC_OD") != nullptr;
+        const UINT fastFlags = D3DCOMPILE_SKIP_OPTIMIZATION | D3DCOMPILE_IEEE_STRICTNESS;
+        const UINT optFlags = s_unoptimisedOnly ? fastFlags : (D3DCOMPILE_OPTIMIZATION_LEVEL3 | D3DCOMPILE_IEEE_STRICTNESS);
+        const auto compileStart = std::chrono::steady_clock::now();
+        std::vector<KernelJob> jobs;
+        int cached = 0;
+        for (int k = 0; k < kKernelCount; ++k)
+        {
+            ComPtr<ID3DBlob> &code = s_code[k];
+            if (code)
+            {
+                if (FAILED(hr = d->device->CreateComputeShader(code->GetBufferPointer(), code->GetBufferSize(), nullptr, &d->kernels[k])))
+                    return fail("compute shader", hr);
+                continue;
+            }
+            KernelJob job;
+            job.kernel = k;
+            int n = 0;
+            if (k != kDrawScaledShadows)
+                job.defines[n++] = {"NO_LIGHTMAP_FILTERS", "1"};
+            if (s_define)
+                job.defines[n++] = {s_define, "1"};
+            uint64_t key = 1469598103934665603ull;
+            const auto mix = [&key](const char *text)
+            {
+                for (; text && *text; ++text)
+                    key = (key ^ static_cast<uint8_t>(*text)) * 1099511628211ull;
+                key = (key ^ 0xFFu) * 1099511628211ull;
+            };
+            mix(kShader);
+            mix(kEntry[k]);
+            for (int m = 0; m < n; ++m)
+                mix(job.defines[m].Name);
+            mix(std::to_string(optFlags).c_str());
+            std::snprintf(job.cacheName, sizeof(job.cacheName), "shader_cache/gs_%s_%016llx.dxbc", kEntry[k], static_cast<unsigned long long>(key));
+            if (FILE *f = std::fopen(job.cacheName, "rb"))
+            {
+                std::fseek(f, 0, SEEK_END);
+                const long size = std::ftell(f);
+                std::fseek(f, 0, SEEK_SET);
+                const bool ok = size > 0 && SUCCEEDED(D3DCreateBlob(static_cast<SIZE_T>(size), &code)) &&
+                                std::fread(code->GetBufferPointer(), 1, static_cast<size_t>(size), f) == static_cast<size_t>(size) &&
+                                SUCCEEDED(d->device->CreateComputeShader(code->GetBufferPointer(), code->GetBufferSize(), nullptr, &d->kernels[k]));
+                std::fclose(f);
+                if (ok)
+                {
+                    ++cached;
+                    continue;
+                }
+                code.Reset();
+            }
+            jobs.push_back(job);
+        }
+        CompileKernels(jobs, fastFlags);
+        for (KernelJob &job : jobs)
+        {
+            if (FAILED(job.hr))
+            {
+                std::fprintf(stderr, "[GHS-GSGPU] %s: %s\n", kEntry[job.kernel], job.errors ? static_cast<const char *>(job.errors->GetBufferPointer()) : "compile failed");
+                return fail("shader compile", job.hr);
+            }
+            s_code[job.kernel] = job.code;
+            if (FAILED(hr = d->device->CreateComputeShader(job.code->GetBufferPointer(), job.code->GetBufferSize(), nullptr, &d->kernels[job.kernel])))
+                return fail("compute shader", hr);
+        }
+        if (!jobs.empty() || cached != 0)
+            std::fprintf(stderr, "[GHS-GSGPU] kernels ready in %.0f ms (%zu compiled%s, %d from shader_cache)\n",
+                         std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - compileStart).count(), jobs.size(),
+                         jobs.empty() || s_unoptimisedOnly ? "" : " unoptimised, optimised ones follow", cached);
+        if (s_unoptimisedOnly)
+            for (KernelJob &job : jobs)
+                WriteCache(job);
+        else if (!jobs.empty())
+            std::thread([jobs, optFlags]() mutable
+                        {
+                SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_BELOW_NORMAL); // behind the game's threads
+                const auto start = std::chrono::steady_clock::now();
+                CompileKernels(jobs, optFlags);
+                for (KernelJob &job : jobs)
+                    if (SUCCEEDED(job.hr))
+                    {
+                        WriteCache(job);
+                        std::lock_guard<std::mutex> lock(s_optimisedMutex);
+                        s_optimised[job.kernel] = job.code;
+                    }
+                s_optimisedReady = true;
+                std::fprintf(stderr, "[GHS-GSGPU] optimised kernels compiled in %.0f s (shader_cache)\n",
+                             std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count()); })
+                .detach();
+        return d;
+    }
+
+    static std::unique_ptr<Device> fail(const char *what, HRESULT hr)
+    {
+        std::fprintf(stderr, "[GHS-GSGPU] %s failed (0x%08lx): the GS stays on the CPU\n", what, static_cast<unsigned long>(hr));
+        return nullptr;
+    }
+
+    HRESULT RawView(ID3D11Buffer *buffer, uint32_t bytes, ID3D11ShaderResourceView **out)
+    {
+        D3D11_SHADER_RESOURCE_VIEW_DESC srv{};
+        srv.Format = DXGI_FORMAT_R32_TYPELESS;
+        srv.ViewDimension = D3D11_SRV_DIMENSION_BUFFEREX;
+        srv.BufferEx.NumElements = bytes / 4u;
+        srv.BufferEx.Flags = D3D11_BUFFEREX_SRV_FLAG_RAW;
+        return device->CreateShaderResourceView(buffer, &srv, out);
+    }
+
+    bool PutData(const uint8_t *bytes, uint32_t size)
+    {
+        // Whole 32-bit words: a byte box of another size didn't arrive complete (self-test, odd 16-bit chunks).
+        padded.assign(bytes, bytes + size);
+        padded.resize((size + 3u) & ~3u, 0u);
+        return Put(data, dataSrv, dataBytes, padded.data(), static_cast<uint32_t>(padded.size()));
+    }
+
+    bool Put(ComPtr<ID3D11Buffer> &buffer, ComPtr<ID3D11ShaderResourceView> &view, uint32_t &capacity, const void *bytes, uint32_t size)
+    {
+        if (size > capacity)
+        {
+            const uint32_t grown = std::max(capacity * 2u, (size + 65535u) & ~65535u);
+            D3D11_BUFFER_DESC desc{};
+            desc.ByteWidth = grown;
+            desc.Usage = D3D11_USAGE_DEFAULT;
+            desc.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+            desc.MiscFlags = D3D11_RESOURCE_MISC_BUFFER_ALLOW_RAW_VIEWS;
+            buffer.Reset();
+            view.Reset();
+            capacity = 0;
+            if (FAILED(device->CreateBuffer(&desc, nullptr, &buffer)) || FAILED(RawView(buffer.Get(), grown, &view)))
+                return false;
+            capacity = grown;
+        }
+        const D3D11_BOX box{0, 0, 0, size, 1, 1};
+        ctx->UpdateSubresource(buffer.Get(), 0, &box, bytes, 0, 0);
+        return true;
+    }
+
+    // Room for `words` more words of scaled surfaces (the buffer grows, keeping what it holds).
+    bool GrowHires(uint32_t words)
+    {
+        if (hiresUsed + words <= hiresWords)
+            return true;
+        const uint32_t grown = std::max(hiresWords * 2u, hiresUsed + words);
+        D3D11_BUFFER_DESC desc{};
+        desc.ByteWidth = grown * 4u;
+        desc.Usage = D3D11_USAGE_DEFAULT;
+        desc.BindFlags = D3D11_BIND_UNORDERED_ACCESS;
+        desc.MiscFlags = D3D11_RESOURCE_MISC_BUFFER_ALLOW_RAW_VIEWS;
+        D3D11_UNORDERED_ACCESS_VIEW_DESC uav{};
+        uav.Format = DXGI_FORMAT_R32_TYPELESS;
+        uav.ViewDimension = D3D11_UAV_DIMENSION_BUFFER;
+        uav.Buffer.NumElements = grown;
+        uav.Buffer.Flags = D3D11_BUFFER_UAV_FLAG_RAW;
+        ComPtr<ID3D11Buffer> buffer;
+        ComPtr<ID3D11UnorderedAccessView> view;
+        if (FAILED(device->CreateBuffer(&desc, nullptr, &buffer)) || FAILED(device->CreateUnorderedAccessView(buffer.Get(), &uav, &view)))
+            return false;
+        if (hires && hiresUsed != 0u)
+        {
+            const D3D11_BOX box{0, 0, 0, hiresUsed * 4u, 1, 1};
+            ctx->CopySubresourceRegion(buffer.Get(), 0, 0, 0, 0, hires.Get(), 0, &box);
+        }
+        hires = buffer;
+        hiresUav = view;
+        hiresWords = grown;
+        return true;
+    }
+
+    // A CLUT buffer of `versions` 512-entry CLUTs; the current one moves to version 0.
+    HRESULT GrowCluts(uint32_t versions)
+    {
+        D3D11_BUFFER_DESC desc{};
+        desc.ByteWidth = versions * 2048u;
+        desc.Usage = D3D11_USAGE_DEFAULT;
+        desc.BindFlags = D3D11_BIND_UNORDERED_ACCESS;
+        desc.MiscFlags = D3D11_RESOURCE_MISC_BUFFER_ALLOW_RAW_VIEWS;
+        ComPtr<ID3D11Buffer> grown;
+        ComPtr<ID3D11UnorderedAccessView> view;
+        D3D11_UNORDERED_ACCESS_VIEW_DESC uav{};
+        uav.Format = DXGI_FORMAT_R32_TYPELESS;
+        uav.ViewDimension = D3D11_UAV_DIMENSION_BUFFER;
+        uav.Buffer.NumElements = versions * 512u;
+        uav.Buffer.Flags = D3D11_BUFFER_UAV_FLAG_RAW;
+        HRESULT hr = device->CreateBuffer(&desc, nullptr, &grown);
+        if (SUCCEEDED(hr))
+            hr = device->CreateUnorderedAccessView(grown.Get(), &uav, &view);
+        if (FAILED(hr))
+            return hr;
+        if (clut)
+        {
+            const D3D11_BOX box{clutVersion * 2048u, 0, 0, clutVersion * 2048u + 2048u, 1, 1};
+            ctx->CopySubresourceRegion(grown.Get(), 0, 0, 0, 0, clut.Get(), 0, &box);
+        }
+        else
+        {
+            static const uint32_t zeros[512] = {};
+            const D3D11_BOX box{0, 0, 0, 2048u, 1, 1};
+            ctx->UpdateSubresource(grown.Get(), 0, &box, zeros, 0, 0);
+        }
+        clut = grown;
+        clutUav = view;
+        clutVersions = versions;
+        clutVersion = 0;
+        return S_OK;
+    }
+};
+
+GSGpuBackend::GSGpuBackend()
+    : m_dev(Device::Create()), m_run(std::make_unique<Run>())
+{
+    if (m_dev)
+        std::fprintf(stderr, "[GHS-GSGPU] D3D11 compute backend ready (uploads, local copies, CLUT loads, sprites and triangles on the GPU)\n");
+    if (const char *smooth = std::getenv("GHS_GS_SMOOTH_SHADOWS")) // 0: off (the F2 setting replaces it in the game)
+        m_smoothShadows = smooth[0] != '0';
+    if (const char *scale = std::getenv("GHS_GS_SCALE"))
+        SetScale(static_cast<uint32_t>(std::max(std::atoi(scale), 1)));
+    if (m_dev)
+    {
+        GSGpuBackend *none = nullptr;
+        g_liveGpu.compare_exchange_strong(none, this); // the game's (the first one): the settings window's
+        g_lastGpu = this;
+    }
+}
+
+// GHS-TRACE: FNV-1a of the scaled surfaces of the newest GPU backend (a replay's), to compare builds at 2x/3x
+// (gs_threaded_backend.cpp prints it after a replay). 0 = none.
+uint64_t ghsGpuHiresHash()
+{
+    GSGpuBackend *gpu = g_lastGpu.load();
+    return gpu ? gpu->HiresHash() : 0u;
+}
+
+uint64_t GSGpuBackend::HiresHash() const
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!m_dev || !m_dev->hires || m_dev->hiresUsed == 0u)
+        return 0u;
+    FlushRun();
+    D3D11_BUFFER_DESC desc{};
+    desc.ByteWidth = m_dev->hiresUsed * 4u;
+    desc.Usage = D3D11_USAGE_STAGING;
+    desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    ComPtr<ID3D11Buffer> staging;
+    if (FAILED(m_dev->device->CreateBuffer(&desc, nullptr, &staging)))
+        return 0u;
+    const D3D11_BOX box{0, 0, 0, desc.ByteWidth, 1, 1};
+    m_dev->ctx->CopySubresourceRegion(staging.Get(), 0, 0, 0, 0, m_dev->hires.Get(), 0, &box);
+    D3D11_MAPPED_SUBRESOURCE mapped{};
+    if (FAILED(m_dev->ctx->Map(staging.Get(), 0, D3D11_MAP_READ, 0, &mapped)))
+        return 0u;
+    uint64_t h = 1469598103934665603ull;
+    const uint8_t *bytes = static_cast<const uint8_t *>(mapped.pData);
+    for (uint32_t i = 0; i < desc.ByteWidth; ++i)
+        h = (h ^ bytes[i]) * 1099511628211ull;
+    m_dev->ctx->Unmap(staging.Get(), 0);
+    return h;
+}
+
+void GSGpuBackend::SetSmoothShadows(bool on)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_smoothShadows = on;
+    if (m_scaling)
+    {
+        FlushRun(); // the pending scaled draws keep the setting they were recorded with
+        m_scaling->smoothShadows = on;
+    }
+}
+
+// The settings window (ps2_debug_panel.cpp).
+void ghsGsSetSmoothShadows(bool on)
+{
+    if (GSGpuBackend *gpu = g_liveGpu.load())
+        gpu->SetSmoothShadows(on);
+}
+
+void GSGpuBackend::SetScale(uint32_t scale)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    SetScaleLocked(scale);
+}
+
+void GSGpuBackend::SetScaleLocked(uint32_t scale)
+{
+    scale = std::clamp(scale, 1u, 4u);
+    if (m_lost)
+        m_lostScale = scale; // for the next device
+    if (!m_dev || scale == (m_scaling ? m_scaling->scale : 1u))
+        return;
+    FlushRun(); // the pending scaled draws belong to the old surfaces
+    m_scaling.reset();
+    m_dev->hires.Reset();
+    m_dev->hiresUav.Reset();
+    m_dev->hiresWords = m_dev->hiresUsed = 0u;
+    if (scale >= 2u)
+    {
+        m_scaling = std::make_unique<Scaling>();
+        m_scaling->scale = scale;
+        m_scaling->invScale = 1.0f / static_cast<float>(scale);
+        m_scaling->smoothShadows = m_smoothShadows;
+        if (const char *pages = std::getenv("GHS_GS_SCALE_FBP")) // e.g. "0,50" (hex): scale these frame buffers from the start
+            for (const char *s = pages; *s;)
+            {
+                char *end = nullptr;
+                m_scaling->benchPages.push_back(static_cast<uint32_t>(std::strtoul(s, &end, 16)));
+                s = (end && *end == ',') ? end + 1 : (end && end != s ? end : s + std::strlen(s));
+            }
+    }
+    std::fprintf(stderr, "[GHS-GSGPU] resolution scale %ux%s\n", scale, scale >= 2u ? " (display buffers and their Z buffers)" : "");
+}
+
+uint32_t GSGpuBackend::Scale() const
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    return m_scaling ? m_scaling->scale : 1u;
+}
+
+// The settings window (ps2_debug_panel.cpp): the game's GPU backend's scale; 0 = the GS isn't on the GPU.
+int ghsGsScale()
+{
+    GSGpuBackend *gpu = g_liveGpu.load();
+    return gpu ? static_cast<int>(gpu->Scale()) : 0;
+}
+
+void ghsGsSetScale(int scale)
+{
+    if (GSGpuBackend *gpu = g_liveGpu.load())
+        gpu->SetScale(static_cast<uint32_t>(std::max(scale, 1)));
+}
+
+GSGpuBackend::~GSGpuBackend()
+{
+    GSGpuBackend *self = this;
+    g_liveGpu.compare_exchange_strong(self, nullptr);
+    self = this;
+    g_lastGpu.compare_exchange_strong(self, nullptr);
+}
+
+void GSGpuBackend::Initialize(uint8_t *vram, uint32_t vramSize)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_cpu.Initialize(vram, vramSize);
+    m_vram = vram;
+    m_vramSize = vramSize;
+    m_run->clear();
+    m_gpuNewer = false;
+    m_cpuNewer = true;
+    m_checkpointSeq = 0;
+    ResetClut();
+    MarkScaledStale(Run::range(0u, kPages));
+}
+
+void GSGpuBackend::Reset()
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_cpu.Reset(); // the caller may have rewritten VRAM (a replay pass): the CPU array is the newest
+    m_run->clear(); // like the GPU's VRAM, dropped
+    if (m_scaling)
+        m_scaling->boxes.clear();
+    MarkScaledStale(Run::range(0u, kPages));
+    m_gpuNewer = false;
+    m_cpuNewer = true;
+    m_checkpointSeq = 0;
+    m_transferOnGpu = false;
+    m_transfer = {};
+    m_transfer.direction = 3u;
+    m_transferState = {};
+    m_transferState.direction = 3u;
+    ResetClut();
+}
+
+void GSGpuBackend::NeedCpu() const
+{
+    FlushRun();
+    if (!m_gpuNewer)
+        return;
+    m_gpuNewer = false;
+    ++m_downloads;
+    m_dev->ctx->CopyResource(m_dev->staging.Get(), m_dev->vram.Get());
+    D3D11_MAPPED_SUBRESOURCE mapped{};
+    if (SUCCEEDED(m_dev->ctx->Map(m_dev->staging.Get(), 0, D3D11_MAP_READ, 0, &mapped)))
+    {
+        std::memcpy(m_vram, mapped.pData, std::min(m_vramSize, kVramBytes));
+        m_vramSyncedSeq = ++m_vramSeq;
+        m_dev->ctx->Unmap(m_dev->staging.Get(), 0);
+    }
+    else
+    {
+        std::fprintf(stderr, "[GHS-GSGPU] VRAM readback failed\n");
+        m_deviceTrouble = "VRAM readback failed";
+    }
+    // The CPU backend's decoded-texel caches may hold texels the GPU has overwritten.
+    m_cpu.TextureFlush();
+    m_cpu.InvalidateTextureRange(0u, UINT32_MAX);
+}
+
+void GSGpuBackend::NeedGpu()
+{
+    if (!m_cpuNewer)
+        return;
+    m_cpuNewer = false;
+    ++m_uploadsFull;
+    m_dev->ctx->UpdateSubresource(m_dev->vram.Get(), 0, nullptr, m_vram, 0, 0);
+    m_vramSyncedSeq = ++m_vramSeq;
+}
+
+void GSGpuBackend::Dispatch(int kernel, const uint32_t *params, uint32_t groupsX, uint32_t groupsY) const
+{
+    ID3D11DeviceContext *ctx = m_dev->ctx.Get();
+    ctx->UpdateSubresource(m_dev->params.Get(), 0, nullptr, params, 0, 0);
+    ctx->CSSetShader(m_dev->kernels[kernel].Get(), nullptr, 0);
+    ID3D11Buffer *cb = m_dev->params.Get();
+    ctx->CSSetConstantBuffers(0, 1, &cb);
+    ID3D11UnorderedAccessView *uavs[3] = {m_dev->vramUav.Get(), m_dev->clutUav.Get(), m_dev->hiresUav.Get()};
+    ctx->CSSetUnorderedAccessViews(0, 3, uavs, nullptr);
+    ID3D11ShaderResourceView *srvs[3] = {m_dev->dataSrv.Get(), m_dev->tablesSrv.Get(), m_dev->batchSrv.Get()};
+    ctx->CSSetShaderResources(0, 3, srvs);
+    ctx->Dispatch(groupsX, groupsY, 1);
+    if (kernel != kClut && kernel != kClutCarry && kernel != kDrawScaled && kernel != kDrawScaledShadows && kernel != kExpand) // GPU-only state: VRAM unchanged
+        m_gpuNewer = true;
+}
+
+// The run as two dispatches: its CLUT loads (every version), then its draws, binned into 16x16 tiles.
+void GSGpuBackend::FlushRun() const
+{
+    Run &r = *m_run;
+    if (!m_dev)
+        return;
+    if (s_optimisedReady.load(std::memory_order_acquire)) // the background compile's kernels (Device::Create)
+    {
+        std::lock_guard<std::mutex> lock(s_optimisedMutex);
+        s_optimisedReady = false;
+        for (int k = 0; k < kKernelCount; ++k)
+        {
+            ComPtr<ID3D11ComputeShader> kernel;
+            if (s_optimised[k] && SUCCEEDED(m_dev->device->CreateComputeShader(s_optimised[k]->GetBufferPointer(), s_optimised[k]->GetBufferSize(), nullptr, &kernel)))
+            {
+                m_dev->kernels[k] = kernel;
+                s_code[k] = s_optimised[k];
+            }
+            s_optimised[k].Reset();
+        }
+    }
+    if (r.boxes.empty())
+    {
+        FlushCluts(); // CLUT loads without draws: the CLUT after them is the current one
+        r.clear();
+        ExpandScaled(); // stale pages from work outside runs (uploads, the CPU)
+        return;
+    }
+    Device &d = *m_dev;
+    if (g_timing)
+        g_timing->Add(d.device.Get(), d.ctx.Get());
+    FlushCluts();
+    if (g_timing)
+        g_timing->Add(d.device.Get(), d.ctx.Get());
+    const uint32_t loads = r.loadsDone, first = loads != 0u ? r.clutFirst : d.clutVersion; // the CLUT of the run's first draw
+    // Bins: per 16x16 tile (coordinates are below 2048) its draws in submission order. Tile order is free.
+    if (r.tileCount.empty())
+        r.tileCount.assign(128u * 128u, 0u);
+    r.tiles.clear();
+    uint32_t bins = 0;
+    for (const Run::Box &b : r.boxes)
+        for (int ty = b.y0 >> 4; ty <= (b.y1 >> 4); ++ty)
+            for (int tx = b.x0 >> 4; tx <= (b.x1 >> 4); ++tx)
+            {
+                const uint32_t t = static_cast<uint32_t>(ty * 128 + tx);
+                if (r.tileCount[t]++ == 0u)
+                    r.tiles.push_back(t);
+                ++bins;
+            }
+    const uint32_t tiles = static_cast<uint32_t>(r.tiles.size()), tileWord = static_cast<uint32_t>(r.words.size());
+    uint32_t listWord = tileWord + tiles * 4u;
+    r.words.resize(listWord + bins);
+    for (uint32_t k = 0; k < tiles; ++k)
+    {
+        const uint32_t t = r.tiles[k], count = r.tileCount[t];
+        uint32_t *header = r.words.data() + tileWord + k * 4u;
+        header[0] = (t % 128u) * 16u;
+        header[1] = (t / 128u) * 16u;
+        header[2] = listWord;
+        header[3] = count;
+        r.tileCount[t] = listWord; // now the tile's next list position
+        listWord += count;
+    }
+    for (const Run::Box &b : r.boxes)
+        for (int ty = b.y0 >> 4; ty <= (b.y1 >> 4); ++ty)
+            for (int tx = b.x0 >> 4; tx <= (b.x1 >> 4); ++tx)
+                r.words[r.tileCount[static_cast<uint32_t>(ty * 128 + tx)]++] = b.record;
+    for (const uint32_t t : r.tiles)
+        r.tileCount[t] = 0u;
+    // The same for the scaled draws, in tiles of 16x16 samples.
+    Scaling *sc = m_scaling.get();
+    uint32_t scaledTiles = 0u, scaledTileWord = 0u;
+    if (sc && !sc->boxes.empty())
+    {
+        const uint32_t grid = 128u * sc->scale;
+        if (sc->tileCount.size() != grid * grid)
+            sc->tileCount.assign(grid * grid, 0u);
+        sc->tiles.clear();
+        uint32_t scaledBins = 0;
+        for (const Run::Box &b : sc->boxes)
+            for (int ty = b.y0 >> 4; ty <= (b.y1 >> 4); ++ty)
+                for (int tx = b.x0 >> 4; tx <= (b.x1 >> 4); ++tx)
+                {
+                    const uint32_t t = static_cast<uint32_t>(ty) * grid + static_cast<uint32_t>(tx);
+                    if (sc->tileCount[t]++ == 0u)
+                        sc->tiles.push_back(t);
+                    ++scaledBins;
+                }
+        scaledTiles = static_cast<uint32_t>(sc->tiles.size());
+        scaledTileWord = static_cast<uint32_t>(r.words.size());
+        uint32_t list = scaledTileWord + scaledTiles * 4u;
+        r.words.resize(list + scaledBins);
+        for (uint32_t k = 0; k < scaledTiles; ++k)
+        {
+            const uint32_t t = sc->tiles[k], count = sc->tileCount[t];
+            uint32_t *header = r.words.data() + scaledTileWord + k * 4u;
+            header[0] = (t % grid) * 16u;
+            header[1] = (t / grid) * 16u;
+            header[2] = list;
+            header[3] = count;
+            sc->tileCount[t] = list;
+            list += count;
+        }
+        for (const Run::Box &b : sc->boxes)
+            for (int ty = b.y0 >> 4; ty <= (b.y1 >> 4); ++ty)
+                for (int tx = b.x0 >> 4; tx <= (b.x1 >> 4); ++tx)
+                    r.words[sc->tileCount[static_cast<uint32_t>(ty) * grid + static_cast<uint32_t>(tx)]++] = b.record;
+        for (const uint32_t t : sc->tiles)
+            sc->tileCount[t] = 0u;
+        sc->scaledDraws += sc->boxes.size();
+    }
+    if (!d.Put(d.batch, d.batchSrv, d.batchBytes, r.words.data(), static_cast<uint32_t>(r.words.size() * 4u)))
+    {
+        std::fprintf(stderr, "[GHS-GSGPU] batch buffer allocation failed\n");
+        m_deviceTrouble = "batch buffer allocation failed";
+    }
+    else
+    {
+        uint32_t p[kParamWords] = {tileWord, first, 0u, 0x3FF00000u}; // 2-3: 1.0 as a double
+        if (tiles != 0u)
+            Dispatch(kDraw, p, tiles, 1u);
+        if (g_timing)
+            g_timing->Add(d.device.Get(), d.ctx.Get());
+        // Scaled surfaces: their stale pages from VRAM (after this run's draws, which were not into them), then
+        // the run's draws into them.
+        ExpandScaled();
+        if (g_timing)
+            g_timing->Add(d.device.Get(), d.ctx.Get());
+        if (scaledTiles != 0u)
+        {
+            p[0] = scaledTileWord;
+            p[4] = sc->scale;
+            p[5] = floatBits(sc->invScale);
+            p[6] = sc->smoothShadows ? 1u : 0u;
+            Dispatch(sc->shadowsInRun ? kDrawScaledShadows : kDrawScaled, p, scaledTiles, 1u);
+        }
+        ++m_runs;
+        d.ctx->Flush(); // to the GPU now, so it draws while the next run is recorded (else at FINISH's readback)
+    }
+    if (g_timing)
+        g_timing->Add(d.device.Get(), d.ctx.Get(), static_cast<uint32_t>(r.boxes.size()), tiles, loads);
+    r.clear();
+    if (sc)
+    {
+        sc->boxes.clear();
+        sc->shadowsInRun = false;
+        for (Scaling::Surface &s : sc->surfaces)
+            s.mirroredInRun = s.staleInRun = false;
+    }
+}
+
+// The pending run's CLUT loads not dispatched yet, as CSClut + CSClutCarry into the versions after the run's
+// earlier ones; its draws stay pending and read them later. So an upload that overwrites a palette between
+// CLUT loads (the hallway streams them: 28 of its 34 runs a frame ended there) doesn't split the run.
+void GSGpuBackend::FlushCluts() const
+{
+    Run &r = *m_run;
+    const uint32_t loads = static_cast<uint32_t>(r.loads.size() / kClutLoadWords);
+    if (!m_dev || loads == 0u)
+        return;
+    Device &d = *m_dev;
+    if (r.loadsDone == 0u)
+    {
+        // Room for 2 * loads + 2 versions: then the versions written never include the current one, which
+        // CSClutCarry reads after CSClut wrote them (from 0 again only when the current one is past loads).
+        // Later dispatches of the run carry from the run's own versions; LoadClut keeps them inside the buffer.
+        if (2u * loads + 2u > d.clutVersions && FAILED(d.GrowCluts(std::max(2u * loads + 2u, d.clutVersions * 2u))))
+            std::fprintf(stderr, "[GHS-GSGPU] CLUT buffer allocation failed\n");
+        // After the current version, or from 0 again.
+        r.clutFirst = d.clutVersion + 1u + loads < d.clutVersions ? d.clutVersion + 1u : 0u;
+    }
+    if (!d.Put(d.batch, d.batchSrv, d.batchBytes, r.loads.data(), static_cast<uint32_t>(r.loads.size() * 4u)))
+    {
+        std::fprintf(stderr, "[GHS-GSGPU] batch buffer allocation failed\n");
+        m_deviceTrouble = "batch buffer allocation failed";
+    }
+    else
+    {
+        const uint32_t p[kParamWords] = {0u, loads, r.loadsDone == 0u ? d.clutVersion : r.clutFirst + r.loadsDone, r.clutFirst + r.loadsDone};
+        Dispatch(kClut, p, std::min(loads, 65535u), (loads + 65534u) / 65535u);
+        Dispatch(kClutCarry, p, 8u, 1u);
+    }
+    r.loadsDone += loads;
+    d.clutVersion = r.clutFirst + r.loadsDone;
+    r.loads.clear();
+    r.clutRead.reset();
+}
+
+// Before a write dispatched ahead of the pending run (an upload, a local copy): the whole run if its draws use or
+// read the pages, else only its CLUT loads if they read them.
+void GSGpuBackend::FlushBefore(const std::bitset<512> &written) const
+{
+    const Run &r = *m_run;
+    if (((r.used | r.texRead | r.texReadTop) & written).any())
+        FlushRun();
+    else if ((r.clutRead & written).any())
+        FlushCluts();
+}
+
+// Pages written outside the scaled draws: stale in every scaled surface there, filled from VRAM again.
+void GSGpuBackend::MarkScaledStale(const std::bitset<512> &written) const
+{
+    if (!m_scaling)
+        return;
+    for (Scaling::Surface &s : m_scaling->surfaces)
+        if ((s.pages & written).any())
+        {
+            s.stale |= s.pages & written;
+            s.staleInRun = true;
+        }
+}
+
+void GSGpuBackend::ExpandScaled() const
+{
+    if (!m_scaling || !m_dev)
+        return;
+    for (Scaling::Surface &s : m_scaling->surfaces)
+    {
+        if (!s.stale.any())
+            continue;
+        uint32_t p[kParamWords] = {s.offset, s.pitch, m_scaling->scale, s.psm, s.page * 32u, s.fbw};
+        for (uint32_t page = 0; page < kPages; ++page)
+            if (s.stale[page])
+                p[6u + page / 32u] |= 1u << (page % 32u);
+        Dispatch(kExpand, p, s.fbw * 64u / 16u, kScaledRows / 16u);
+        s.stale.reset();
+        ++m_scaling->expands;
+    }
+}
+
+// The scaled surface of a buffer, its first `rows` rows in use: rows not in use yet are stale (filled from
+// VRAM before they are drawn). Only those rows' pages count: the display buffer's lower half is the other
+// display buffer, the Z buffer's the light map. Null: not scaled (size, count, memory).
+GSGpuBackend::ScaledTarget *GSGpuBackend::ScaledSurface(uint32_t page, uint32_t fbw, uint8_t psm, bool create, uint32_t rows) const
+{
+    Scaling &sc = *m_scaling;
+    rows = std::min(rows, kScaledRows);
+    const auto grow = [&](ScaledTarget &s)
+    {
+        if (rows <= s.rows)
+            return;
+        s.rows = rows;
+        const uint32_t pageHeight = (psm == GS_PSM_CT16 || psm == GS_PSM_CT16S || psm == GS_PSM_Z16 || psm == GS_PSM_Z16S) ? 64u : 32u;
+        const Run::Pages added = Run::range(page, page + fbw * ((rows + pageHeight - 1u) / pageHeight)) & ~s.pages;
+        s.pages |= added;
+        s.stale |= added;
+        s.staleInRun = true;
+    };
+    if (Scaling::Surface *s = sc.find(page, fbw, psm))
+    {
+        grow(*s);
+        return s;
+    }
+    if (!create || fbw == 0u || fbw > 16u || sc.surfaces.size() >= 8u)
+        return nullptr;
+    const uint32_t pitch = fbw * 64u * sc.scale, words = pitch * kScaledRows * sc.scale;
+    if (!m_dev->GrowHires(words))
+    {
+        std::fprintf(stderr, "[GHS-GSGPU] scaled surface allocation failed (%u MB)\n", words / 262144u);
+        return nullptr;
+    }
+    Scaling::Surface s{page, fbw, psm, m_dev->hiresUsed, pitch};
+    m_dev->hiresUsed += words;
+    grow(s);
+    sc.surfaces.push_back(s);
+    std::fprintf(stderr, "[GHS-GSGPU] scaled surface fbp 0x%x fbw %u psm 0x%x: %ux%u samples\n", page, fbw, psm, pitch, kScaledRows * sc.scale);
+    return &sc.surfaces.back();
+}
+
+bool GSGpuBackend::DrawOnGpu(const GSPrimitiveBatch &batch)
+{
+    const GSDrawState &state = batch.state;
+    const auto &ctx = state.context;
+    const auto &tex = ctx.tex0;
+    const uint32_t test = static_cast<uint32_t>(ctx.test);
+    const bool sprite = state.prim.type == GS_PRIM_SPRITE;
+    const auto toCpu = [&](int why) // counted per cause (ReportStats)
+    {
+        ++m_cpuWhy[why];
+        m_cpuWhyLast[why][0] = state.prim.type | (state.prim.tme ? 0x10u : 0u) | (static_cast<uint32_t>(test) << 8 & 0xFFFF00u);
+        m_cpuWhyLast[why][1] = ctx.frame.fbp | (static_cast<uint32_t>(ctx.frame.fbw) << 12) | (static_cast<uint32_t>(ctx.frame.psm) << 20);
+        m_cpuWhyLast[why][2] = ctx.zbuf.zbp | (static_cast<uint32_t>(ctx.zbuf.psm) << 12) | (ctx.zbuf.zmask ? 1u << 20 : 0u);
+        m_cpuWhyLast[why][3] = tex.tbp0 | (static_cast<uint32_t>(tex.tbw) << 14) | (static_cast<uint32_t>(tex.psm) << 20);
+        return false;
+    };
+    // Untextured lines and points: their pixels (DrawLine's / the point case's, with their colour, Z and fog
+    // expressions, in their order) as 1x1 sprites through the sprite path below, which applies the same WritePixel.
+    // Sent to the CPU they cost a full VRAM round trip a frame (Catherine's circling stars: ~80 line strips a frame).
+    // The one check that depends on the box (buffer width / VRAM wrap) runs on the whole line first, so a line never
+    // goes half to the GPU and half to the CPU; the others depend only on the state, which every pixel shares.
+    if ((state.prim.type == GS_PRIM_LINE || state.prim.type == GS_PRIM_LINESTRIP || state.prim.type == GS_PRIM_POINT) && !state.prim.tme)
+    {
+        const int ofx = ctx.xyoffset.ofx >> 4, ofy = ctx.xyoffset.ofy >> 4;
+        GSPrimitiveBatch px{};
+        px.state = state;
+        px.state.prim.type = GS_PRIM_SPRITE;
+        px.vertexCount = 2;
+        static thread_local std::vector<GSPrimitiveBatch> pixels; // the GIF worker's
+        pixels.clear();
+        const auto add = [&](int x, int y, uint32_t z, uint8_t r, uint8_t g, uint8_t b, uint8_t a, uint8_t fog)
+        {
+            px.vertices[0].x = static_cast<float>(x + ofx);
+            px.vertices[0].y = static_cast<float>(y + ofy);
+            GSVertex &v = px.vertices[1];
+            v.x = static_cast<float>(x + 1 + ofx);
+            v.y = static_cast<float>(y + 1 + ofy);
+            v.z = static_cast<double>(z); // the sprite path's static_cast<uint32_t> gives z back
+            v.r = r, v.g = g, v.b = b, v.a = a, v.fog = fog;
+            pixels.push_back(px);
+        };
+        const GSVertex &v0 = batch.vertices[0];
+        if (state.prim.type == GS_PRIM_POINT)
+            add(static_cast<int>(v0.x) - ofx, static_cast<int>(v0.y) - ofy, static_cast<uint32_t>(v0.z), v0.r, v0.g, v0.b, v0.a, v0.fog);
+        else
+        {
+            // GSCpuBackend::DrawLine
+            const GSVertex &v1 = batch.vertices[1];
+            int x0 = static_cast<int>(v0.x) - ofx, y0 = static_cast<int>(v0.y) - ofy;
+            const int x1 = static_cast<int>(v1.x) - ofx, y1 = static_cast<int>(v1.y) - ofy;
+            const int dx = std::abs(x1 - x0), dy = -std::abs(y1 - y0), sx = (x0 < x1) ? 1 : -1, sy = (y0 < y1) ? 1 : -1;
+            int err = dx + dy;
+            int totalSteps = std::max(std::abs(x1 - x0), std::abs(y1 - y0));
+            if (totalSteps == 0)
+                totalSteps = 1;
+            for (int step = 0;; ++step)
+            {
+                const float t = static_cast<float>(step) / static_cast<float>(totalSteps);
+                uint8_t r = v1.r, g = v1.g, b = v1.b, a = v1.a;
+                if (state.prim.iip)
+                {
+                    r = GSInternal::clampU8(static_cast<int>(v0.r + (v1.r - v0.r) * t));
+                    g = GSInternal::clampU8(static_cast<int>(v0.g + (v1.g - v0.g) * t));
+                    b = GSInternal::clampU8(static_cast<int>(v0.b + (v1.b - v0.b) * t));
+                    a = GSInternal::clampU8(static_cast<int>(v0.a + (v1.a - v0.a) * t));
+                }
+                const double z = (v0.z + (v1.z - v0.z) * t);
+                const uint8_t fog = GSInternal::clampU8(static_cast<int>(v0.fog + (v1.fog - v0.fog) * t));
+                add(x0, y0, static_cast<uint32_t>(z), r, g, b, a, fog);
+                if (x0 == x1 && y0 == y1)
+                    break;
+                const int e2 = 2 * err;
+                if (e2 >= dy)
+                {
+                    err += dy;
+                    x0 += sx;
+                }
+                if (e2 <= dx)
+                {
+                    err += dx;
+                    y0 += sy;
+                }
+            }
+        }
+        // The box check of the sprite path (below) for the line's box clipped to the scissor.
+        int bx1 = -1, by1 = -1;
+        for (const GSPrimitiveBatch &q : pixels)
+        {
+            const int x = static_cast<int>(q.vertices[0].x) - ofx, y = static_cast<int>(q.vertices[0].y) - ofy;
+            if (x >= ctx.scissor.x0 && x <= ctx.scissor.x1 && y >= ctx.scissor.y0 && y <= ctx.scissor.y1)
+                bx1 = std::max(bx1, x), by1 = std::max(by1, y);
+        }
+        if (bx1 < 0)
+            return true; // WritePixel's scissor test fails for every pixel
+        const uint32_t rowPages = std::max<uint32_t>(ctx.frame.fbw, 1u), pageRowsEnd = (static_cast<uint32_t>(by1) + 64u) / 32u * rowPages * 8192u;
+        const uint32_t ztst = (test >> 17) & 3u;
+        if (static_cast<uint32_t>(bx1) >= rowPages * 64u || ctx.frame.fbp * 8192u + pageRowsEnd > kVramBytes ||
+            ((ztst >= 2u || !ctx.zbuf.zmask) && ctx.zbuf.zbp * 8192u + pageRowsEnd > kVramBytes))
+            return toCpu(4);
+        for (size_t k = 0; k < pixels.size(); ++k)
+            if (!DrawOnGpu(pixels[k]) && k == 0u) // a state check: the same for every pixel, so only the first can fail
+                return false;
+        return true;
+    }
+    if (!sprite && (state.prim.type < GS_PRIM_TRIANGLE || state.prim.type > GS_PRIM_TRIFAN))
+        return toCpu(0);
+    bool tme = state.prim.tme;
+    // DrawSprite's rule: alpha test NEVER with AFAIL KEEP or ZB_ONLY draws it untextured.
+    if (sprite && tme && (test & 0xFu) == 0x1u && ((test >> 12) & 3u) != 1u && ((test >> 12) & 3u) != 3u)
+        tme = false;
+    if (!isFrameFormat(ctx.frame.psm))
+        return toCpu(1);
+    static const long s_skipTbp = std::getenv("GHS_GS_SKIP_TBP") ? std::strtol(std::getenv("GHS_GS_SKIP_TBP"), nullptr, 16) : -1; // GHS-TRACE: drop draws sampling it
+    if (tme && static_cast<long>(tex.tbp0) == s_skipTbp)
+        return true;
+    if (ctx.scissor.x0 > ctx.scissor.x1 || ctx.scissor.y0 > ctx.scissor.y1)
+        return true; // WritePixel's scissor test fails everywhere
+    const uint32_t ztst = (test >> 17) & 3u;
+    const uint32_t pagesPerRow = std::max<uint32_t>(ctx.frame.fbw, 1u), pageRows = (static_cast<uint32_t>(ctx.scissor.y1) + 32u) / 32u;
+    const uint32_t fBegin = ctx.frame.fbp * 8192u, fEnd = fBegin + pagesPerRow * pageRows * 8192u;
+    const uint32_t zBegin = ctx.zbuf.zbp * 8192u, zEnd = zBegin + pagesPerRow * pageRows * 8192u;
+    if (ztst >= 2u || !ctx.zbuf.zmask)
+    {
+        // Frame and Z buffer in the same VRAM: one pixel's Z may be another's colour, and the order matters.
+        if (!isZFormat(ctx.zbuf.psm) || (fBegin < zEnd && zBegin < fEnd))
+            return toCpu(2);
+    }
+    const uint8_t wrapU = static_cast<uint8_t>(ctx.clamp & 0x3u), wrapV = static_cast<uint8_t>((ctx.clamp >> 2) & 0x3u);
+    const uint16_t minU = static_cast<uint16_t>((ctx.clamp >> 4) & 0x3FFu), maxU = static_cast<uint16_t>((ctx.clamp >> 14) & 0x3FFu);
+    const uint16_t minV = static_cast<uint16_t>((ctx.clamp >> 24) & 0x3FFu), maxV = static_cast<uint16_t>((ctx.clamp >> 34) & 0x3FFu);
+    const int texW = state.textureWidth, texH = state.textureHeight;
+    uint32_t texBegin = 0u, texEnd = 0u;
+    const bool topByte = isTopByteTexture(tex.psm);
+    if (tme)
+    {
+        // A draw sampling VRAM it writes (DrawPrimitive's writesInto, with its rule for top-byte textures in
+        // CT24/Z24 buffers: those draws never change bits 24-31): the CPU's pixel order decides what is read.
+        texBegin = tex.tbp0 * 256u & ~8191u;
+        const auto reach = [](int size, uint8_t mode, uint32_t mn, uint32_t mx)
+        { return mode == 2u ? std::max<uint32_t>(size, mx + 1u) : mode == 3u ? std::max<uint32_t>(size, (mn | mx) + 1u) : static_cast<uint32_t>(size); };
+        const uint32_t reachU = reach(texW, wrapU, minU, maxU), reachV = reach(texH, wrapV, minV, maxV);
+        texEnd = texBegin + std::max<uint32_t>({tex.tbw, (reachU + 63u) / 64u, 1u}) * ((reachV + 31u) / 32u) * 8192u +
+                 ((tex.tbp0 & 31u) != 0u ? 8192u : 0u);
+        if (texEnd > kVramBytes || (texBegin < fEnd && fBegin < texEnd && !(topByte && ctx.frame.psm == GS_PSM_CT24)) ||
+            (!ctx.zbuf.zmask && texBegin < zEnd && zBegin < texEnd && !(topByte && ctx.zbuf.psm == GS_PSM_Z24)))
+            return toCpu(3);
+    }
+
+    uint32_t p[kParamWords] = {};
+    p[5] = GSInternal::framePageBaseToBlock(ctx.frame.fbp);
+    p[6] = pagesPerRow;
+    p[7] = ctx.frame.psm;
+    p[8] = ctx.frame.fbmsk;
+    p[9] = GSInternal::framePageBaseToBlock(ctx.zbuf.zbp);
+    p[10] = ctx.zbuf.psm;
+    p[11] = ctx.zbuf.zmask ? 1u : 0u;
+    p[12] = test;
+    p[13] = static_cast<uint32_t>(ctx.alpha & 0xFFu);
+    p[14] = static_cast<uint32_t>((ctx.alpha >> 32) & 0xFFu);
+    p[15] = (state.prim.abe ? 1u : 0u) | (state.pabe ? 2u : 0u) | (state.prim.fge ? 4u : 0u) | ((ctx.fba & 1u) ? 8u : 0u) | (state.prim.iip ? 16u : 0u);
+    p[16] = state.fogR | (static_cast<uint32_t>(state.fogG) << 8) | (static_cast<uint32_t>(state.fogB) << 16);
+    bool linear = state.linearFilter, tableMode = false, zSkip = false, lightMapComposite = false, spriteSamples = false;
+    float texelsPerPixel = -1.0f; // a textured draw's texels per PS2 pixel (< 1: magnified), for flag 1024
+    uint32_t lightMapCols = 0u, lightMapRows = 0u; // the composite's texels in use (its scaled surface)
+    if (tme)
+    {
+        p[40] = tex.tbp0;
+        p[41] = tex.tbw;
+        p[42] = tex.psm;
+        p[43] = static_cast<uint32_t>(texW);
+        p[44] = static_cast<uint32_t>(texH);
+        p[45] = tex.cpsm | (static_cast<uint32_t>(tex.csm) << 8) | (static_cast<uint32_t>(tex.csa) << 16);
+        p[46] = wrapU | (static_cast<uint32_t>(wrapV) << 8);
+        p[47] = minU | (static_cast<uint32_t>(maxU) << 16);
+        p[48] = minV | (static_cast<uint32_t>(maxV) << 16);
+        p[49] = state.texa.ta0 | (state.texa.aem ? 0x100u : 0u) | (static_cast<uint32_t>(state.texa.ta1) << 16);
+        p[51] = floatBits(1.0e-8f); // fabsQ
+    }
+    m_aux.clear();
+
+    const int ofx = ctx.xyoffset.ofx >> 4, ofy = ctx.xyoffset.ofy >> 4;
+    int bx0, by0, bx1, by1;
+    if (sprite)
+    {
+        // DrawSprite's rectangle.
+        const GSVertex &v0 = batch.vertices[0], &v1 = batch.vertices[1];
+        int x0 = static_cast<int>(v0.x) - ofx, y0 = static_cast<int>(v0.y) - ofy;
+        int x1 = static_cast<int>(v1.x) - ofx, y1 = static_cast<int>(v1.y) - ofy;
+        if (x0 > x1)
+            std::swap(x0, x1);
+        if (y0 > y1)
+            std::swap(y0, y1);
+        const int spanX = std::max(1, x1 - x0), spanY = std::max(1, y1 - y0);
+        const int ux1 = x0 + spanX - 1, uy1 = y0 + spanY - 1;
+        if (ux1 < ctx.scissor.x0 || x0 > ctx.scissor.x1 || uy1 < ctx.scissor.y0 || y0 > ctx.scissor.y1)
+            return true;
+        bx0 = GSInternal::clampInt(x0, ctx.scissor.x0, ctx.scissor.x1);
+        by0 = GSInternal::clampInt(y0, ctx.scissor.y0, ctx.scissor.y1);
+        bx1 = GSInternal::clampInt(ux1, ctx.scissor.x0, ctx.scissor.x1);
+        by1 = GSInternal::clampInt(uy1, ctx.scissor.y0, ctx.scissor.y1);
+        if (bx1 < bx0 || by1 < by0)
+            return true;
+        p[0] = 0u;
+        p[17] = static_cast<uint32_t>(v1.z);
+        p[18] = pack32(v1.r, v1.g, v1.b, v1.a);
+        p[19] = v1.fog;
+        if (tme)
+        {
+            // DrawSprite's textured paths, with its own expressions (their divisions stay on the CPU): the
+            // texel of each drawn column and row into the table the kernel reads.
+            float u0f, v0f, u1f, v1f;
+            if (state.prim.fst)
+            {
+                u0f = static_cast<float>(v0.u >> 4);
+                v0f = static_cast<float>(v0.v >> 4);
+                u1f = static_cast<float>(v1.u >> 4);
+                v1f = static_cast<float>(v1.v >> 4);
+            }
+            else
+            {
+                const float q0 = fabsQ(v0.q), q1 = fabsQ(v1.q);
+                u0f = (v0.s / q0) * static_cast<float>(texW);
+                v0f = (v0.t / q0) * static_cast<float>(texH);
+                u1f = (v1.s / q1) * static_cast<float>(texW);
+                v1f = (v1.t / q1) * static_cast<float>(texH);
+            }
+            const float spriteW = static_cast<float>(spanX), spriteH = static_cast<float>(spanY);
+            // The scaled pass's per-sample texel positions (shader flag 512, words 24-29; the light-map composite keeps
+            // its own exact path). 1x is unchanged.
+            p[24] = floatBits(u0f);
+            p[25] = floatBits((u1f - u0f) / spriteW);
+            p[26] = floatBits(static_cast<float>(x0));
+            p[27] = floatBits(v0f);
+            p[28] = floatBits((v1f - v0f) / spriteH);
+            p[29] = floatBits(static_cast<float>(y0));
+            spriteSamples = true;
+            texelsPerPixel = std::max(std::fabs(u1f - u0f) / spriteW, std::fabs(v1f - v0f) / spriteH);
+            const auto texAt = [](float t0, float t1, int pixel, int unclipped0, float size)
+            { return t0 + (t1 - t0) * ((static_cast<float>(pixel - unclipped0) + 0.5f) / size); };
+            const float uA = texAt(u0f, u1f, bx0, x0, spriteW), uB = texAt(u0f, u1f, bx1, x0, spriteW);
+            const float vA = texAt(v0f, v1f, by0, y0, spriteH), vB = texAt(v0f, v1f, by1, y0, spriteH);
+            const int cu0 = static_cast<int>(std::floor(std::min(uA, uB))) - 2, cu1 = static_cast<int>(std::ceil(std::max(uA, uB))) + 2;
+            const int cv0 = static_cast<int>(std::floor(std::min(vA, vB))) - 2, cv1 = static_cast<int>(std::ceil(std::max(vA, vB))) + 2;
+            const uint8_t fpsm = ctx.frame.psm;
+            const bool zOff = ((test >> 16) & 1u) == 0u, plainZ = (zOff || ztst == 1u) && ctx.zbuf.zmask;
+            const uint8_t sA = static_cast<uint8_t>(ctx.alpha & 3u), sB = static_cast<uint8_t>((ctx.alpha >> 2) & 3u);
+            const uint8_t sC = static_cast<uint8_t>((ctx.alpha >> 4) & 3u), sD = static_cast<uint8_t>((ctx.alpha >> 6) & 3u);
+            const int texU0 = static_cast<int>(v0.u >> 4), texV0 = static_cast<int>(v0.v >> 4);
+            const int uFirst = texU0 + (bx0 - x0), uLast = texU0 + (bx1 - x0), vFirst = texV0 + (by0 - y0), vLast = texV0 + (by1 - y0);
+            const bool exact = state.prim.fst && v0.x <= v1.x && v0.y <= v1.y && static_cast<int>(v1.u >> 4) - texU0 == spanX &&
+                               static_cast<int>(v1.v >> 4) - texV0 == spanY && uFirst >= 0 && uLast < texW && vFirst >= 0 && vLast < texH && wrapU <= 1u && wrapV <= 1u;
+            const bool lightMap = exact && (tex.psm == GS_PSM_CT16 || tex.psm == GS_PSM_CT16S) && tex.tfx == 1u && state.prim.abe && !state.pabe &&
+                                  !state.prim.fge && fpsm == GS_PSM_CT24 && ctx.frame.fbmsk == 0u && ((test >> 14) & 1u) == 0u && (test & 1u) == 0u &&
+                                  plainZ && sA != 0u && sB != 0u && sD != 0u && sC != 3u && sA != 3u && sB != 3u && sD != 3u;
+            const int cols = bx1 - bx0 + 1, rows = by1 - by0 + 1;
+            m_aux.assign(static_cast<size_t>(cols + rows) * 4u, 0u);
+            uint32_t *const colT = m_aux.data(), *const rowT = m_aux.data() + static_cast<size_t>(cols) * 4u;
+            p[50] = static_cast<uint32_t>(cols);
+            const int64_t cacheTexels = static_cast<int64_t>(cu1 - cu0 + 1) * (cv1 - cv0 + 1);
+            if (lightMap) // the texel-exact light-map composite: point texels at the exact positions, Z test skipped
+            {
+                lightMapComposite = true;
+                lightMapCols = static_cast<uint32_t>(uLast) + 1u;
+                lightMapRows = static_cast<uint32_t>(vLast) + 1u;
+                tableMode = true;
+                linear = false;
+                zSkip = true;
+                for (int i = 0; i < cols; ++i)
+                    colT[i * 4] = static_cast<uint32_t>(uFirst + i);
+                for (int j = 0; j < rows; ++j)
+                    rowT[j * 4] = static_cast<uint32_t>(vFirst + j);
+            }
+            else if (state.prim.fst && texW > 0 && texH > 0 && cacheTexels > 0 && cacheTexels <= 4ll * cols * rows + 4096)
+            {
+                // The decoded-rectangle path: 12.4 texel positions, cache-clamped and wrapped, fixed-point bilinear.
+                tableMode = true;
+                const auto put = [&](uint32_t *entry, int fixed, int lo, int hi, int size, uint8_t mode, uint16_t mn, uint16_t mx)
+                {
+                    const auto texel = [&](int t) { return static_cast<uint32_t>(wrapTexel(GSInternal::clampInt(t, lo, hi), size, mode, mn, mx)); };
+                    if (!linear)
+                        entry[0] = texel(static_cast<int>(static_cast<float>(fixed) / 16.0f));
+                    else
+                    {
+                        const int b = fixed - 8;
+                        entry[0] = texel(b >> 4);
+                        entry[1] = texel((b >> 4) + 1);
+                        entry[2] = static_cast<uint32_t>(b & 15);
+                    }
+                };
+                for (int x = bx0; x <= bx1; ++x)
+                {
+                    const float tx = (static_cast<float>(x - x0) + 0.5f) / spriteW;
+                    const float texUf = u0f + (u1f - u0f) * tx;
+                    put(colT + (x - bx0) * 4, GSInternal::clampInt(static_cast<int>((texUf * 16.0f) + 0.5f), 0, 0xFFFF), cu0, cu1, texW, wrapU, minU, maxU);
+                }
+                for (int y = by0; y <= by1; ++y)
+                {
+                    const float ty = (static_cast<float>(y - y0) + 0.5f) / spriteH;
+                    const float texVf = v0f + (v1f - v0f) * ty;
+                    put(rowT + (y - by0) * 4, GSInternal::clampInt(static_cast<int>((texVf * 16.0f) + 0.5f), 0, 0xFFFF), cv0, cv1, texH, wrapV, minV, maxV);
+                }
+                // Its direct and blending stores skip the Z test.
+                const bool plain = !state.prim.fge && ctx.frame.fbmsk == 0u && ((test >> 14) & 1u) == 0u && plainZ;
+                zSkip = plain && ((!state.prim.abe && (fpsm == GS_PSM_CT32 || fpsm == GS_PSM_CT24)) || (state.prim.abe && fpsm == GS_PSM_CT24));
+            }
+            else // per pixel through SampleTexture
+            {
+                const auto sampler = [&](float texF, int size)
+                {
+                    if (state.prim.fst)
+                    {
+                        const uint16_t sample = static_cast<uint16_t>(GSInternal::clampInt(static_cast<int>((texF * 16.0f) + 0.5f), 0, 0xFFFF));
+                        return floatBits(static_cast<float>(sample) / 16.0f);
+                    }
+                    const float st = texF / static_cast<float>(size);
+                    return floatBits(st * (1.0f / fabsQ(1.0f)) * static_cast<float>(size));
+                };
+                for (int x = bx0; x <= bx1; ++x)
+                    colT[(x - bx0) * 4] = sampler(u0f + (u1f - u0f) * ((static_cast<float>(x - x0) + 0.5f) / spriteW), texW);
+                for (int y = by0; y <= by1; ++y)
+                    rowT[(y - by0) * 4] = sampler(v0f + (v1f - v0f) * ((static_cast<float>(y - y0) + 0.5f) / spriteH), texH);
+            }
+        }
+    }
+    else
+    {
+        // DrawTriangle's setup.
+        const GSVertex &v0 = batch.vertices[0], &v1 = batch.vertices[1], &v2 = batch.vertices[2];
+        const float fx0 = v0.x - static_cast<float>(ofx), fy0 = v0.y - static_cast<float>(ofy);
+        const float fx1 = v1.x - static_cast<float>(ofx), fy1 = v1.y - static_cast<float>(ofy);
+        const float fx2 = v2.x - static_cast<float>(ofx), fy2 = v2.y - static_cast<float>(ofy);
+        bx0 = GSInternal::clampInt(static_cast<int>(std::floor(std::min({fx0, fx1, fx2}))), ctx.scissor.x0, ctx.scissor.x1);
+        bx1 = GSInternal::clampInt(static_cast<int>(std::ceil(std::max({fx0, fx1, fx2}))), ctx.scissor.x0, ctx.scissor.x1);
+        by0 = GSInternal::clampInt(static_cast<int>(std::floor(std::min({fy0, fy1, fy2}))), ctx.scissor.y0, ctx.scissor.y1);
+        by1 = GSInternal::clampInt(static_cast<int>(std::ceil(std::max({fy0, fy1, fy2}))), ctx.scissor.y0, ctx.scissor.y1);
+        const float denom = (fy1 - fy2) * (fx0 - fx2) + (fx2 - fx1) * (fy0 - fy2);
+        if (std::fabs(denom) < 0.001f || bx1 < bx0 || by1 < by0)
+            return true;
+        const float winding = (denom < 0.0f) ? -1.0f : 1.0f;
+        const float invAbsDenom = 1.0f / std::fabs(denom);
+        p[0] = 1u;
+        const float xy[6] = {fx0, fy0, fx1, fy1, fx2, fy2};
+        for (int k = 0; k < 6; ++k)
+            p[20 + k] = floatBits(xy[k]);
+        p[26] = floatBits(winding);
+        p[27] = floatBits(invAbsDenom);
+        const double zs[3] = {v0.z, v1.z, v2.z};
+        std::memcpy(&p[28], zs, sizeof(zs));
+        p[34] = pack32(v0.r, v0.g, v0.b, v0.a);
+        p[35] = pack32(v1.r, v1.g, v1.b, v1.a);
+        p[36] = pack32(v2.r, v2.g, v2.b, v2.a);
+        p[37] = v0.fog | (static_cast<uint32_t>(v1.fog) << 8) | (static_cast<uint32_t>(v2.fog) << 16);
+        p[38] = floatBits(1.0e-4f); // DrawTriangle's kEdgeEpsilon
+        const GSVertex *vs[3] = {&v0, &v1, &v2};
+        for (int k = 0; k < 3; ++k)
+        {
+            p[52 + k] = vs[k]->u;
+            p[55 + k] = vs[k]->v;
+            p[58 + k] = floatBits(vs[k]->s);
+            p[61 + k] = floatBits(vs[k]->t);
+            p[64 + k] = floatBits(vs[k]->q);
+        }
+        if (tme) // texel area over pixel area (s/q per vertex: close enough for a magnification test)
+        {
+            float tu[3], tv[3];
+            for (int k = 0; k < 3; ++k)
+            {
+                const float q = fabsQ(vs[k]->q);
+                tu[k] = state.prim.fst ? static_cast<float>(vs[k]->u) / 16.0f : vs[k]->s / q * static_cast<float>(texW);
+                tv[k] = state.prim.fst ? static_cast<float>(vs[k]->v) / 16.0f : vs[k]->t / q * static_cast<float>(texH);
+            }
+            const float texArea = std::fabs((tu[1] - tu[0]) * (tv[2] - tv[0]) - (tu[2] - tu[0]) * (tv[1] - tv[0]));
+            texelsPerPixel = std::sqrt(texArea / std::fabs(denom));
+        }
+    }
+    if (ztst == 0u && !zSkip)
+        return true; // WritePixel writes nothing
+    // Past the buffer width (every frame/Z format's page is 64 pixels wide) or VRAM's 4 MB wrap, two pixels
+    // of one primitive can share an address: the CPU's row order decides there, the GPU's threads would race.
+    const uint32_t pageRowsEnd = (static_cast<uint32_t>(by1) + 64u) / 32u * p[6] * 8192u;
+    if (static_cast<uint32_t>(bx1) >= p[6] * 64u || ctx.frame.fbp * 8192u + pageRowsEnd > kVramBytes ||
+        ((ztst >= 2u || !ctx.zbuf.zmask) && ctx.zbuf.zbp * 8192u + pageRowsEnd > kVramBytes))
+        return toCpu(4);
+    if (tme)
+        p[39] = 1u | (state.prim.fst ? 2u : 0u) | (linear ? 4u : 0u) | (tex.tcc ? 8u : 0u) | ((tex.tfx & 3u) << 4) | (tableMode ? 64u : 0u) | (lightMapComposite ? 128u : 0u);
+    if (spriteSamples && !lightMapComposite)
+        p[39] |= 512u;
+    // The scaled pass smooths a point-sampled texture drawn magnified (door icons, speech bubbles): at 2x its texels
+    // would be hard blocks next to the sharper geometry. 1:1 draws (text) stay crisp; 1x is unchanged.
+    if (tme && m_scaling && !linear && !lightMapComposite && texelsPerPixel >= 0.0f && texelsPerPixel < 0.9f)
+        p[39] |= 1024u;
+    if (zSkip)
+        p[15] |= 32u;
+    p[1] = static_cast<uint32_t>(bx0);
+    p[2] = static_cast<uint32_t>(by0);
+    p[3] = static_cast<uint32_t>(bx1);
+    p[4] = static_cast<uint32_t>(by1);
+    NeedGpu();
+    // Into the run, after the draws and CLUT loads it can't run alongside. The pages of the box's page rows
+    // (16-bit pages are 64 rows high, 32-bit ones 32).
+    Run &r = *m_run;
+    const uint32_t rowPages = p[6], firstRow = static_cast<uint32_t>(by0) / 64u * rowPages, endRow = (static_cast<uint32_t>(by1) / 32u + 1u) * rowPages;
+    const bool usesZ = ztst >= 2u || !ctx.zbuf.zmask;
+    const Run::Pages texPages = tme ? Run::range(texBegin / 8192u, (texEnd + 8191u) / 8192u) : Run::Pages{};
+    const Run::Pages fPages = Run::range(ctx.frame.fbp + firstRow, ctx.frame.fbp + endRow);
+    const Run::Pages zPages = usesZ ? Run::range(ctx.zbuf.zbp + firstRow, ctx.zbuf.zbp + endRow) : Run::Pages{};
+    if ((tme && r.written(texPages, topByte)) || r.bufferConflict(ctx.frame.fbp, rowPages, ctx.frame.psm, fPages) ||
+        (usesZ && r.bufferConflict(ctx.zbuf.zbp, rowPages, ctx.zbuf.psm, zPages)))
+        FlushRun();
+    ScaledTarget *scaledFrame = nullptr, *scaledZ = nullptr;
+    if (Scaling *sc = m_scaling.get())
+    {
+        // Into a scaled frame buffer (and its Z): drawn a second time there. A run doesn't mix a surface's scaled
+        // draws with writes that make it stale (the refill must come between them).
+        if (static_cast<uint32_t>(by1) < kScaledRows)
+        {
+            const bool bench = std::find(sc->benchPages.begin(), sc->benchPages.end(), ctx.frame.fbp) != sc->benchPages.end();
+            scaledFrame = ScaledSurface(ctx.frame.fbp, rowPages, ctx.frame.psm, bench, static_cast<uint32_t>(by1) + 1u);
+            if (scaledFrame && usesZ && !(scaledZ = ScaledSurface(ctx.zbuf.zbp, rowPages, ctx.zbuf.psm, true, static_cast<uint32_t>(by1) + 1u)))
+                scaledFrame = nullptr;
+        }
+        // A light-map composite into a scaled frame: the light map gets a scaled surface too, so the draws into
+        // it (the next frame on) run scaled and the composite samples it per sample. Until then: refilled from VRAM.
+        static const bool s_lightMap1x = std::getenv("GHS_GS_LIGHTMAP_1X") != nullptr; // GHS-TRACE: keep it 1x (A/B)
+        ScaledTarget *scaledTex = nullptr;
+        if (scaledFrame && lightMapComposite && !s_lightMap1x && (tex.tbp0 & 31u) == 0u && lightMapRows <= kScaledRows && lightMapCols <= tex.tbw * 64u)
+            scaledTex = ScaledSurface(tex.tbp0 / 32u, tex.tbw, tex.psm, true, lightMapRows);
+        const Run::Pages written = fPages | (ctx.zbuf.zmask ? Run::Pages{} : zPages);
+        for (Scaling::Surface &s : sc->surfaces)
+            if (&s != scaledFrame && &s != scaledZ && s.mirroredInRun && (s.pages & written).any())
+            {
+                FlushRun();
+                break;
+            }
+        for (Scaling::Surface &s : sc->surfaces)
+            if (&s != scaledFrame && &s != scaledZ && (s.pages & written).any())
+            {
+                s.stale |= s.pages & written;
+                s.staleInRun = true;
+            }
+        if (scaledFrame && (scaledFrame->staleInRun || (scaledZ && scaledZ->staleInRun) || (scaledTex && scaledTex->staleInRun)))
+            FlushRun(); // refills them before this draw
+        if (scaledFrame)
+        {
+            scaledFrame->mirroredInRun = true;
+            if (scaledZ)
+                scaledZ->mirroredInRun = true;
+            sc->shadowsInRun |= scaledTex != nullptr;
+            p[69] = scaledFrame->offset;
+            p[70] = scaledZ ? scaledZ->offset : 0u;
+            p[71] = scaledFrame->pitch;
+            if (scaledTex)
+            {
+                scaledTex->mirroredInRun = true; // read by the scaled pass: later writes to it wait for the flush
+                p[20] = scaledTex->offset;
+                p[21] = scaledTex->pitch;
+                p[22] = lightMapCols * sc->scale - 1u;
+                p[23] = lightMapRows * sc->scale - 1u;
+                p[39] |= 256u;
+            }
+        }
+    }
+    r.addBuffer(ctx.frame.fbp, rowPages, ctx.frame.psm, fPages);
+    if (usesZ)
+        r.addBuffer(ctx.zbuf.zbp, rowPages, ctx.zbuf.psm, zPages);
+    (topByte ? r.texReadTop : r.texRead) |= texPages;
+    const uint32_t record = static_cast<uint32_t>(r.words.size());
+    p[67] = record + kRecordWords;
+    p[68] = r.loadsDone + static_cast<uint32_t>(r.loads.size() / kClutLoadWords);
+    r.words.insert(r.words.end(), p, p + kRecordWords);
+    r.words.insert(r.words.end(), m_aux.begin(), m_aux.end());
+    r.boxes.push_back({record, bx0, by0, bx1, by1});
+    if (scaledFrame)
+    {
+        const int n = static_cast<int>(m_scaling->scale);
+        m_scaling->boxes.push_back({record, bx0 * n, by0 * n, bx1 * n + n - 1, by1 * n + n - 1});
+    }
+    if (tme)
+        ++m_gpuTextured;
+    return true;
+}
+
+void GSGpuBackend::Submit(const GSPrimitiveBatch &batch)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!m_vram || batch.vertexCount == 0u)
+        return;
+    if (m_dev && DrawOnGpu(batch))
+    {
+        ++m_gpuDraws;
+        // GHS-TRACE: the CPU backend counts this down per primitive (gs_cpu_backend.cpp); left standing, the
+        // movie's g_ghsPrimLog = 20 kept VU1's [GHS-VU] trace printing and the game at ~12 fps.
+        extern int g_ghsPrimLog;
+        if (g_ghsPrimLog > 0)
+            --g_ghsPrimLog;
+        return;
+    }
+    if (m_dev)
+    {
+        NeedCpu();
+        if (batch.state.prim.tme)
+            SyncClutToCpu();
+    }
+    m_cpu.Submit(batch);
+    m_cpuNewer = true;
+    ++m_cpuDraws;
+    const auto &ctx = batch.state.context;
+    const uint32_t rows = (static_cast<uint32_t>(ctx.scissor.y1) / 32u + 2u) * std::max<uint32_t>(ctx.frame.fbw, 1u);
+    MarkScaledStale(Run::range(ctx.frame.fbp, ctx.frame.fbp + rows) | (ctx.zbuf.zmask ? Run::Pages{} : Run::range(ctx.zbuf.zbp, ctx.zbuf.zbp + rows)));
+}
+
+void GSGpuBackend::LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!m_dev)
+    {
+        m_cpu.LoadClut(tex0, texclut);
+        return;
+    }
+    // GSCpuBackend::LoadClutChecked's CLD rules, then LoadClutUnlocked as a kernel into the GPU's CLUT.
+    const bool fourBit = tex0.psm == GS_PSM_T4 || tex0.psm == GS_PSM_T4HL || tex0.psm == GS_PSM_T4HH;
+    if (!m_vram || (!fourBit && tex0.psm != GS_PSM_T8 && tex0.psm != GS_PSM_T8H))
+        return;
+    switch (tex0.cld)
+    {
+    case 1u: break;
+    case 2u: m_clutCbp[0] = tex0.cbp; break;
+    case 3u: m_clutCbp[1] = tex0.cbp; break;
+    case 4u:
+        if (m_clutCbp[0] == tex0.cbp)
+            return;
+        m_clutCbp[0] = tex0.cbp;
+        break;
+    case 5u:
+        if (m_clutCbp[1] == tex0.cbp)
+            return;
+        m_clutCbp[1] = tex0.cbp;
+        break;
+    default: return;
+    }
+    uint32_t first = 0u, count = 0u;
+    bool valid = false;
+    GSCpuBackend::ClutLayout(tex0, first, count, valid);
+    if (!valid)
+        return;
+    const uint32_t load[kClutLoadWords] = {tex0.cpsm, tex0.csm, tex0.csa, tex0.cbp, texclut.cbw, texclut.cou, texclut.cov, first, count, fourBit ? 1u : 0u};
+    NeedGpu();
+    // The run's CLUT loads read VRAM before its draws: not after a draw that wrote their palette.
+    uint32_t begin, end;
+    if (tex0.csm == 0u)
+        rectRange(tex0.cbp, 1u, 0u, 0u, 16u, 16u, begin, end);
+    else
+        rectRange(tex0.cbp, std::max<uint32_t>(texclut.cbw, 1u), texclut.cou * 16u, texclut.cov, count, 1u, begin, end);
+    const Run::Pages pages = Run::range(end > kVramBytes ? 0u : begin / 8192u, end / 8192u);
+    Run &r = *m_run;
+    // ... and the run's CLUT versions must fit the buffer (FlushCluts).
+    if (r.written(pages, false) || (r.loadsDone != 0u && r.clutFirst + r.loadsDone + r.loads.size() / kClutLoadWords + 1u >= m_dev->clutVersions))
+        FlushRun();
+    r.clutRead |= pages;
+    r.loads.insert(r.loads.end(), load, load + kClutLoadWords);
+    m_cpuClutStale = true;
+    ++m_gpuCluts;
+}
+
+void GSGpuBackend::LoadClutValues(const GSTex0Reg &tex0, const GSTexClutReg &texclut, const uint32_t *raws)
+{
+    if (m_dev) // the values are in VRAM too
+    {
+        LoadClut(tex0, texclut);
+        return;
+    }
+    std::lock_guard<std::mutex> lock(m_mutex);
+    m_cpu.LoadClutValues(tex0, texclut, raws);
+}
+
+// The GPU's CLUT into the CPU backend, for a textured draw the GPU can't do: all 512 entries as two
+// 16-bit CLUT loads with the values given (CSM2, CSA 0 and 16).
+void GSGpuBackend::SyncClutToCpu()
+{
+    if (!m_cpuClutStale || !m_dev)
+        return;
+    m_cpuClutStale = false;
+    uint32_t entries[512];
+    if (!ReadClut(entries))
+        return;
+    GSTex0Reg t{};
+    t.psm = GS_PSM_T8;
+    t.cpsm = GS_PSM_CT16;
+    t.csm = 1u;
+    t.cld = 1u;
+    for (uint32_t half = 0; half < 2u; ++half)
+    {
+        t.csa = static_cast<uint8_t>(half * 16u);
+        m_cpu.LoadClutValues(t, GSTexClutReg{}, entries + half * 256u);
+    }
+}
+
+// The current CLUT (after FlushRun).
+bool GSGpuBackend::ReadClut(uint32_t (&entries)[512]) const
+{
+    const D3D11_BOX box{m_dev->clutVersion * 2048u, 0, 0, m_dev->clutVersion * 2048u + 2048u, 1, 1};
+    m_dev->ctx->CopySubresourceRegion(m_dev->clutStaging.Get(), 0, 0, 0, 0, m_dev->clut.Get(), 0, &box);
+    D3D11_MAPPED_SUBRESOURCE mapped{};
+    if (FAILED(m_dev->ctx->Map(m_dev->clutStaging.Get(), 0, D3D11_MAP_READ, 0, &mapped)))
+    {
+        std::fprintf(stderr, "[GHS-GSGPU] CLUT readback failed\n");
+        return false;
+    }
+    std::memcpy(entries, mapped.pData, sizeof(entries));
+    m_dev->ctx->Unmap(m_dev->clutStaging.Get(), 0);
+    return true;
+}
+
+void GSGpuBackend::ResetClut()
+{
+    m_clutCbp = {};
+    m_cpuClutStale = false; // the CPU backend's reset cleared its CLUT too
+    if (m_dev)
+    {
+        static const uint32_t zeros[512] = {};
+        const D3D11_BOX box{m_dev->clutVersion * 2048u, 0, 0, m_dev->clutVersion * 2048u + 2048u, 1, 1};
+        m_dev->ctx->UpdateSubresource(m_dev->clut.Get(), 0, &box, zeros, 0, 0);
+    }
+}
+
+bool GSGpuBackend::LocalCopyOnGpu(const GSTransferCommand &command)
+{
+    const auto &b = command.bitbltbuf;
+    const auto &pos = command.trxpos;
+    const uint32_t rrw = command.trxreg.rrw, rrh = command.trxreg.rrh, total = rrw * rrh;
+    if (total != 0u)
+    {
+        uint32_t sBegin, sEnd, dBegin, dEnd;
+        transferRange(b.spsm, b.sbp, b.sbw, pos.ssax, pos.ssay, rrw, rrh, sBegin, sEnd);
+        transferRange(b.dpsm, b.dbp, b.dbw, pos.dsax, pos.dsay, rrw, rrh, dBegin, dEnd);
+        if ((sBegin < dEnd && dBegin < sEnd) || sEnd > kVramBytes || dEnd > kVramBytes || selfAliases(b.dpsm, b.dbw, rrw, rrh))
+            return false; // overlapping, wrapping or self-aliasing copies keep the CPU's pixel order
+        const uint32_t p[kParamWords] = {b.spsm & 0x3Fu, b.sbp, std::max<uint32_t>(b.sbw, 1u), b.dpsm & 0x3Fu, b.dbp, std::max<uint32_t>(b.dbw, 1u),
+                                         rrw, rrh, pos.ssax, pos.ssay, pos.dsax, pos.dsay, pos.dir, total};
+        NeedGpu();
+        // It runs now, ahead of the pending run: only if the run neither writes its source nor uses its destination.
+        if (m_run->written(Run::range(sBegin / 8192u, sEnd / 8192u), false))
+            FlushRun();
+        FlushBefore(Run::range(dBegin / 8192u, dEnd / 8192u));
+        Dispatch(kCopy, p, (total + 255u) / 256u, 1u);
+        MarkScaledStale(Run::range(dBegin / 8192u, (dEnd + 8191u) / 8192u));
+    }
+    m_transfer = command;
+    m_transferState = {};
+    m_transferState.x = pos.dsax;
+    m_transferState.y = pos.dsay;
+    m_transferState.totalPixels = total;
+    m_transferState.copiedPixels = total;
+    m_transferState.direction = 3u;
+    return true;
+}
+
+void GSGpuBackend::BeginTransfer(const GSTransferCommand &command)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    uint32_t dBegin, dEnd;
+    transferRange(command.bitbltbuf.dpsm, command.bitbltbuf.dbp, command.bitbltbuf.dbw, command.trxpos.dsax, command.trxpos.dsay,
+                  command.trxreg.rrw, command.trxreg.rrh, dBegin, dEnd);
+    if (m_dev && command.direction == 0u && dEnd <= kVramBytes &&
+        !selfAliases(command.bitbltbuf.dpsm, command.bitbltbuf.dbw, command.trxreg.rrw, command.trxreg.rrh))
+    {
+        m_transferOnGpu = true;
+        m_transfer = command;
+        m_transferState = {};
+        m_transferState.x = command.trxpos.dsax;
+        m_transferState.y = command.trxpos.dsay;
+        m_transferState.totalPixels = static_cast<uint32_t>(command.trxreg.rrw) * static_cast<uint32_t>(command.trxreg.rrh);
+        m_transferState.direction = 0u;
+        return;
+    }
+    if (m_dev && command.direction == 2u && LocalCopyOnGpu(command))
+    {
+        m_transferOnGpu = true;
+        ++m_gpuCopies;
+        return;
+    }
+    m_transferOnGpu = false;
+    if (m_dev && (command.direction == 1u || command.direction == 2u))
+        NeedCpu();
+    m_cpu.BeginTransfer(command);
+    // What it writes (addresses wrap at 4 MB): a CPU upload marks only these stale, not the scaled frame too.
+    m_cpuTransferPages = Run::range(dBegin / 8192u, (dEnd + 8191u) / 8192u);
+    if (dEnd > kVramBytes)
+        m_cpuTransferPages |= Run::range(0u, (dEnd - kVramBytes + 8191u) / 8192u);
+    if (command.direction == 2u)
+    {
+        m_cpuNewer = true;
+        MarkScaledStale(m_cpuTransferPages);
+    }
+    if (command.direction <= 2u)
+    {
+        const auto &b = command.bitbltbuf;
+        uint32_t *last = m_cpuTransferLast[command.direction];
+        ++m_cpuTransfers[command.direction];
+        last[0] = b.dbp | b.dbw << 14 | static_cast<uint32_t>(b.dpsm) << 20;
+        last[1] = b.sbp | b.sbw << 14 | static_cast<uint32_t>(b.spsm) << 20;
+        last[2] = command.trxpos.dsax | command.trxpos.dsay << 16;
+        last[3] = command.trxreg.rrw | command.trxreg.rrh << 16;
+    }
+    ++m_cpuOps;
+}
+
+void GSGpuBackend::UploadOnGpu(const uint8_t *data, uint32_t sizeBytes)
+{
+    GSTransferSnapshot &st = m_transferState;
+    const uint32_t rrw = m_transfer.trxreg.rrw;
+    if (st.direction != 0u || rrw == 0u || m_transfer.trxreg.rrh == 0u || st.totalPixels == 0u)
+        return;
+    const uint32_t remaining = st.totalPixels - st.copiedPixels;
+    const uint8_t dpsm = m_transfer.bitbltbuf.dpsm;
+    // UploadImage's loop: whole pixels only (a partial one at the end of the data is dropped).
+    uint32_t pixels, bytes;
+    switch (dpsm)
+    {
+    case GS_PSM_CT32: case GS_PSM_Z32: pixels = std::min(sizeBytes / 4u, remaining); bytes = pixels * 4u; break;
+    case GS_PSM_CT24: case GS_PSM_Z24: pixels = std::min(sizeBytes / 3u, remaining); bytes = pixels * 3u; break;
+    case GS_PSM_CT16: case GS_PSM_CT16S: case GS_PSM_Z16: case GS_PSM_Z16S: pixels = std::min(sizeBytes / 2u, remaining); bytes = pixels * 2u; break;
+    case GS_PSM_T8: case GS_PSM_T8H: pixels = std::min(sizeBytes, remaining); bytes = pixels; break;
+    case GS_PSM_T4: case GS_PSM_T4HL: case GS_PSM_T4HH: pixels = std::min(sizeBytes * 2u, remaining); bytes = (pixels + 1u) / 2u; break;
+    default: return;
+    }
+    if (pixels == 0u)
+        return;
+    NeedGpu();
+    // It runs now, ahead of the pending run: only if the run doesn't use the destination.
+    uint32_t dBegin, dEnd;
+    transferRange(dpsm, m_transfer.bitbltbuf.dbp, m_transfer.bitbltbuf.dbw, m_transfer.trxpos.dsax, m_transfer.trxpos.dsay, rrw, m_transfer.trxreg.rrh, dBegin, dEnd);
+    FlushBefore(Run::range(dBegin / 8192u, dEnd / 8192u));
+    if (!m_dev->PutData(data, bytes))
+    {
+        std::fprintf(stderr, "[GHS-GSGPU] upload buffer allocation failed\n");
+        m_deviceTrouble = "upload buffer allocation failed";
+        return;
+    }
+    const uint32_t p[kParamWords] = {dpsm, m_transfer.bitbltbuf.dbp, std::max<uint32_t>(m_transfer.bitbltbuf.dbw, 1u), rrw,
+                                     m_transfer.trxpos.dsax, m_transfer.trxpos.dsay, st.copiedPixels, pixels};
+    Dispatch(kUpload, p, (pixels + 255u) / 256u, 1u);
+    MarkScaledStale(Run::range(dBegin / 8192u, (dEnd + 8191u) / 8192u));
+    ++m_gpuUploads;
+    st.copiedPixels = std::min(st.totalPixels, st.copiedPixels + pixels);
+    if (st.copiedPixels >= st.totalPixels)
+    {
+        st.direction = 3u;
+        st.totalPixels = 0u;
+        return;
+    }
+    st.x = m_transfer.trxpos.dsax + st.copiedPixels % rrw;
+    st.y = m_transfer.trxpos.dsay + st.copiedPixels / rrw;
+}
+
+void GSGpuBackend::UploadImage(const uint8_t *data, uint32_t sizeBytes)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!data || sizeBytes == 0u || !m_vram)
+        return;
+    if (m_transferOnGpu)
+    {
+        if (m_dev) // else the device was lost during it: the rest is dropped
+            UploadOnGpu(data, sizeBytes);
+        return;
+    }
+    if (m_dev)
+        NeedCpu();
+    m_cpu.UploadImage(data, sizeBytes);
+    m_cpuNewer = true;
+    ++m_cpuOps;
+    MarkScaledStale(m_cpuTransferPages);
+}
+
+void GSGpuBackend::Flush()
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_dev)
+    {
+        FlushRun();
+        m_dev->ctx->Flush();
+    }
+}
+
+void GSGpuBackend::TextureFlush()
+{
+    m_cpu.TextureFlush();
+}
+
+void GSGpuBackend::InvalidateTextureRange(uint32_t beginBytes, uint32_t endBytes, bool keepTopByteTextures)
+{
+    m_cpu.InvalidateTextureRange(beginBytes, endBytes, keepTopByteTextures);
+}
+
+void GSGpuBackend::ReportStats()
+{
+    std::fprintf(stderr, "[GHS-GSGPU] %llu FINISH: draws %llu GPU (%llu textured) / %llu CPU, CLUT loads %llu, runs %llu, uploads %llu GPU, local copies %llu GPU, "
+                         "other CPU ops %llu; full VRAM copies %llu to the GPU / %llu back\n",
+                 static_cast<unsigned long long>(m_finishes), static_cast<unsigned long long>(m_gpuDraws), static_cast<unsigned long long>(m_gpuTextured),
+                 static_cast<unsigned long long>(m_cpuDraws), static_cast<unsigned long long>(m_gpuCluts), static_cast<unsigned long long>(m_runs),
+                 static_cast<unsigned long long>(m_gpuUploads), static_cast<unsigned long long>(m_gpuCopies), static_cast<unsigned long long>(m_cpuOps),
+                 static_cast<unsigned long long>(m_uploadsFull), static_cast<unsigned long long>(m_downloads));
+    // Last draw per cause: prim (+0x10 textured) and TEST bits 0-15 <<8; fbp | fbw<<12 | psm<<20; zbp | zpsm<<12 | zmask<<20;
+    // tbp0 | tbw<<14 | tpsm<<20.
+    static const char *const kWhy[5] = {"lines/points", "frame psm", "Z format or frame/Z overlap", "samples its own frame/Z", "past the width / 4 MB wrap"};
+    for (int k = 0; k < 5; ++k)
+        if (m_cpuWhy[k] != 0u)
+            std::fprintf(stderr, "[GHS-GSGPU]   CPU draws, %s: %llu (last: %06x %06x %06x %06x)\n", kWhy[k], static_cast<unsigned long long>(m_cpuWhy[k]),
+                         m_cpuWhyLast[k][0], m_cpuWhyLast[k][1], m_cpuWhyLast[k][2], m_cpuWhyLast[k][3]);
+    std::fill(std::begin(m_cpuWhy), std::end(m_cpuWhy), 0u);
+    static const char *const kDir[3] = {"host->local", "local->host", "local->local"};
+    for (int k = 0; k < 3; ++k)
+        if (m_cpuTransfers[k] != 0u)
+            std::fprintf(stderr, "[GHS-GSGPU]   CPU transfers, %s: %llu (last: d %06x s %06x pos %08x size %08x)\n", kDir[k],
+                         static_cast<unsigned long long>(m_cpuTransfers[k]), m_cpuTransferLast[k][0], m_cpuTransferLast[k][1], m_cpuTransferLast[k][2],
+                         m_cpuTransferLast[k][3]);
+    std::fill(std::begin(m_cpuTransfers), std::end(m_cpuTransfers), 0u);
+    m_gpuDraws = m_gpuTextured = m_gpuCluts = m_runs = m_cpuDraws = m_gpuUploads = m_gpuCopies = m_cpuOps = m_uploadsFull = m_downloads = 0;
+    if (m_scaling)
+    {
+        std::fprintf(stderr, "[GHS-GSGPU] scaled %ux: %llu draws into %zu surfaces, %llu refills from VRAM\n", m_scaling->scale,
+                     static_cast<unsigned long long>(m_scaling->scaledDraws), m_scaling->surfaces.size(), static_cast<unsigned long long>(m_scaling->expands));
+        m_scaling->scaledDraws = m_scaling->expands = 0;
+    }
+}
+
+void GSGpuBackend::Sync(GSSyncReason reason)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (reason == GSSyncReason::Finish) // once a frame: is the device still there?
+    {
+        static const char *const loseAt = std::getenv("GHS_GS_GPU_LOSE_AT"); // GHS-TRACE: <FINISH>[,cpu]
+        static const uint64_t s_loseAt = loseAt ? std::strtoull(loseAt, nullptr, 10) : 0u;
+        if (m_dev)
+        {
+            const HRESULT removed = m_dev->device->GetDeviceRemovedReason();
+            if (removed != S_OK)
+                RecoverDevice("device removed or reset", removed);
+            else if (m_deviceTrouble)
+                RecoverDevice(m_deviceTrouble, E_OUTOFMEMORY);
+            else if (s_loseAt != 0u && m_finishes + 1u == s_loseAt)
+            {
+                s_failNextCreate = std::strstr(loseAt, ",cpu") != nullptr;
+                RecoverDevice("GHS_GS_GPU_LOSE_AT test", DXGI_ERROR_DEVICE_REMOVED);
+            }
+        }
+        else if (m_lost && m_finishes >= m_retryAt)
+            RecoverDevice(nullptr, S_OK);
+    }
+    if (m_dev && reason == GSSyncReason::Finish)
+    {
+        // Nothing to wait for: the presenter's copy comes from StartFinishCopy, every other reader syncs itself.
+        FlushRun();
+        // About once a second a snapshot of VRAM (copied on the GPU, read back when ready): after a device loss VRAM
+        // goes on from it when it is newer than m_vram (else textures the game uploaded once, its font, are gone).
+        Device &d = *m_dev;
+        if (d.checkpointSeq != 0u)
+        {
+            D3D11_MAPPED_SUBRESOURCE mapped{};
+            const HRESULT hr = d.ctx->Map(d.checkpoint.Get(), 0, D3D11_MAP_READ, D3D11_MAP_FLAG_DO_NOT_WAIT, &mapped);
+            if (SUCCEEDED(hr))
+            {
+                const uint8_t *bytes = static_cast<const uint8_t *>(mapped.pData);
+                m_checkpoint.assign(bytes, bytes + kVramBytes);
+                m_checkpointSeq = d.checkpointSeq;
+                d.ctx->Unmap(d.checkpoint.Get(), 0);
+            }
+            if (hr != DXGI_ERROR_WAS_STILL_DRAWING)
+                d.checkpointSeq = 0u;
+        }
+        if (d.checkpointSeq == 0u && !m_cpuNewer && m_finishes % 60u == 30u)
+        {
+            d.ctx->CopyResource(d.checkpoint.Get(), d.vram.Get());
+            d.checkpointSeq = ++m_vramSeq;
+        }
+        m_dev->ctx->Flush();
+        if (g_timing)
+            g_timing->Report(m_dev->ctx.Get());
+    }
+    else if (m_dev)
+        NeedCpu();
+    if (reason == GSSyncReason::Finish && ++m_finishes % (m_finishes <= 100u ? 10u : 500u) == 0u)
+        ReportStats();
+}
+
+// A lost device (driver reset/TDR, driver update, out of video memory, or GHS_GS_GPU_LOSE_AT): the old device's work
+// since the last readback is gone and VRAM goes on from the CPU copy. The game redraws its frames and re-uploads
+// most textures every frame, so a frame or two can look wrong. A new device takes over (kernels from the first
+// compile, scaled surfaces anew); without one the CPU backend draws (one thread, slow) and a device is tried again
+// every 600 FINISH. After 5 losses the GS stays on the CPU.
+void GSGpuBackend::RecoverDevice(const char *why, long hr)
+{
+    if (why)
+    {
+        const bool fromSnapshot = m_gpuNewer && m_checkpointSeq > m_vramSyncedSeq && m_checkpoint.size() == kVramBytes;
+        if (fromSnapshot)
+            std::memcpy(m_vram, m_checkpoint.data(), std::min(m_vramSize, kVramBytes));
+        std::fprintf(stderr, "[GHS-GSGPU] device lost (%s, 0x%08lx): VRAM goes on from %s\n", why, static_cast<unsigned long>(hr),
+                     fromSnapshot ? "the last snapshot (<= 1 s old)" : "the CPU copy");
+        m_lostScale = m_scaling ? m_scaling->scale : 1u;
+        m_run->clear();
+        m_scaling.reset();
+        m_dev.reset();
+        if (g_timing)
+            g_timing->Drop();
+        m_lost = true;
+        ++m_losses;
+    }
+    m_deviceTrouble = nullptr;
+    m_gpuNewer = false;
+    m_cpuNewer = true;
+    m_clutCbp = {};
+    m_cpuClutStale = false;
+    m_cpu.TextureFlush();
+    m_cpu.InvalidateTextureRange(0u, UINT32_MAX);
+    if (m_losses <= 5u)
+        m_dev = Device::Create();
+    if (!m_dev)
+    {
+        m_transferOnGpu = false;
+        m_retryAt = m_losses <= 5u ? m_finishes + 600u : UINT64_MAX;
+        std::fprintf(stderr, "[GHS-GSGPU] no D3D11 device: the GS runs on the CPU backend (one thread)%s\n", m_losses <= 5u ? ", next try in 600 FINISH" : " for good (5 losses)");
+        return;
+    }
+    m_lost = false;
+    ResetClut();
+    SetScaleLocked(m_lostScale);
+    std::fprintf(stderr, "[GHS-GSGPU] new D3D11 device ready, scale %ux\n", m_lostScale);
+}
+
+uint64_t GSGpuBackend::StartFinishCopy(const GSPresentationRequest &request)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!m_dev)
+        return 0u;
+    FlushRun();
+    if (!m_gpuNewer)
+        return 0u;
+    // PresentFromLocalMemory's sources: DISPFB (FBP 0-8, FBW 9-14, DBY 43-53) with DISPLAY's DH (44-54) lines,
+    // the preferred source, and for a display at FBP 0 the context frames. Page rows counted 32 lines high
+    // (16-bit pages are 64), one more for the read origin.
+    Run::Pages pages;
+    const auto add = [&](uint32_t fbp, uint32_t fbw, uint32_t lines)
+    { pages |= Run::range(fbp, fbp + std::max(fbw, 1u) * ((lines + 31u) / 32u + 1u)); };
+    const uint64_t dispfb[2] = {request.dispfb1, request.dispfb2}, display[2] = {request.display1, request.display2};
+    for (int k = 0; k < 2; ++k)
+    {
+        const uint32_t fbp = static_cast<uint32_t>(dispfb[k] & 0x1FFu), fbw = static_cast<uint32_t>((dispfb[k] >> 9) & 0x3Fu);
+        const uint32_t lines = static_cast<uint32_t>((dispfb[k] >> 43) & 0x7FFu) + static_cast<uint32_t>((display[k] >> 44) & 0x7FFu) + 1u;
+        add(fbp, fbw, lines);
+        if (request.hasPreferredSource)
+            add(request.preferredSource.fbp, request.preferredSource.fbw, lines);
+        if (fbp == 0u)
+            for (const GSFrameReg &frame : request.contextFrames)
+                add(frame.fbp, frame.fbw, lines);
+    }
+    Device::FinishCopy &copy = m_dev->finishCopies[++m_finishTicket % m_dev->finishCopies.size()];
+    if (!copy.staging)
+    {
+        D3D11_BUFFER_DESC desc{};
+        desc.ByteWidth = kVramBytes;
+        desc.Usage = D3D11_USAGE_STAGING;
+        desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        if (FAILED(m_dev->device->CreateBuffer(&desc, nullptr, &copy.staging)))
+        {
+            copy.ticket = 0u;
+            return 0u;
+        }
+    }
+    for (uint32_t p = 0; p < kPages;)
+    {
+        if (!pages[p])
+        {
+            ++p;
+            continue;
+        }
+        uint32_t end = p;
+        while (end < kPages && pages[end])
+            ++end;
+        const D3D11_BOX box{p * 8192u, 0, 0, end * 8192u, 1, 1};
+        m_dev->ctx->CopySubresourceRegion(copy.staging.Get(), 0, p * 8192u, 0, 0, m_dev->vram.Get(), 0, &box);
+        p = end;
+    }
+    m_dev->ctx->Flush();
+    copy.ticket = m_finishTicket;
+    copy.pages = pages;
+    if (m_scaling)
+        StartScaledCopy(request, m_finishTicket);
+    return m_finishTicket;
+}
+
+// The displayed buffers get scaled surfaces (from the next draws on); the shown one's rows are copied for
+// ScaleFrame, like StartFinishCopy's pages, in order after this frame's draws.
+void GSGpuBackend::StartScaledCopy(const GSPresentationRequest &request, uint64_t ticket)
+{
+    Scaling &sc = *m_scaling;
+    const uint64_t dispfb[2] = {request.dispfb1, request.dispfb2}, display[2] = {request.display1, request.display2};
+    for (int k = 0; k < 2; ++k)
+        if ((request.pmode >> k) & 1u)
+        {
+            const uint8_t psm = static_cast<uint8_t>((dispfb[k] >> 15) & 0x1Fu);
+            const uint32_t shown = static_cast<uint32_t>((dispfb[k] >> 43) & 0x7FFu) + static_cast<uint32_t>((display[k] >> 44) & 0x7FFu) + 1u;
+            if (isFrameFormat(psm))
+                ScaledSurface(static_cast<uint32_t>(dispfb[k] & 0x1FFu), static_cast<uint32_t>((dispfb[k] >> 9) & 0x3Fu), psm, true, shown);
+        }
+    const int k = (request.pmode & 1u) ? 0 : 1;
+    ScaledTarget *s = sc.find(static_cast<uint32_t>(dispfb[k] & 0x1FFu), static_cast<uint32_t>((dispfb[k] >> 9) & 0x3Fu),
+                              static_cast<uint8_t>((dispfb[k] >> 15) & 0x1Fu));
+    Scaling::Shot &shot = sc.shots[ticket % sc.shots.size()];
+    shot.ticket = 0u;
+    if (!s || ((request.pmode & 3u) == 0u))
+        return;
+    ExpandScaled(); // a surface made just now
+    const uint32_t dby = static_cast<uint32_t>((dispfb[k] >> 43) & 0x7FFu), lines = static_cast<uint32_t>((display[k] >> 44) & 0x7FFu) + 1u;
+    const uint32_t first = std::min(dby, kScaledRows) * sc.scale, end = std::min(dby + lines, kScaledRows) * sc.scale;
+    if (end <= first)
+        return;
+    const uint32_t bytes = (end - first) * s->pitch * 4u;
+    if (!shot.staging || shot.bytes < bytes)
+    {
+        D3D11_BUFFER_DESC desc{};
+        desc.ByteWidth = bytes;
+        desc.Usage = D3D11_USAGE_STAGING;
+        desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        shot.staging.Reset();
+        shot.bytes = 0u;
+        if (FAILED(m_dev->device->CreateBuffer(&desc, nullptr, &shot.staging)))
+            return;
+        shot.bytes = bytes;
+    }
+    const D3D11_BOX box{(s->offset + first * s->pitch) * 4u, 0, 0, (s->offset + end * s->pitch) * 4u, 1, 1};
+    m_dev->ctx->CopySubresourceRegion(shot.staging.Get(), 0, 0, 0, 0, m_dev->hires.Get(), 0, &box);
+    m_dev->ctx->Flush();
+    shot.ticket = ticket;
+    shot.rowFirst = first;
+    shot.rows = end - first;
+    shot.pitch = s->pitch;
+    shot.page = s->page;
+    shot.fbw = s->fbw;
+    shot.psm = s->psm;
+}
+
+// The window thread reads the FINISH copies (FinishCopyData, ScaleFrame) from staging buffers the GPU fills behind the
+// frame's draws. A blocking Map held m_mutex until the GPU had run everything queued: the GIF worker (and VU1 and the
+// game behind it) waited on the lock and the window loop took 30-130 ms at 2x in the hallway. These poll with
+// D3D11_MAP_FLAG_DO_NOT_WAIT and release the lock between tries; the copy is checked again after each wait.
+static constexpr auto kMapPoll = std::chrono::microseconds(250);
+
+bool GSGpuBackend::ScaleFrame(uint64_t ticket, const GSPresentationRequest &request, PresentationFrame &frame, std::vector<uint8_t> &spare)
+{
+    std::unique_lock<std::mutex> lock(m_mutex);
+    uint32_t w = 0, hgt = 0;
+    for (int polls = 0;; ++polls)
+    {
+        if (polls > 4000) // ~1 s: a device that stops answering never holds the presenter
+            return false;
+        if (!m_scaling || !m_dev || frame.width == 0u || frame.height == 0u || frame.usedPreferred)
+            return false;
+        Scaling &sc = *m_scaling;
+        const Scaling::Shot &shot = sc.shots[ticket % sc.shots.size()];
+        // PresentFromLocalMemory's plain cases: one circuit, or both showing the same RGB24 buffer (the merge then
+        // gives circuit 1, blend factor 255), no field interleave, the display buffer itself shown.
+        const bool en1 = (request.pmode & 1u) != 0u, en2 = (request.pmode & 2u) != 0u;
+        const bool fieldMode = (request.smode2 & 1u) != 0u && (request.smode2 & 2u) == 0u;
+        if (shot.ticket != ticket || fieldMode || (!en1 && !en2) ||
+            (en1 && en2 && (request.dispfb1 != request.dispfb2 || request.display1 != request.display2 || shot.psm != GS_PSM_CT24)))
+            return false;
+        const uint64_t dispfb = en1 ? request.dispfb1 : request.dispfb2;
+        if ((dispfb & 0x1FFu) != shot.page || ((dispfb >> 9) & 0x3Fu) != shot.fbw || ((dispfb >> 15) & 0x1Fu) != shot.psm || frame.sourceFbp != shot.page)
+            return false;
+        const uint32_t n = sc.scale, dbx = static_cast<uint32_t>((dispfb >> 32) & 0x7FFu), dby = static_cast<uint32_t>((dispfb >> 43) & 0x7FFu);
+        w = frame.width * n;
+        hgt = frame.height * n;
+        if ((dbx + frame.width) * n > shot.pitch || dby * n < shot.rowFirst || (dby + frame.height) * n > shot.rowFirst + shot.rows)
+            return false;
+        D3D11_MAPPED_SUBRESOURCE mapped{};
+        const HRESULT hr = m_dev->ctx->Map(shot.staging.Get(), 0, D3D11_MAP_READ, D3D11_MAP_FLAG_DO_NOT_WAIT, &mapped);
+        if (hr == DXGI_ERROR_WAS_STILL_DRAWING)
+        {
+            lock.unlock();
+            std::this_thread::sleep_for(kMapPoll);
+            lock.lock();
+            continue;
+        }
+        if (FAILED(hr))
+            return false;
+        // RGBA bytes straight from the staging rows, one pass (as fast as the copy it replaces: same lock time).
+        spare.resize(static_cast<size_t>(w) * hgt * 4u);
+        uint32_t *dst = reinterpret_cast<uint32_t *>(spare.data());
+        const bool color16 = shot.psm == GS_PSM_CT16 || shot.psm == GS_PSM_CT16S;
+        for (uint32_t y = 0; y < hgt; ++y, dst += w)
+        {
+            const uint32_t *src = static_cast<const uint32_t *>(mapped.pData) + static_cast<size_t>(dby * n + y - shot.rowFirst) * shot.pitch + dbx * n;
+            if (color16) // CopyFrameToHostRgba's 5551 expansion
+                for (uint32_t x = 0; x < w; ++x)
+                {
+                    const uint32_t v = src[x], r = v & 31u, g = (v >> 5) & 31u, b = (v >> 10) & 31u;
+                    dst[x] = ((r << 3) | (r >> 2)) | (((g << 3) | (g >> 2)) << 8) | (((b << 3) | (b >> 2)) << 16) | 0xFF000000u;
+                }
+            else
+                for (uint32_t x = 0; x < w; ++x)
+                    dst[x] = src[x] | 0xFF000000u; // R, G, B, 255
+        }
+        m_dev->ctx->Unmap(shot.staging.Get(), 0);
+        break;
+    }
+    lock.unlock();
+    frame.pixels.swap(spare);
+    frame.width = w;
+    frame.height = hgt;
+    return true;
+}
+
+bool GSGpuBackend::FinishCopyData(uint64_t ticket, std::vector<uint8_t> &out)
+{
+    std::unique_lock<std::mutex> lock(m_mutex);
+    for (int polls = 0;; ++polls)
+    {
+        if (!m_dev || polls > 4000) // ~1 s at most (see ScaleFrame)
+            return false;
+        Device::FinishCopy &copy = m_dev->finishCopies[ticket % m_dev->finishCopies.size()];
+        if (copy.ticket != ticket)
+            return false;
+        D3D11_MAPPED_SUBRESOURCE mapped{};
+        const HRESULT hr = m_dev->ctx->Map(copy.staging.Get(), 0, D3D11_MAP_READ, D3D11_MAP_FLAG_DO_NOT_WAIT, &mapped);
+        if (hr == DXGI_ERROR_WAS_STILL_DRAWING)
+        {
+            lock.unlock();
+            std::this_thread::sleep_for(kMapPoll);
+            lock.lock();
+            continue;
+        }
+        if (FAILED(hr))
+            return false;
+        out.resize(kVramBytes);
+        for (uint32_t p = 0; p < kPages; ++p)
+            if (copy.pages[p])
+                std::memcpy(out.data() + p * 8192u, static_cast<const uint8_t *>(mapped.pData) + p * 8192u, 8192u);
+        m_dev->ctx->Unmap(copy.staging.Get(), 0);
+        return true;
+    }
+}
+
+PresentationFrame GSGpuBackend::Present(const GSPresentationRequest &request)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_dev)
+        NeedCpu();
+    return m_cpu.Present(request);
+}
+
+bool GSGpuBackend::ClearFramebuffer(const GSContext &context, uint32_t rgba)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_dev)
+        NeedCpu();
+    m_cpuNewer = true;
+    ++m_cpuOps;
+    return m_cpu.ClearFramebuffer(context, rgba);
+}
+
+uint32_t GSGpuBackend::ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes)
+{
+    return m_cpu.ConsumeLocalToHostBytes(dst, maxBytes);
+}
+
+uint32_t GSGpuBackend::ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_dev)
+        NeedCpu();
+    return m_cpu.ReadVram(psm, base, bw, x, y);
+}
+
+void GSGpuBackend::WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_dev)
+        NeedCpu();
+    m_cpu.WriteVram(psm, base, bw, x, y, value);
+    m_cpuNewer = true;
+    ++m_cpuOps;
+}
+
+void GSGpuBackend::SnapshotVram(std::vector<uint8_t> &out) const
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (m_dev)
+        NeedCpu();
+    m_cpu.SnapshotVram(out);
+}
