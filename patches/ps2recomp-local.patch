+                b.vertices[1].u = static_cast<uint16_t>((u0 + w) * 16u);
+                b.vertices[1].v = static_cast<uint16_t>((v0 + hgt) * 16u);
+            }
+            const uint64_t gpuBefore = gpu.m_gpuDraws;
+            cpu.Submit(b);
+            gpu.Submit(b);
+            std::snprintf(what, sizeof(what), "%s fpsm %x zpsm %x fbmsk %x zmsk %u test %llx alpha %llx abe %u fge %u iip %u pabe %u fba %llu",
+                          sprite ? "sprite" : lineKind == 1u ? "line" : lineKind == 2u ? "point" : "triangle", ctx.frame.psm, ctx.zbuf.psm, ctx.frame.fbmsk, ctx.zbuf.zmask ? 1u : 0u,
