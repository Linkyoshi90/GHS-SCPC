+// GHS-TRACE: GHS_GS_GPU_TIMING=1: GPU time of the runs (timestamps at a run's start, after its CLUT dispatch, its
+// 1x draws, its refills and at its end), averaged over 20 FINISH, and the runs above 0.3 ms of one frame. Waits for
+// the GPU at FINISH.
+struct GpuTiming
+{
+    struct Mark
+    {
+        ComPtr<ID3D11Query> query;
+        uint32_t draws, tiles, loads;
+    };
+    std::vector<Mark> marks;
+    ComPtr<ID3D11Query> disjoint;
+    double runMs = 0.0, clutMs = 0.0, drawMs = 0.0, expandMs = 0.0, scaledMs = 0.0;
+    int frames = 0;
+    void Add(ID3D11Device *dev, ID3D11DeviceContext *ctx, uint32_t draws = 0, uint32_t tiles = 0, uint32_t loads = 0)
+    {
+        D3D11_QUERY_DESC desc{D3D11_QUERY_TIMESTAMP_DISJOINT, 0};
+        if (!disjoint && SUCCEEDED(dev->CreateQuery(&desc, &disjoint)))
+            ctx->Begin(disjoint.Get());
+        Mark m{nullptr, draws, tiles, loads};
+        desc.Query = D3D11_QUERY_TIMESTAMP;
+        if (SUCCEEDED(dev->CreateQuery(&desc, &m.query)))
+            ctx->End(m.query.Get());
+        marks.push_back(m);
+    }
+    void Drop() // the device's queries, after a device loss
+    {
+        marks.clear();
+        disjoint.Reset();
+    }
+    void Report(ID3D11DeviceContext *ctx)
+    {
+        if (!disjoint)
+            return;
+        ctx->End(disjoint.Get());
+        D3D11_QUERY_DATA_TIMESTAMP_DISJOINT dj{};
+        while (ctx->GetData(disjoint.Get(), &dj, sizeof(dj), 0) == S_FALSE) {}
+        std::vector<uint64_t> t(marks.size());
+        for (size_t i = 0; i < marks.size(); ++i)
+            while (marks[i].query && ctx->GetData(marks[i].query.Get(), &t[i], 8, 0) == S_FALSE) {}
+        const double ms = 1000.0 / static_cast<double>(std::max<uint64_t>(dj.Frequency, 1u));
+        const auto span = [&](size_t a, size_t b) { return static_cast<double>(t[b] - t[a]) * ms; };
+        for (size_t i = 0; i + 4 < marks.size(); i += 5)
+        {
+            runMs += span(i, i + 4);
+            clutMs += span(i, i + 1);
+            drawMs += span(i + 1, i + 2);
+            expandMs += span(i + 2, i + 3);
+            scaledMs += span(i + 3, i + 4);
+            if (frames == 10 && span(i, i + 4) > 0.3)
+                std::fprintf(stderr, "[GHS-GSGPU] run %.2f ms GPU (CLUT %.2f, scaled %.2f): %u draws in %u tiles, %u CLUT loads\n", span(i, i + 4),
+                             span(i, i + 1), span(i + 3, i + 4), marks[i + 4].draws, marks[i + 4].tiles, marks[i + 4].loads);
+        }
+        if (++frames == 20)
+        {
+            std::fprintf(stderr, "[GHS-GSGPU] GPU time per FINISH: runs %.2f ms (CLUT dispatches %.2f, 1x draws %.2f, refills %.2f, scaled draws %.2f)\n",
+                         runMs / frames, clutMs / frames, drawMs / frames, expandMs / frames, scaledMs / frames);
+            runMs = clutMs = drawMs = expandMs = scaledMs = 0.0;
+            frames = 0;
+        }
+        marks.clear();
+        disjoint.Reset();
+    }
+};
