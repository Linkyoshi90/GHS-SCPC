+                t.tbw = 2u;
+                t.tw = 7u;
+                t.th = 6u;
+                t.tfx = 1u;
+                t.tcc = static_cast<uint8_t>(rnd(2));
+                st.textureWidth = 128u;
+                st.textureHeight = 64u;
+                ctx.clamp = rnd(2) | (rnd(2) << 2);
+                const uint32_t w = 1u + rnd(60), hgt = 1u + rnd(30), u0 = rnd(128u - w), v0 = rnd(64u - hgt);
