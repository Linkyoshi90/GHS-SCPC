+        else if (code <= 0x07u) { form = Sub; broadcast = code & 3; }
+        else if (code <= 0x0Bu) { form = MulAdd; broadcast = code & 3; }
+        else if (code <= 0x0Fu) { form = MulSub; broadcast = code & 3; }
+        else if (code >= 0x18u && code <= 0x1Bu) { form = Mul; broadcast = code & 3; }
