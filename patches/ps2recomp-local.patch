+        }
+    }
+    void benchDumpFrame(GSRasterBackend &b)
+    {
+        static const char *spec = std::getenv("GHS_GS_BENCH_DUMP");
+        if (!spec)
+            return;
+        static int n = 0;
+        char prefix[260] = {};
+        unsigned fbp = 0, fbw = 0, psm = 0, w = 0, h = 0;
+        if (std::sscanf(spec, "%259[^|]|%x|%u|%x|%u|%u", prefix, &fbp, &fbw, &psm, &w, &h) != 6)
+            return;
+        b.Sync(GSSyncReason::Finish);
+        const std::string path = std::string(prefix) + "_" + std::to_string(n++) + ".ppm";
+        if (FILE *f = std::fopen(path.c_str(), "wb"))
+        {
+            std::fprintf(f, "P6\n%u %u\n255\n", w, h);
+            std::vector<uint8_t> row(static_cast<size_t>(w) * 3u);
+            for (unsigned y = 0; y < h; ++y)
+            {
+                for (unsigned x = 0; x < w; ++x)
+                {
+                    uint32_t c = b.ReadVram(psm, fbp * 32u, fbw, x, y);
+                    static const bool alphaOnly = std::getenv("GHS_GS_BENCH_DUMP_ALPHA") != nullptr; // GHS-TRACE: alpha (bit 15 / top byte) as grey
+                    if (alphaOnly)
+                        c = (psm == GS_PSM_CT16 || psm == GS_PSM_CT16S) ? ((c & 0x8000u) ? 0xFFFFFFu : 0u) : (c >> 24) * 0x010101u;
+                    else if (psm == GS_PSM_CT16 || psm == GS_PSM_CT16S)
+                        c = ((c & 0x1Fu) << 3) | (((c >> 5) & 0x1Fu) << 11) | (((c >> 10) & 0x1Fu) << 19);
+                    row[x * 3u] = static_cast<uint8_t>(c);
+                    row[x * 3u + 1u] = static_cast<uint8_t>(c >> 8);
+                    row[x * 3u + 2u] = static_cast<uint8_t>(c >> 16);
+                }
+                std::fwrite(row.data(), 1, row.size(), f);
+            }
+            std::fclose(f);
+        }
+    }
+
+    void benchReplayOnce(GSRasterBackend &b)
+    {
+        const std::vector<uint8_t> &st = g_bench.stream;
+        size_t pos = 0;
+        while (pos + 5 <= st.size())
+        {
+            const uint8_t op = st[pos];
+            uint32_t size;
+            std::memcpy(&size, &st[pos + 1], 4);
+            const uint8_t *data = &st[pos + 5];
+            pos += 5 + size;
+            const auto as = [&](auto &out) { std::memcpy(&out, data, sizeof(out)); };
+            switch (op)
+            {
+            case BSubmit:
+            {
+                GSPrimitiveBatch v;
+                as(v);
+                static const bool targets = std::getenv("GHS_GS_BENCH_TARGETS") != nullptr; // GHS-TRACE: draws per frame/Z target
+                if (targets)
+                    benchCountTarget(v);
+                b.Submit(v);
+                break;
+            }
+            case BLoadClut: { ClutArgs v; as(v); b.LoadClut(v.tex0, v.texclut); break; }
+            case BBeginTransfer:
+            {
+                GSTransferCommand v;
+                as(v);
+                static const bool targets = std::getenv("GHS_GS_BENCH_TARGETS") != nullptr; // GHS-TRACE
+                if (targets)
+                {
+                    char key[160];
+                    std::snprintf(key, sizeof(key), "transfer dir=%u dbp=0x%x dbw=%u dpsm=0x%x sbp=0x%x %ux%u", static_cast<unsigned>(v.direction),
+                                  static_cast<unsigned>(v.bitbltbuf.dbp), static_cast<unsigned>(v.bitbltbuf.dbw), static_cast<unsigned>(v.bitbltbuf.dpsm),
+                                  static_cast<unsigned>(v.bitbltbuf.sbp), static_cast<unsigned>(v.trxreg.rrw), static_cast<unsigned>(v.trxreg.rrh));
+                    ++g_benchTargets[key];
+                }
+                b.BeginTransfer(v);
+                break;
+            }
+            case BUpload: b.UploadImage(data, size); break;
+            case BTextureFlush: b.TextureFlush(); break;
+            case BClear: { ClearArgs v; as(v); b.ClearFramebuffer(v.context, v.rgba); break; }
+            case BWriteVram: { WriteArgs v; as(v); b.WriteVram(v.psm, v.base, v.bw, v.x, v.y, v.value); break; }
+            case BFinish:
+            {
+                b.Sync(GSSyncReason::Finish);
+                benchDumpFrame(b);
+                static const bool perFrame = std::getenv("GHS_GS_TEXSTATS_FRAMES") != nullptr; // GHS-TRACE: texture stats per frame
+                if (perFrame)
+                {
+                    void ghsTexStatsReport(); // gs_cpu_backend.cpp
+                    ghsTexStatsReport();
+                }
+                break;
+            }
+            default: break;
+            }
+        }
+    }
+    void benchRun()
+    {
+        if (const char *save = std::getenv("GHS_GS_BENCH_SAVE"))
+            if (FILE *f = std::fopen(save, "wb"))
+            {
+                const uint32_t header[3] = {static_cast<uint32_t>(g_bench.frames), static_cast<uint32_t>(g_bench.start.size()), static_cast<uint32_t>(g_bench.stream.size())};
+                std::fwrite(header, sizeof(header), 1, f);
+                std::fwrite(g_bench.start.data(), 1, g_bench.start.size(), f);
+                std::fwrite(g_bench.stream.data(), 1, g_bench.stream.size(), f);
+                std::fclose(f);
+            }
+        void gsDisableRowParallelismOnThisThread(); // gs_cpu_backend.cpp
+        gsDisableRowParallelismOnThisThread();
+        std::vector<uint8_t> vram(g_bench.start.size());
+        // GHS_GS_BENCH_THREADED=N: replay through the band threads (as in the game) and also report the
+        // bands' drawing time (run time minus cross-band barrier waits): total and the slowest band.
+        const int threadedBands = std::getenv("GHS_GS_BENCH_THREADED") ? std::atoi(std::getenv("GHS_GS_BENCH_THREADED")) : 0;
+        g_benchReplaying = true;
+        std::unique_ptr<GSRasterBackend> backend = threadedBands > 0 ? std::make_unique<GSThreadedBackend>(g_bench.make, threadedBands) : g_bench.make();
+        backend->Initialize(vram.data(), static_cast<uint32_t>(vram.size()));
+        double best = 1e30;
+        static const int passes = std::getenv("GHS_GS_BENCH_PASSES") ? std::atoi(std::getenv("GHS_GS_BENCH_PASSES")) : 5;
+        for (int pass = 0; pass < passes; ++pass)
+        {
+            std::memcpy(vram.data(), g_bench.start.data(), vram.size());
+            backend->Reset();
+            const auto t0 = std::chrono::steady_clock::now();
+            for (auto &busy : g_bandBusyUs)
+                busy.store(0);
+            for (auto &wait : g_bandBarrierUs)
+                wait.store(0);
+            benchReplayOnce(*backend);
+            (void)backend->ReadVram(0u, 0u, 1u, 0u, 0u); // waits for every band, or the GPU (its FINISH doesn't)
+            const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count() / g_bench.frames;
+            best = std::min(best, ms);
+            if (threadedBands > 0)
+            {
+                double total = 0.0, slowest = 0.0;
+                for (int k = 0; k < threadedBands && k < 16; ++k)
+                {
+                    const double work = static_cast<double>(g_bandBusyUs[k].load()) - static_cast<double>(g_bandBarrierUs[k].load());
+                    total += work;
+                    slowest = std::max(slowest, work);
+                }
+                std::fprintf(stderr, "[GHS-GSBENCH] bands: drawing %.2f ms per frame in all, slowest band %.2f ms; per band:", total / 1000.0 / g_bench.frames, slowest / 1000.0 / g_bench.frames);
+                for (int k = 0; k < threadedBands && k < 16; ++k)
+                    std::fprintf(stderr, " %.1f/%.1f", (static_cast<double>(g_bandBusyUs[k].load()) - static_cast<double>(g_bandBarrierUs[k].load())) / 1000.0 / g_bench.frames,
+                                 static_cast<double>(g_bandBarrierUs[k].load()) / 1000.0 / g_bench.frames);
+                std::fprintf(stderr, " (drawing/waiting); per frame: %.1f cross-band barriers, %.1f render-target waits\n",
+                             static_cast<double>(g_crossBarriers) / g_bench.frames, static_cast<double>(g_barriers) / g_bench.frames);
+                std::fprintf(stderr, "[GHS-GSBENCH] barrier reasons (other/growth/balance/resplit/upload-draw/transfer/upload):");
+                for (uint64_t &r : g_barrierReasons)
+                {
+                    std::fprintf(stderr, " %llu", static_cast<unsigned long long>(r));
+                    r = 0;
+                }
+                std::fprintf(stderr, "; CLUT loads resolved from upload data: %llu; decoded-texture drops sent to the bands: %llu\n",
+                             static_cast<unsigned long long>(g_clutsResolved), static_cast<unsigned long long>(g_decodedDrops));
+                g_clutsResolved = g_decodedDrops = 0;
+                g_crossBarriers = g_barriers = 0;
+            }
+            std::fprintf(stderr, "[GHS-GSBENCH] pass %d: %.2f ms per frame (%zu bytes of commands, %d frames)\n", pass, ms, g_bench.stream.size(), g_bench.frames);
+            void ghsTexStatsReport(); // gs_cpu_backend.cpp
+            ghsTexStatsReport();
+        }
+        std::fprintf(stderr, "[GHS-GSBENCH] best %.2f ms per frame\n", best);
+        uint64_t ghsGpuHiresHash(); // gs_gpu_backend.cpp
+        if (const uint64_t h = ghsGpuHiresHash())
+            std::fprintf(stderr, "[GHS-GSBENCH] scaled surfaces hash %016llx\n", static_cast<unsigned long long>(h));
+        for (const auto &[key, count] : g_benchTargets) // GHS-TRACE: GHS_GS_BENCH_TARGETS
+            std::fprintf(stderr, "[GHS-GSBENCH] target %8llu draws per pass: %s\n", static_cast<unsigned long long>(count / std::max(passes, 1)), key.c_str());
+        if (const char *out = std::getenv("GHS_GS_BENCH_IMAGE")) // final VRAM of the last pass, to compare builds
+            if (FILE *f = std::fopen(out, "wb"))
+            {
+                std::fwrite(vram.data(), 1, vram.size(), f);
+                std::fclose(f);
+            }
+        g_bench.stream.clear();
+        g_bench.start.clear();
+    }
+    bool benchReplayFile(const char *path)
+    {
+        g_bench.trigger = nullptr; // a replay never records
+        FILE *f = std::fopen(path, "rb");
+        if (!f)
+            return false;
+        uint32_t header[3] = {};
+        bool ok = std::fread(header, sizeof(header), 1, f) == 1;
+        g_bench.frames = static_cast<int>(header[0]);
+        g_bench.start.resize(header[1]);
+        g_bench.stream.resize(header[2]);
+        ok = ok && std::fread(g_bench.start.data(), 1, g_bench.start.size(), f) == g_bench.start.size() &&
+             std::fread(g_bench.stream.data(), 1, g_bench.stream.size(), f) == g_bench.stream.size();
+        std::fclose(f);
+        if (ok && g_bench.frames > 0)
+        {
+            std::thread profiler;
+            if (const char *prof = std::getenv("GHS_GS_REPLAY_PROF")) // sample a thread for 5 s while it replays: "1" = this one, else a name (GSThread3)
+            {
+                ThreadNaming::SetCurrentThreadName("GSReplay");
+                static std::wstring target;
+                target = std::string(prof) == "1" ? std::wstring(L"GSReplay") : std::wstring(prof, prof + std::strlen(prof));
+                profiler = std::thread([]()
+                                       {
+                    void ghsProfileGameThread(int seconds, const wchar_t *threadName); // Kernel/GhsStackDump.cpp
+                    std::this_thread::sleep_for(std::chrono::milliseconds(std::getenv("GHS_GS_REPLAY_PROF_DELAY") ? std::atoi(std::getenv("GHS_GS_REPLAY_PROF_DELAY")) : 1500)); // ms
+                    ghsProfileGameThread(5, target.c_str()); });
+            }
+            benchRun();
+            if (profiler.joinable())
+                profiler.join();
+        }
+        return ok;
+    }
+}
+
+GSThreadedBackend::GSThreadedBackend(const std::function<std::unique_ptr<GSRasterBackend>()> &makeInstance, int bands)
+{
+    g_bench.make = makeInstance; // GHS-TRACE
+    if (const char *replay = std::getenv("GHS_GS_REPLAY"); replay && !g_benchReplaying) // GHS-TRACE: replay a saved recording and exit
+    {
+        std::fprintf(stderr, "[GHS-GSBENCH] replay %s: %s\n", replay, benchReplayFile(replay) ? "done" : "could not read");
+        std::exit(0);
+    }
+    bands = std::clamp(bands, 1, 16);
+    for (int i = 0; i < bands; ++i)
+    {
+        auto band = std::make_unique<Band>();
+        band->backend = makeInstance();
+        band->index = i;
+        Band *raw = band.get();
+        band->worker = std::thread([raw, i]()
+                                   {
+            ThreadNaming::SetCurrentThreadName(i == 0 ? "GSThread" : ("GSThread" + std::to_string(i)).c_str());
+            ghsPlaceThread(false);
+            void gsDisableRowParallelismOnThisThread(); // gs_cpu_backend.cpp
+            gsDisableRowParallelismOnThisThread();
+            workerLoop(*raw); });
+        m_bands.push_back(std::move(band));
+    }
+    splitRows(kBandedRows);
+}
+
+// Band k's rows of a target `rows` high (inclusive; the first/last band also take anything above/below).
+void GSThreadedBackend::bandRange(size_t band, int rows, int &begin, int &end) const
+{
+    const double *weights = m_rowShare;
+    const size_t bands = m_bands.size();
+    double total = 0.0, before = 0.0;
+    for (size_t i = 0; i < bands; ++i)
+    {
+        total += weights[i];
+        if (i < band)
+            before += weights[i];
+    }
+    begin = band == 0 ? -32768 : static_cast<int>(rows * before / total + 0.5);
+    end = band + 1 == bands ? 32767 : static_cast<int>(rows * (before + weights[band]) / total + 0.5) - 1;
+}
+
+// The split height of the target a draw writes: its frame (and Z) buffer page's rows, rounded up to 16
+// and at least 64. Fixed once chosen, so a pixel stays with one band; a draw reaching lower first
+// waits for every band (cross-band barrier) and then the height grows.
+int GSThreadedBackend::splitRowsFor(uint32_t fbp, uint32_t zbp, bool usesZ, int bottomRow)
+{
+    const int need = std::clamp((bottomRow + 1 + 15) / 16 * 16, 64, kBandedRows);
+    int &frameRows = m_targetRows[fbp];
+    int rows = std::max(frameRows, need);
+    int *zRows = usesZ ? &m_targetRows[zbp | 0x80000000u] : nullptr;
+    if (zRows)
+        rows = std::max(rows, *zRows);
+    const bool grew = (frameRows != 0 && frameRows != rows) || (zRows && *zRows != 0 && *zRows != rows);
+    if (grew)
+        { g_barrierReason = 1; crossBandBarrier(); } // GHS-TRACE reason
+    if (frameRows != rows) // GHS-TRACE: target heights
+    {
+        static int logged = 0;
+        if (logged++ < 40)
+            std::fprintf(stderr, "[GHS-TARGET] fbp 0x%x zbp 0x%x z=%d rows %d -> %d\n", fbp, zbp, usesZ ? 1 : 0, frameRows, rows);
+    }
+    frameRows = rows;
+    if (zRows)
+        *zRows = rows;
+    return rows;
+}
+
+// Rows cost different amounts (the room's lower half has most of the sprites), so equal row counts
+// leave bands waiting at every barrier for the slowest. Every 16 frames each band's share of the rows
+// moves toward equal drawing time (the square root of the needed factor, so it settles instead of
+// swinging); new shares take effect behind a cross-band barrier, as pixels change bands.
+void GSThreadedBackend::balanceRowShares()
+{
+    static const bool enabled = !std::getenv("GHS_GS_NO_BALANCE"); // GHS-TRACE: =1 for equal shares
+    const size_t bands = std::min<size_t>(m_bands.size(), 16u);
+    double work[16] = {};
+    double total = 0.0;
+    for (size_t k = 0; k < bands; ++k)
+    {
+        work[k] = std::max(1.0, static_cast<double>(m_bands[k]->drawUs.exchange(0, std::memory_order_relaxed)));
+        total += work[k];
+    }
+    if (!enabled || bands < 2)
+        return;
+    const double average = total / static_cast<double>(bands);
+    double next[16] = {}, sum = 0.0;
+    for (size_t k = 0; k < bands; ++k)
+    {
+        next[k] = std::clamp(m_rowShare[k] * std::sqrt(average / work[k]), 0.25, 4.0);
+        sum += next[k];
+    }
+    bool changed = false;
+    for (size_t k = 0; k < bands; ++k)
+    {
+        next[k] *= static_cast<double>(bands) / sum;
+        changed = changed || std::abs(next[k] - m_rowShare[k]) > 0.03 * m_rowShare[k];
+    }
+    if (!changed)
+        return;
+    { g_barrierReason = 2; crossBandBarrier(); } // GHS-TRACE reason
+    for (size_t k = 0; k < bands; ++k)
+        m_rowShare[k] = next[k];
+    static int logged = 0; // GHS-TRACE
+    if (logged++ < 30)
+    {
+        std::fprintf(stderr, "[GHS-GSSPLIT] row shares:");
+        for (size_t k = 0; k < bands; ++k)
+            std::fprintf(stderr, " %.2f", m_rowShare[k]);
+        std::fprintf(stderr, "\n");
+    }
+}
+
+void GSThreadedBackend::splitRows(int rows)
+{
+    m_splitRows = rows;
+    const int bands = static_cast<int>(m_bands.size());
+    // GHS-TRACE (experiment): GHS_GS_SPLIT=w0,w1,... gives band i a share of the rows proportional to wi.
+    static const std::vector<double> weights = [bands]()
+    {
+        std::vector<double> w(static_cast<size_t>(bands), 1.0);
+        if (const char *e = std::getenv("GHS_GS_SPLIT"))
+        {
+            size_t k = 0;
+            for (const char *c = e; *c && k < w.size(); ++k)
+            {
+                w[k] = std::max(0.05, std::atof(c));
+                while (*c && *c != ',')
+                    ++c;
+                if (*c == ',')
+                    ++c;
+            }
+        }
+        return w;
+    }();
+    double total = 0.0;
+    for (int i = 0; i < bands; ++i)
+        total += weights[static_cast<size_t>(i)];
+    double acc = 0.0;
+    int begin = 0;
+    for (int i = 0; i < bands; ++i)
+    {
+        acc += weights[static_cast<size_t>(i)];
+        const int end = i == bands - 1 ? rows : static_cast<int>(rows * acc / total + 0.5);
+        m_bands[i]->rowBegin = i == 0 ? -32768 : begin;
+        m_bands[i]->rowEnd = i == bands - 1 ? 32767 : end - 1;
+        begin = end;
+    }
+}
+
+GSThreadedBackend::~GSThreadedBackend()
+{
+    for (auto &band : m_bands)
+    {
+        {
+            std::lock_guard<std::mutex> lock(band->mutex);
+            band->stop = true;
+        }
+        band->workCv.notify_all();
+    }
+    for (auto &band : m_bands)
+        band->worker.join();
+}
+
+void GSThreadedBackend::workerLoop(Band &band)
+{
+    for (;;)
+    {
+        std::function<void()> work;
+        {
+            std::unique_lock<std::mutex> lock(band.mutex);
+            band.workCv.wait(lock, [&band]() { return band.stop || !band.queue.empty(); });
+            if (band.queue.empty())
+                return; // stopping, nothing left
+            work = std::move(band.queue.front());
+            band.queue.pop_front();
+        }
+        const auto t0 = std::chrono::steady_clock::now();
+        work();
+        band.drawUs.fetch_add(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count(), std::memory_order_relaxed);
+        g_bandBusyUs[band.index & 15].fetch_add(static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count())); // GHS-TRACE
+        {
+            std::lock_guard<std::mutex> lock(band.mutex);
+            ++band.finished;
+        }
+        band.doneCv.notify_all();
+    }
+}
+
+// Primitives go to the bands in batches (copy + heap allocation + lock + wake-up per primitive and
+// band was a noticeable part of the game thread). A band's pending primitives are flushed before
+// anything else is queued to it, and all bands before barriers, waits and FINISH, so every band
+// still runs its commands in submission order. Other threads (the presentation's drain) don't
+// flush: for them the pending primitives simply haven't been submitted yet.
+void GSThreadedBackend::flushBand(Band &band) const
+{
+    if (band.pending.empty())
+        return;
+    GSRasterBackend *backend = band.backend.get();
+    Band *owner = &band;
+    const uint64_t index = enqueueRaw(band, [backend, owner, commands = std::move(band.pending)]() mutable
+               {
+                   for (const PendingCommand &command : commands)
+                   {
+                       if (command.kind == PendingCommand::ClutLoad)
+                       {
+                           if (command.clutValues)
+                               backend->LoadClutValues(command.tex0, command.texclut, command.clutValues->data());
+                           else
+                               backend->LoadClut(command.tex0, command.texclut);
+                       }
+                       else if (command.kind == PendingCommand::TextureFlush)
+                           backend->InvalidateTextureRange(command.rangeBegin, command.rangeEnd, command.keepTopByteTextures);
+                       else
+                           backend->Submit(command.batch);
+                   }
+                   // Hand the buffer back: a fresh 128-command vector per batch and band was a heap
+                   // allocation of tens of KB each time on the game thread.
+                   commands.clear();
+                   std::lock_guard<std::mutex> lock(owner->mutex);
+                   owner->spare.push_back(std::move(commands));
+               });
+    std::vector<PendingCommand> next;
+    {
+        std::lock_guard<std::mutex> lock(band.mutex);
+        if (!band.spare.empty())
+        {
+            next = std::move(band.spare.back());
+            band.spare.pop_back();
+        }
+    }
+    if (next.capacity() < kPrimitivesPerBatch)
+        next.reserve(kPrimitivesPerBatch);
+    band.pending = std::move(next);
+    // Render targets this batch drew into: their fence for this band is this batch.
+    const uint32_t bit = 1u << (band.index & 15);
+    for (RenderTarget &target : m_renderTargets)
+        if (target.pendingBands & bit)
+        {
+            target.fence[band.index & 15] = index;
+            target.pendingBands &= ~bit;
+        }
+}
+
+void GSThreadedBackend::flushAll() const
+{
+    if (m_submitThread.load(std::memory_order_relaxed) != std::this_thread::get_id())
+        return;
+    for (const auto &band : m_bands)
+        flushBand(*band);
+}
+
+void GSThreadedBackend::enqueue(Band &band, std::function<void()> work) const
+{
+    if (m_submitThread.load(std::memory_order_relaxed) == std::this_thread::get_id())
+        flushBand(band);
+    enqueueRaw(band, std::move(work));
+}
+
+uint64_t GSThreadedBackend::enqueueRaw(Band &band, std::function<void()> work) const
+{
+    uint64_t index;
+    {
+        std::unique_lock<std::mutex> lock(band.mutex);
+        if (band.queued - band.finished > kMaxPending)
+            band.doneCv.wait(lock, [&band]() { return band.queued - band.finished <= kMaxPending / 2u; });
+        band.queue.push_back(std::move(work));
+        index = ++band.queued;
+    }
+    band.workCv.notify_one();
+    return index;
+}
+
+void GSThreadedBackend::broadcast(const std::function<void(GSRasterBackend &)> &work)
+{
+    for (auto &band : m_bands)
+    {
+        GSRasterBackend *backend = band->backend.get();
+        enqueue(*band, [backend, work]() { work(*backend); });
+    }
+}
+
+void GSThreadedBackend::drainAll() const
+{
+    flushAll();
+    for (const auto &band : m_bands)
+    {
+        std::unique_lock<std::mutex> lock(band->mutex);
+        const uint64_t target = band->queued;
+        band->doneCv.wait(lock, [&band, target]() { return band->finished >= target; });
+    }
+}
+
+// A draw samples a render target other bands drew into: each band waits until every other band ran its
+// last batch drawing into that target (not everything queued, as crossBandBarrier does: the light map
+// is drawn early in the frame, so its batches have usually run long before). The caller doesn't wait.
+void GSThreadedBackend::waitForTarget(RenderTarget &target)
+{
+    for (auto &band : m_bands)
+        if (target.pendingBands & (1u << (band->index & 15)))
+            flushBand(*band); // assigns its fence
+    auto fences = std::make_shared<std::vector<uint64_t>>(m_bands.size(), 0u);
+    for (size_t k = 0; k < m_bands.size() && k < 16u; ++k)
+        if (target.drawnBands & (1u << k))
+            (*fences)[k] = target.fence[k];
+    for (size_t b = 0; b < m_bands.size(); ++b)
+    {
+        enqueue(*m_bands[b], [this, fences, b]()
+                {
+            const auto t0 = std::chrono::steady_clock::now(); // GHS-TRACE
+            for (size_t k = 0; k < m_bands.size(); ++k)
+            {
+                if (k == b || (*fences)[k] == 0u)
+                    continue;
+                Band &other = *m_bands[k];
+                std::unique_lock<std::mutex> lock(other.mutex);
+                other.doneCv.wait(lock, [&other, &fences, k]() { return other.finished >= (*fences)[k]; });
+            }
+            g_bandBarrierUs[b & 15].fetch_add(static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count()));
+            m_bands[b]->drawUs.fetch_sub(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count(), std::memory_order_relaxed); });
+    }
+    target.drawnBands = 0u;
+    target.pendingBands = 0u;
+}
+
+void GSThreadedBackend::crossBandBarrier()
+{
+    m_readSinceBarrier.clear();
+    m_uploadedSinceBarrier.clear();
+    m_band0WrittenSinceBarrier.clear();
+    ++g_crossBarriers; // GHS-TRACE
+    ++g_barrierReasons[g_barrierReason & 7];
+    g_barrierReason = 0;
+    // Every band waits (on its worker) until all other bands have run what is queued now; the
+    // caller doesn't wait. Each wait only depends on earlier commands, so this can't deadlock.
+    flushAll();
+    auto fences = std::make_shared<std::vector<uint64_t>>(m_bands.size());
+    for (size_t k = 0; k < m_bands.size(); ++k)
+    {
+        std::lock_guard<std::mutex> lock(m_bands[k]->mutex);
+        (*fences)[k] = m_bands[k]->queued;
+    }
+    for (size_t b = 0; b < m_bands.size(); ++b)
+    {
+        enqueue(*m_bands[b], [this, fences, b]()
+                {
+            const auto t0 = std::chrono::steady_clock::now(); // GHS-TRACE
+            for (size_t k = 0; k < m_bands.size(); ++k)
+            {
+                if (k == b)
+                    continue;
+                Band &other = *m_bands[k];
+                std::unique_lock<std::mutex> lock(other.mutex);
+                other.doneCv.wait(lock, [&other, &fences, k]() { return other.finished >= (*fences)[k]; });
+            }
+            g_bandBarrierUs[b & 15].fetch_add(static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count()));
+            m_bands[b]->drawUs.fetch_sub(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - t0).count(), std::memory_order_relaxed); });
+    }
+}
+
+void GSThreadedBackend::Initialize(uint8_t *vram, uint32_t vramSize)
+{
+    drainAll();
+    g_bench.vram = vram; // GHS-TRACE
+    g_bench.vramSize = vramSize;
+    for (auto &band : m_bands)
+        band->backend->Initialize(vram, vramSize);
+}
+
+void GSThreadedBackend::Reset()
+{
+    drainAll();
+    for (auto &band : m_bands)
+        band->backend->Reset();
+    m_uploadRecords.clear(); // VRAM may have been replaced
+    m_recordingUpload = false;
+}
+
+void GSThreadedBackend::forgetUploads(uint32_t begin, uint32_t end)
+{
+    for (size_t i = 0; i < m_uploadRecords.size();)
+    {
+        if (begin < m_uploadRecords[i].end && m_uploadRecords[i].begin < end)
+        {
+            static const bool log = std::getenv("GHS_GS_UPLOADLOG") != nullptr; // GHS-TRACE
+            static int logged = 0;
+            if (log && logged++ < 20)
+                std::fprintf(stderr, "[GHS-UPLOAD] record dbp=0x%x [0x%x,0x%x) forgotten by a write to [0x%x,0x%x)\n",
+                             static_cast<unsigned>(m_uploadRecords[i].command.bitbltbuf.dbp), m_uploadRecords[i].begin, m_uploadRecords[i].end, begin, end);
+            if (m_recordingUpload && i + 1u == m_uploadRecords.size())
+                m_recordingUpload = false;
+            m_uploadRecords.erase(m_uploadRecords.begin() + static_cast<std::ptrdiff_t>(i));
+        }
+        else
+            ++i;
+    }
+}
+
+// Every entry LoadClut would read, from a recorded upload of the same buffer (base, width, format) that
+// wrote that pixel; false if any entry isn't covered (then the bands read VRAM as before).
+bool GSThreadedBackend::resolveClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut, std::array<uint32_t, 256> &raws) const
+{
+    static const bool disabled = std::getenv("GHS_GS_NO_CLUT_RESOLVE") != nullptr; // GHS-TRACE: =1 for the old way
+    if (disabled || m_uploadRecords.empty())
+        return false;
+    if (tex0.cpsm != GS_PSM_CT32 && tex0.cpsm != GS_PSM_CT16 && tex0.cpsm != GS_PSM_CT16S)
+        return false;
+    uint32_t firstEntry = 0, entryCount = 0;
+    bool valid = false;
+    GSCpuBackend::ClutLayout(tex0, firstEntry, entryCount, valid);
+    if (!valid)
+        return false;
+    for (uint32_t entry = firstEntry; entry < entryCount; ++entry)
+    {
+        uint32_t x = 0, y = 0, width = 1;
+        GSCpuBackend::ClutSourcePixel(tex0, texclut, entry, x, y, width);
+        bool found = false;
+        for (auto it = m_uploadRecords.rbegin(); it != m_uploadRecords.rend() && !found; ++it)
+        {
+            const auto &c = it->command;
+            if (c.bitbltbuf.dbp != tex0.cbp || std::max<uint32_t>(c.bitbltbuf.dbw, 1u) != width || c.bitbltbuf.dpsm != tex0.cpsm)
+                continue;
+            const uint32_t dx = static_cast<uint32_t>(c.trxpos.dsax), dy = static_cast<uint32_t>(c.trxpos.dsay);
+            if (x < dx || y < dy || x - dx >= c.trxreg.rrw || y - dy >= c.trxreg.rrh)
+                continue;
+            const size_t offset = (static_cast<size_t>(y - dy) * c.trxreg.rrw + (x - dx)) * it->bytesPerPixel;
+            if (offset + it->bytesPerPixel > it->data.size())
+                continue; // not uploaded (yet)
+            uint32_t value = 0;
+            std::memcpy(&value, it->data.data() + offset, it->bytesPerPixel);
+            raws[entry] = value;
+            found = true;
+        }
+        if (!found)
+        {
+            static const bool log = std::getenv("GHS_GS_UPLOADLOG") != nullptr; // GHS-TRACE
+            static int logged = 0;
+            if (log && logged++ < 20)
+            {
+                std::fprintf(stderr, "[GHS-UPLOAD] CLUT not resolved: cbp=0x%x cpsm=0x%x csm=%u entry %u at %u,%u (w %u); records:",
+                             static_cast<unsigned>(tex0.cbp), static_cast<unsigned>(tex0.cpsm), static_cast<unsigned>(tex0.csm), entry, x, y, width);
+                for (const auto &r : m_uploadRecords)
+                    std::fprintf(stderr, " dbp=0x%x dbw=%u dpsm=0x%x %ux%u@%u,%u (%zu/%u bytes)", static_cast<unsigned>(r.command.bitbltbuf.dbp),
+                                 static_cast<unsigned>(r.command.bitbltbuf.dbw), static_cast<unsigned>(r.command.bitbltbuf.dpsm),
+                                 static_cast<unsigned>(r.command.trxreg.rrw), static_cast<unsigned>(r.command.trxreg.rrh),
+                                 static_cast<unsigned>(r.command.trxpos.dsax), static_cast<unsigned>(r.command.trxpos.dsay), r.data.size(), r.bytesExpected);
+                std::fprintf(stderr, "\n");
+            }
+            return false;
+        }
+    }
+    return true;
+}
+
+void GSThreadedBackend::Submit(const GSPrimitiveBatch &batch)
+{
+    if (g_bench.recording) benchPut(BSubmit, batch); // GHS-TRACE
+    // Render to texture: a draw that samples a frame buffer other bands may still be drawing into
+    // (the room's light map at FBP 0xF0, read as TBP0 0x1E00) waits for all bands first. Targets
+    // are tracked by the rows actually drawn, so textures stored next to them don't trigger it.
+    const auto &context = batch.state.context;
+    ++g_submits; // GHS-TRACE
+    ghsReportWaits(); // GHS-TRACE
+    if (m_submitThread.load(std::memory_order_relaxed) != std::this_thread::get_id())
+    {
+        flushAll(); // only acts on the previous submitting thread's batches if called from it
+        m_submitThread.store(std::this_thread::get_id(), std::memory_order_relaxed);
+    }
+    if (m_resplitPending && stripeRows() == 0)
+    {
+        // Rows that change bands: a band must not draw a row before the band that had it finished
+        // the earlier draws there, so the change goes behind a cross-band barrier. Split by the
+        // tallest of the last 16 frames, so alternating frame heights don't move rows every frame.
+        m_resplitPending = false;
+        const int maxRow = *std::max_element(std::begin(m_recentMaxRows), std::end(m_recentMaxRows));
+        const int rows = std::clamp((maxRow + 1 + 15) / 16 * 16, 64, kBandedRows);
+        if (maxRow >= 0 && rows != m_splitRows)
+        {
+            { g_barrierReason = 3; crossBandBarrier(); } // GHS-TRACE reason
+            splitRows(rows);
+        }
+    }
+    if (batch.state.prim.tme)
+    {
+        const uint32_t texturePage = static_cast<uint32_t>(context.tex0.tbp0) / 32u;
+        // T8H/T4HL/T4HH read only the top byte of 32-bit pixels (the game keeps its UI font in the
+        // alpha byte of frame buffer 0x50): no hazard unless something wrote that byte.
+        const uint32_t texturePsm = static_cast<uint32_t>(context.tex0.psm);
+        const bool readsTopByteOnly = texturePsm == 0x1Bu || texturePsm == 0x24u || texturePsm == 0x2Cu;
+        for (const RenderTarget &target : m_renderTargets)
+        {
+            if (readsTopByteOnly && !target.wroteTopByte)
+                continue;
+            const uint32_t rowsPerPage = target.sixteenBit ? 64u : 32u;
+            const uint32_t pages = target.fbw * ((target.maxRow + rowsPerPage) / rowsPerPage);
+            if (texturePage >= target.fbp && texturePage < target.fbp + pages && target.drawnBands != 0u)
+            {
+                GhsWaitTimer timer{g_waitBarrierMs}; // GHS-TRACE
+                ++g_barriers;                       // GHS-TRACE
+                waitForTarget(const_cast<RenderTarget &>(target));
+                break;
+            }
+        }
+    }
+    // Rows the primitive can touch (window coordinates, with a pixel of slack); a band outside
+    // them gets nothing.
+    const auto &scissor = batch.state.context.scissor;
+    size_t drawTarget = 0; // its entry in m_renderTargets
+    const float offsetY = static_cast<float>(batch.state.context.xyoffset.ofy >> 4);
+    float minY = batch.vertices[0].y, maxY = batch.vertices[0].y;
+    for (uint32_t i = 1; i < std::max<uint32_t>(batch.vertexCount, 1u) && i < batch.vertices.size(); ++i)
+    {
+        minY = std::min(minY, batch.vertices[i].y);
+        maxY = std::max(maxY, batch.vertices[i].y);
+    }
+    const int primTop = std::max(static_cast<int>(std::floor(minY - offsetY)) - 1, static_cast<int>(scissor.y0));
+    const int primBottom = std::min(static_cast<int>(std::ceil(maxY - offsetY)) + 1, static_cast<int>(scissor.y1));
+    m_frameMaxRow = std::max(m_frameMaxRow, primBottom);
+    {
+        const uint32_t fbp = static_cast<uint32_t>(context.frame.fbp);
+        const uint32_t fbw = std::max<uint32_t>(context.frame.fbw, 1u);
+        const bool sixteenBit = (context.frame.psm & 0x2u) != 0u; // CT16/CT16S (0x02/0x0A)
+        const uint32_t bottom = static_cast<uint32_t>(std::max(primBottom, 0));
+        auto it = std::find_if(m_renderTargets.begin(), m_renderTargets.end(), [&](const RenderTarget &target)
+                               { return target.fbp == fbp && target.fbw == fbw && target.sixteenBit == sixteenBit; });
+        // Top byte written: 32-bit target (CT32 or Z32) with the alpha byte not masked by FBMSK.
+        const bool wroteTopByte = (context.frame.psm == 0x00u || context.frame.psm == 0x30u) &&
+                                  (static_cast<uint32_t>(context.frame.fbmsk) & 0xFF000000u) != 0xFF000000u;
+        if (it == m_renderTargets.end())
+        {
+            m_renderTargets.push_back(RenderTarget{fbp, fbw, bottom, sixteenBit, wroteTopByte});
+            drawTarget = m_renderTargets.size() - 1u;
+        }
+        else
+        {
+            it->maxRow = std::max(it->maxRow, bottom);
+            it->wroteTopByte = it->wroteTopByte || wroteTopByte;
+            drawTarget = static_cast<size_t>(it - m_renderTargets.begin());
+        }
+    }
+    {
+        // Uploads run on every band without barriers (UploadImage): a draw writing VRAM one of them wrote
+        // since the last barrier must not run before a slower band's copy of that upload.
+        const auto pageEnd = [](uint32_t begin, uint32_t pagesPerRow, uint32_t rows) { return begin + pagesPerRow * ((rows + 31u) / 32u) * 8192u; };
+        const uint32_t ppr = std::max<uint32_t>(context.frame.fbw, 1u), drawRows = static_cast<uint32_t>(scissor.y1) + 1u;
+        const uint32_t fb = context.frame.fbp * 8192u, zb = context.zbuf.zbp * 8192u;
+        const auto uploaded = [this](uint32_t begin, uint32_t end)
+        { return m_uploadedSinceBarrier.overlaps(begin, end) || m_band0WrittenSinceBarrier.overlaps(begin, end); };
+        if (uploaded(fb, pageEnd(fb, ppr, drawRows)) || (!context.zbuf.zmask && uploaded(zb, pageEnd(zb, ppr, drawRows))))
+            { g_barrierReason = 4; crossBandBarrier(); } // GHS-TRACE reason
+    }
+    {
+        // Decoded-texel caches: same conservative page ranges as GSCpuBackend::DrawPrimitive.
+        const auto pageRowsEnd = [](uint32_t begin, uint32_t pagesPerRow, uint32_t rows) { return begin + pagesPerRow * ((rows + 31u) / 32u) * 8192u; };
+        const uint32_t pagesPerRow = std::max<uint32_t>(context.frame.fbw, 1u), rows = static_cast<uint32_t>(scissor.y1) + 1u;
+        const uint32_t frameBegin = context.frame.fbp * 8192u, zBegin = context.zbuf.zbp * 8192u;
+        forgetUploads(frameBegin, pageRowsEnd(frameBegin, pagesPerRow, rows)); // a draw overwrites recorded upload data
+        if (!context.zbuf.zmask)
+            forgetUploads(zBegin, pageRowsEnd(zBegin, pagesPerRow, rows));
+        dropDecodedIfSampled(frameBegin, pageRowsEnd(frameBegin, pagesPerRow, rows), context.frame.psm == GS_PSM_CT24);
+        if (!context.zbuf.zmask)
+            dropDecodedIfSampled(zBegin, pageRowsEnd(zBegin, pagesPerRow, rows), context.zbuf.psm == GS_PSM_Z24);
+        if (batch.state.prim.tme)
+        {
+            const auto &tex = context.tex0;
+            const uint32_t texBegin = tex.tbp0 * 256u & ~8191u;
+            const uint32_t texEnd = pageRowsEnd(texBegin, std::max<uint32_t>({tex.tbw, (batch.state.textureWidth + 63u) / 64u, 1u}), batch.state.textureHeight) + ((tex.tbp0 & 31u) != 0u ? 8192u : 0u); // a page more only if it starts mid-page
+            noteSampledTexture(texBegin, texEnd, tex.psm == GS_PSM_T8H || tex.psm == GS_PSM_T4HL || tex.psm == GS_PSM_T4HH);
+            if (m_band0WrittenSinceBarrier.overlaps(texBegin, texEnd)) // band 0 may not have run that upload yet
+                { g_barrierReason = 7; crossBandBarrier(); } // GHS-TRACE reason
+            m_readSinceBarrier.add(texBegin, texEnd);
+        }
+    }
+    if (const int stripe = stripeRows(); stripe > 0)
+    {
+        // One copy per stripe the draw reaches, clipped to it, to the stripe's band (scissor rows are never negative).
+        const size_t bands = m_bands.size();
+        for (int first = primTop / stripe * stripe; first <= primBottom; first += stripe)
+        {
+            const size_t bandIndex = static_cast<size_t>(first / stripe) % bands;
+            Band *band = m_bands[bandIndex].get();
+            if (drawTarget < m_renderTargets.size())
+            {
+                const uint32_t bit = 1u << (bandIndex & 15u);
+                m_renderTargets[drawTarget].drawnBands |= bit;
+                m_renderTargets[drawTarget].pendingBands |= bit;
+            }
+            PendingCommand &command = band->pending.emplace_back(batch);
+            command.batch.state.context.scissor.y0 = static_cast<uint16_t>(std::max(static_cast<int>(scissor.y0), first));
+            command.batch.state.context.scissor.y1 = static_cast<uint16_t>(std::min(static_cast<int>(scissor.y1), first + stripe - 1));
+            if (band->pending.size() >= kPrimitivesPerBatch)
+                flushBand(*band);
+        }
+        return;
+    }
+    static const bool perTarget = !std::getenv("GHS_GS_GLOBAL_SPLIT"); // GHS-TRACE: =1 for the old global split
+    const bool usesZ = ((context.test >> 16) & 1u) != 0u || !context.zbuf.zmask;
+    const int targetRows = perTarget ? splitRowsFor(static_cast<uint32_t>(context.frame.fbp), static_cast<uint32_t>(context.zbuf.zbp), usesZ, primBottom) : 0;
+    for (size_t bandIndex = 0; bandIndex < m_bands.size(); ++bandIndex)
+    {
+        Band *band = m_bands[bandIndex].get();
+        int rowBegin = band->rowBegin, rowEnd = band->rowEnd;
+        if (perTarget)
+            bandRange(bandIndex, targetRows, rowBegin, rowEnd);
+        const int top = std::max(primTop, rowBegin);
+        const int bottom = std::min(primBottom, rowEnd);
+        if (top > bottom)
+            continue;
+        if (drawTarget < m_renderTargets.size())
+        {
+            const uint32_t bit = 1u << (bandIndex & 15u);
+            m_renderTargets[drawTarget].drawnBands |= bit;
+            m_renderTargets[drawTarget].pendingBands |= bit;
+        }
+        PendingCommand &command = band->pending.emplace_back(batch); // one copy, clipped in place
+        command.batch.state.context.scissor.y0 = static_cast<uint16_t>(std::max(static_cast<int>(scissor.y0), rowBegin));
+        command.batch.state.context.scissor.y1 = static_cast<uint16_t>(std::min(static_cast<int>(scissor.y1), rowEnd));
+        if (band->pending.size() >= kPrimitivesPerBatch)
+            flushBand(*band);
+    }
+}
+
+void GSThreadedBackend::LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut)
+{
+    if (g_bench.recording) benchPut(BLoadClut, ClutArgs{tex0, texclut}); // GHS-TRACE
+    if (m_submitThread.load(std::memory_order_relaxed) == std::this_thread::get_id())
+    {
+        std::array<uint32_t, 256> raws{};
+        if (resolveClut(tex0, texclut, raws))
+        {
+            ++g_clutsResolved; // GHS-TRACE
+            const auto values = std::make_shared<const std::array<uint32_t, 256>>(raws);
+            for (auto &band : m_bands)
+            {
+                PendingCommand &command = band->pending.emplace_back();
+                command.kind = PendingCommand::ClutLoad;
+                command.tex0 = tex0;
+                command.texclut = texclut;
+                command.clutValues = values;
+                if (band->pending.size() >= kPrimitivesPerBatch)
+                    flushBand(*band);
+            }
+            return; // no band reads the CLUT's VRAM: not a read for the upload barriers
+        }
+    }
+    {
+        // CSM1: a 16x16 block at CBP; CSM2: row COV of a CBW-wide buffer at CBP.
+        const uint32_t clutBegin = tex0.cbp * 256u & ~8191u;
+        const uint32_t clutRows = tex0.csm ? static_cast<uint32_t>(texclut.cov) + 1u : 16u;
+        const uint32_t clutPagesPerRow = tex0.csm ? std::max<uint32_t>(texclut.cbw, 1u) : 1u;
+        // The blocks of the entries it reads (GSCpuBackend's addressing), else the page range as before.
+        uint32_t firstEntry = 0, entryCount = 0;
+        bool valid = false;
+        GSCpuBackend::ClutLayout(tex0, firstEntry, entryCount, valid);
+        bool precise = valid;
+        RangeSet blocks;
+        for (uint32_t entry = firstEntry; precise && entry < entryCount; ++entry)
+        {
+            uint32_t x = 0, y = 0, width = 1, block = 0;
+            GSCpuBackend::ClutSourcePixel(tex0, texclut, entry, x, y, width);
+            precise = pixelBlock(tex0.cpsm, tex0.cbp, width, x, y, block);
+            if (precise)
+                blocks.add(block, block + 256u);
+        }
+        // Reads VRAM: a palette band 0 may not have uploaded yet waits for a barrier first.
+        const uint32_t clutEnd = clutBegin + clutPagesPerRow * ((clutRows + 31u) / 32u + 1u) * 8192u + 8192u;
+        bool band0Hazard = false;
+        if (precise)
+            for (const auto &r : blocks.ranges)
+                band0Hazard = band0Hazard || m_band0WrittenSinceBarrier.overlaps(r.first, r.second);
+        else
+            band0Hazard = m_band0WrittenSinceBarrier.overlaps(clutBegin, clutEnd);
+        if (band0Hazard)
+            { g_barrierReason = 7; crossBandBarrier(); } // GHS-TRACE reason
+        if (precise)
+            for (const auto &r : blocks.ranges)
+                m_readSinceBarrier.add(r.first, r.second);
+        else
+            m_readSinceBarrier.add(clutBegin, clutEnd);
+    }
+    // Batched with the primitives (a broadcast queued an entry and woke every band per CLUT load).
+    if (m_submitThread.load(std::memory_order_relaxed) != std::this_thread::get_id())
+    {
+        broadcast([tex0, texclut](GSRasterBackend &backend) { backend.LoadClut(tex0, texclut); });
+        return;
+    }
+    for (auto &band : m_bands)
+    {
+        PendingCommand &command = band->pending.emplace_back();
+        command.kind = PendingCommand::ClutLoad;
+        command.tex0 = tex0;
+        command.texclut = texclut;
+        if (band->pending.size() >= kPrimitivesPerBatch)
+            flushBand(*band);
+    }
+}
+
+// Every band drops its decoded texels from VRAM bytes [begin, end) (all of them by default), in order
+// with its queued draws (VRAM written elsewhere).
+void GSThreadedBackend::invalidateDecodedTextures(uint32_t begin, uint32_t end, bool keepTopByte)
+{
+    ++g_decodedDrops; // GHS-TRACE
+    if (begin == 0u && end == UINT32_MAX && !keepTopByte)
+        m_aliveTextures.clear();
+    else
+        forgetAliveTextures(begin, end, keepTopByte);
+    if (m_submitThread.load(std::memory_order_relaxed) != std::this_thread::get_id())
+    {
+        broadcast([begin, end, keepTopByte](GSRasterBackend &backend) { backend.InvalidateTextureRange(begin, end, keepTopByte); });
+        return;
+    }
+    for (auto &band : m_bands)
+    {
+        PendingCommand &command = band->pending.emplace_back();
+        command.kind = PendingCommand::TextureFlush;
+        command.rangeBegin = begin;
+        command.rangeEnd = end;
+        command.keepTopByteTextures = keepTopByte;
+        if (band->pending.size() >= kPrimitivesPerBatch)
+            flushBand(*band);
+    }
+}
+
+// A draw writes VRAM bytes [begin, end): the bands drop the decoded textures there, if any can be alive
+// (m_aliveTextures). A CT24/Z24 draw (keepsTopByte) can't change T8H/T4H texels, so those don't count.
+void GSThreadedBackend::dropDecodedIfSampled(uint32_t begin, uint32_t end, bool keepsTopByte)
+{
+    // Only if a texture the bands may still hold decoded overlaps the write (a draw writes its frame and
+    // its Z buffer: deciding by "the last drop" alone sent two drops per draw, ~10 k per frame).
+    for (const AliveTexture &t : m_aliveTextures)
+        if (t.begin < end && begin < t.end && !(keepsTopByte && t.topByte))
+        {
+            invalidateDecodedTextures(begin, end, keepsTopByte);
+            return;
+        }
+}
+
+// The bands drop their slots overlapping [begin, end) (except T8H/T4HL/T4HH ones if keepTopByte): so do the
+// entries here.
+void GSThreadedBackend::forgetAliveTextures(uint32_t begin, uint32_t end, bool keepTopByte)
+{
+    for (size_t i = 0; i < m_aliveTextures.size();)
+    {
+        const AliveTexture &t = m_aliveTextures[i];
+        if (t.begin < end && begin < t.end && !(keepTopByte && t.topByte))
+        {
+            m_aliveTextures[i] = m_aliveTextures.back();
+            m_aliveTextures.pop_back();
+        }
+        else
+            ++i;
+    }
+}
+
+void GSThreadedBackend::noteSampledTexture(uint32_t begin, uint32_t end, bool topByte)
+{
+    for (const AliveTexture &t : m_aliveTextures)
+        if (t.begin == begin && t.end == end && t.topByte == topByte)
+            return;
+    if (m_aliveTextures.size() >= 512u) // shouldn't happen (a band holds 64): stay bounded and safe
+        invalidateDecodedTextures(); // (clears the list)
+    m_aliveTextures.push_back({begin, end, topByte});
+}
+
+// Transfers read/write VRAM the bands draw into: band 0 runs them after every band's earlier draws,
+// and the other bands wait for it before drawing on. The caller doesn't wait (local-to-host reads
+// wait in ConsumeLocalToHostBytes).
+void GSThreadedBackend::BeginTransfer(const GSTransferCommand &command)
+{
+    ++g_transfers; // GHS-TRACE
+    if (g_bench.recording) benchPut(BBeginTransfer, command); // GHS-TRACE
+    GSRasterBackend *backend = m_bands[0]->backend.get();
+    {
+        // Destination bytes: the upload barrier logic below and the bands' decoded-texel drops.
+        const auto &b = command.bitbltbuf;
+        m_transferDestBegin = b.dbp * 256u & ~8191u;
+        const uint32_t pagesPerRow = std::max<uint32_t>({b.dbw, (static_cast<uint32_t>(command.trxpos.dsax) + command.trxreg.rrw + 63u) / 64u, 1u});
+        m_transferDestEnd = m_transferDestBegin + pagesPerRow * ((static_cast<uint32_t>(command.trxpos.dsay) + command.trxreg.rrh + 31u) / 32u + 1u) * 8192u + 8192u;
+    }
+    m_recordingUpload = false;
+    // Small host-to-local uploads (palettes): the blocks they write, instead of their page range.
+    RangeSet smallBlocks;
+    uint32_t smallBegin = 0, smallEnd = 0;
+    if (command.direction == 0u)
+    {
+        const auto &b = command.bitbltbuf;
+        const uint32_t pixels = static_cast<uint32_t>(command.trxreg.rrw) * command.trxreg.rrh;
+        uint32_t block = 0;
+        if (pixels != 0u && pixels <= 1024u && pixelBlock(b.dpsm, b.dbp, std::max<uint32_t>(b.dbw, 1u), 0u, 0u, block))
+        {
+            for (uint32_t y = 0; y < command.trxreg.rrh; ++y)
+                for (uint32_t x = 0; x < command.trxreg.rrw; ++x)
+                {
+                    pixelBlock(b.dpsm, b.dbp, std::max<uint32_t>(b.dbw, 1u), command.trxpos.dsax + x, command.trxpos.dsay + y, block);
+                    smallBlocks.add(block, block + 256u);
+                }
+            smallBegin = smallBlocks.ranges.begin()->first;
+            smallEnd = smallBlocks.ranges.rbegin()->second;
+        }
+    }
+    if (command.direction != 1u) // writes VRAM: older recorded uploads there are gone
+    {
+        if (smallEnd != 0u)
+            forgetUploads(smallBegin, smallEnd); // a repeated palette upload replaces its record, neighbours stay
+        else
+            forgetUploads(m_transferDestBegin, m_transferDestEnd);
+    }
+    if (command.direction == 0u) // record small uploads (palettes) with their data, see resolveClut
+    {
+        const uint8_t psm = command.bitbltbuf.dpsm;
+        const uint32_t bytesPerPixel = psm == GS_PSM_CT32 ? 4u : (psm == GS_PSM_CT16 || psm == GS_PSM_CT16S) ? 2u : 0u;
+        const uint32_t pixels = static_cast<uint32_t>(command.trxreg.rrw) * command.trxreg.rrh;
+        if (bytesPerPixel != 0u && pixels != 0u && pixels <= 1024u)
+        {
+            if (m_uploadRecords.size() >= 16u)
+                m_uploadRecords.erase(m_uploadRecords.begin());
+            UploadRecord &record = m_uploadRecords.emplace_back();
+            record.command = command;
+            record.begin = smallEnd != 0u ? smallBegin : m_transferDestBegin;
+            record.end = smallEnd != 0u ? smallEnd : m_transferDestEnd;
+            record.bytesPerPixel = bytesPerPixel;
+            record.bytesExpected = pixels * bytesPerPixel;
+            m_recordingUpload = true;
+        }
+    }
+    if (command.direction == 0u)
+    {
+        // Host to local only sets up the transfer: no VRAM access, so no barriers. If nothing queued
+        // since the last cross-band barrier read the destination (textures, CLUTs), every band runs the
+        // upload itself at its place in its queue (each sees the new texels after its own copy; the
+        // copies write the same bytes) and no band waits. Otherwise band 0 runs it between barriers.
+        const uint32_t begin = m_transferDestBegin, end = m_transferDestEnd;
+        static const bool barrierFree = !std::getenv("GHS_GS_UPLOAD_BARRIERS"); // GHS-TRACE: =1 for the old way
+        // Small uploads (palettes): the blocks they write instead of their page range.
+        bool readOverlap = true;
+        if (smallEnd != 0u)
+        {
+            readOverlap = false;
+            for (const auto &r : smallBlocks.ranges)
+                readOverlap = readOverlap || m_readSinceBarrier.overlaps(r.first, r.second);
+        }
+        else
+            readOverlap = m_readSinceBarrier.overlaps(begin, end);
+        // A re-upload of texels read (or uploaded) since the last barrier: one barrier now, then the per-band or
+        // band-0 copy below, instead of band 0 alone between two barriers (half the barriers: GHS's hallway
+        // re-uploads a 128x64 texture ~6 times a frame). GHS_GS_UPLOAD_TWO_BARRIERS=1: the old way.
+        static const bool oneBarrier = !std::getenv("GHS_GS_UPLOAD_TWO_BARRIERS");
+        bool needsBarrier = readOverlap;
+        if (smallEnd != 0u) // as the band-0 path below decides: band 0's own earlier copies are in order
+            for (const auto &r : smallBlocks.ranges)
+                needsBarrier = needsBarrier || m_uploadedSinceBarrier.overlaps(r.first, r.second);
+        else
+            needsBarrier = needsBarrier || m_uploadedSinceBarrier.overlaps(begin, end) || m_band0WrittenSinceBarrier.overlaps(begin, end);
+        if (barrierFree && oneBarrier && needsBarrier)
+        {
+            { g_barrierReason = 6; crossBandBarrier(); } // GHS-TRACE reason
+            readOverlap = false;
+        }
+        // A small upload nothing queued has read since the last barrier runs on band 0 alone, in its queue
+        // order (GHS's hallway re-uploads one 16-colour palette ~23 times a frame: as per-band copies each
+        // repeat needed two barriers). One writer keeps the copies in order; palette loads resolved from the
+        // upload records don't read VRAM, and any other read of those blocks waits for a barrier first
+        // (m_band0WrittenSinceBarrier in Submit/LoadClut).
+        m_uploadBand0Only = false;
+        static const bool band0Uploads = !std::getenv("GHS_GS_NO_BAND0_UPLOADS"); // GHS-TRACE: =1 for per-band palette copies
+        if (barrierFree && band0Uploads && smallEnd != 0u && !readOverlap)
+        {
+            bool allBandsOverlap = false;
+            for (const auto &r : smallBlocks.ranges)
+                allBandsOverlap = allBandsOverlap || m_uploadedSinceBarrier.overlaps(r.first, r.second);
+            if (!allBandsOverlap)
+            {
+                m_uploadOnAllBands = false;
+                m_uploadBand0Only = true;
+                ++g_uploadsBand0; // GHS-TRACE
+                for (const auto &r : smallBlocks.ranges)
+                    m_band0WrittenSinceBarrier.add(r.first, r.second);
+                dropDecodedIfSampled(smallBegin, smallEnd, false); // the other bands' decoded texels there
+                enqueue(*m_bands[0], [backend, command]() { backend->BeginTransfer(command); });
+                return;
+            }
+        }
+        // Two per-band uploads to the same bytes without a barrier between them land out of order across bands:
+        // a slow band's copy of the older upload overwrites what a fast band already drew with (GHS's lobby
+        // door: strips of the previous texture). Such an upload takes the barrier path.
+        const bool uploadOverlap = m_uploadedSinceBarrier.overlaps(begin, end) || m_band0WrittenSinceBarrier.overlaps(begin, end);
+        m_uploadOnAllBands = barrierFree && !readOverlap && !uploadOverlap;
+        static const bool uploadLog = std::getenv("GHS_GS_UPLOADLOG") != nullptr; // GHS-TRACE: which uploads take barriers
+        if (uploadLog && !m_uploadOnAllBands)
+        {
+            static int logged = 0;
+            if (logged++ < 40)
+            {
+                std::fprintf(stderr, "[GHS-UPLOAD] barrier upload dbp=0x%x dbw=%u dpsm=0x%x rect %ux%u at %u,%u -> [0x%x,0x%x); read since barrier:",
+                             static_cast<unsigned>(command.bitbltbuf.dbp), static_cast<unsigned>(command.bitbltbuf.dbw), static_cast<unsigned>(command.bitbltbuf.dpsm),
+                             static_cast<unsigned>(command.trxreg.rrw), static_cast<unsigned>(command.trxreg.rrh),
+                             static_cast<unsigned>(command.trxpos.dsax), static_cast<unsigned>(command.trxpos.dsay), begin, end);
+                for (const auto &r : m_readSinceBarrier.ranges)
+                    std::fprintf(stderr, " [0x%x,0x%x)%s", r.first, r.second, (begin < r.second && r.first < end) ? "*" : "");
+                std::fprintf(stderr, "\n");
+            }
+        }
+        if (m_uploadOnAllBands)
+        {
+            ++g_uploadsAllBands; // GHS-TRACE
+            m_uploadedSinceBarrier.add(begin, end);
+            for (auto &band : m_bands)
+            {
+                GSRasterBackend *bandBackend = band->backend.get();
+                enqueue(*band, [bandBackend, command]() { bandBackend->BeginTransfer(command); });
+            }
+        }
+        else
+            enqueue(*m_bands[0], [backend, command]() { backend->BeginTransfer(command); });
+        return;
+    }
+    m_uploadOnAllBands = false;
+    m_uploadBand0Only = false;
+    { g_barrierReason = 5; crossBandBarrier(); } // GHS-TRACE reason
+    enqueue(*m_bands[0], [backend, command]() { backend->BeginTransfer(command); });
+    if (command.direction != 1u) // writes VRAM (band 0 drops its own; the others didn't run it)
+        invalidateDecodedTextures(m_transferDestBegin, m_transferDestEnd);
+    { g_barrierReason = 5; crossBandBarrier(); } // GHS-TRACE reason
+    m_renderTargets.clear();
+}
+
+void GSThreadedBackend::UploadImage(const uint8_t *data, uint32_t sizeBytes)
+{
+    // The caller's buffer (a GIF packet) is gone by the time band 0 runs this.
+    auto copy = std::make_shared<std::vector<uint8_t>>(data, data + sizeBytes);
+    if (m_recordingUpload && !m_uploadRecords.empty())
+    {
+        // As GSCpuBackend::UploadImage consumes it: whole pixels of each call (a partial pixel at the end of a
+        // call is dropped), up to the transfer's size.
+        UploadRecord &record = m_uploadRecords.back();
+        const uint32_t whole = sizeBytes - sizeBytes % record.bytesPerPixel;
+        const uint32_t room = record.bytesExpected - static_cast<uint32_t>(record.data.size());
+        record.data.insert(record.data.end(), data, data + std::min(whole, room));
+        if (record.data.size() >= record.bytesExpected)
+            m_recordingUpload = false;
+    }
+    ++g_uploads; // GHS-TRACE
+    if (g_bench.recording) benchPutRaw(BUpload, copy->data(), static_cast<uint32_t>(copy->size())); // GHS-TRACE
+    if (m_uploadOnAllBands)
+    {
+        for (auto &band : m_bands)
+        {
+            GSRasterBackend *bandBackend = band->backend.get();
+            enqueue(*band, [bandBackend, copy]() { bandBackend->UploadImage(copy->data(), static_cast<uint32_t>(copy->size())); });
+        }
+        return; // every band runs the upload, and UploadImage drops that band's decoded texels it overwrites
+    }
+    if (m_uploadBand0Only)
+    {
+        GSRasterBackend *backend0 = m_bands[0]->backend.get();
+        enqueue(*m_bands[0], [backend0, copy]() { backend0->UploadImage(copy->data(), static_cast<uint32_t>(copy->size())); });
+        return;
+    }
+    { g_barrierReason = 6; crossBandBarrier(); } // GHS-TRACE reason
+    GSRasterBackend *backend = m_bands[0]->backend.get();
+    enqueue(*m_bands[0], [backend, copy]() { backend->UploadImage(copy->data(), static_cast<uint32_t>(copy->size())); });
+    invalidateDecodedTextures(m_transferDestBegin, m_transferDestEnd); // the bands that didn't run it
+    { g_barrierReason = 6; crossBandBarrier(); } // GHS-TRACE reason
+    m_renderTargets.clear();
+}
+
+void GSThreadedBackend::Flush()
+{
+    broadcast([](GSRasterBackend &backend) { backend.Flush(); });
+}
+
+void GSThreadedBackend::TextureFlush()
+{
+    if (g_bench.recording) benchPutRaw(BTextureFlush, nullptr, 0); // GHS-TRACE
+    // TEXFLUSH doesn't change VRAM; every write already drops the decoded texels it touches.
+    static const bool texflushDrops = std::getenv("GHS_GS_TEXFLUSH_DROPS") != nullptr; // GHS-TRACE: =1 for the old full drop
+    if (texflushDrops)
+        invalidateDecodedTextures();
+}
+
+void GSThreadedBackend::Sync(GSSyncReason reason)
+{
+    flushAll();
+    if (reason == GSSyncReason::Finish)
+    {
+        ++g_finishes; // GHS-TRACE
+        if (g_bench.trigger && g_bench.vram) // GHS-TRACE: GHS_GS_BENCH
+        {
+            if (g_bench.recording)
+                benchPutRaw(BFinish, nullptr, 0);
+            // GHS_GS_BENCH_FRAMES: frames per recording (default 10). After one, the trigger file is deleted and
+            // creating it again records again (GHS_GS_BENCH_SAVE is overwritten).
+            static const int s_benchFrames = std::getenv("GHS_GS_BENCH_FRAMES") ? std::max(1, std::atoi(std::getenv("GHS_GS_BENCH_FRAMES"))) : 10;
+            if (g_bench.recording && ++g_bench.frames >= s_benchFrames)
+            {
+                g_bench.recording = false;
+                std::remove(g_bench.trigger);
+                benchRun();
+            }
+            else if (!g_bench.recording && benchCheckDue())
+                if (FILE *f = std::fopen(g_bench.trigger, "rb"))
+                {
+                    std::fclose(f);
+                    drainAll();
+                    g_bench.start.assign(g_bench.vram, g_bench.vram + g_bench.vramSize);
+                    g_bench.recording = true;
+                    g_bench.frames = 0;
+                    g_bench.commands = 0;
+                    g_bench.stream.clear();
+                }
+        }
+        if (++m_framesSinceBalance >= 16u && stripeRows() == 0)
+        {
+            m_framesSinceBalance = 0;
+            balanceRowShares();
+        }
+        m_recentMaxRows[m_recentIndex++ & 15u] = m_frameMaxRow;
+        m_frameMaxRow = -1;
+        m_resplitPending = true;
+        { // GHS-TRACE: frame interval histogram
+            static auto last = std::chrono::steady_clock::now();
+            const auto now = std::chrono::steady_clock::now();
+            const auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(now - last).count();
+            last = now;
+            ++g_frameMsHist[std::min<long long>(ms / 10, 7)];
+        }
+        GhsWaitTimer timer{g_waitFinishMs}; // GHS-TRACE
+        // FINISH (once per frame): keep one frame in flight, so the game thread prepares the next
+        // frame while this one is drawn. Wait only for the work queued before the previous FINISH;
+        // anything that reads results (present, readback) waits for everything anyway.
+        for (auto &band : m_bands)
+        {
+            std::unique_lock<std::mutex> lock(band->mutex);
+            const uint64_t previous = band->lastFinishFence;
+            band->lastFinishFence = band->queued;
+            band->doneCv.wait(lock, [&band, previous]() { return band->finished >= previous; });
+        }
+        return;
+    }
+    {
+        GhsWaitTimer timer{g_waitOtherMs}; // GHS-TRACE
+        static unsigned reasons[8] = {};
+        if (++reasons[static_cast<int>(reason) & 7] % 500 == 1)
+            std::fprintf(stderr, "[GHS-GSWAIT] Sync reason %d (#%u)\n", static_cast<int>(reason), reasons[static_cast<int>(reason) & 7]);
+        drainAll();
+    }
+    m_bands[0]->backend->Sync(reason);
+}
+
+PresentationFrame GSThreadedBackend::Present(const GSPresentationRequest &request)
+{
+    drainAll();
+    return m_bands[0]->backend->Present(request);
+}
+
+bool GSThreadedBackend::ClearFramebuffer(const GSContext &context, uint32_t rgba)
+{
+    if (g_bench.recording) benchPut(BClear, ClearArgs{context, rgba}); // GHS-TRACE
+    drainAll();
+    forgetUploads(0u, UINT32_MAX);
+    invalidateDecodedTextures();
+    return m_bands[0]->backend->ClearFramebuffer(context, rgba);
+}
+
+uint32_t GSThreadedBackend::ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes)
+{
+    drainAll();
+    return m_bands[0]->backend->ConsumeLocalToHostBytes(dst, maxBytes);
+}
+
+uint32_t GSThreadedBackend::ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const
+{
+    drainAll();
+    return m_bands[0]->backend->ReadVram(psm, base, bw, x, y);
+}
+
+void GSThreadedBackend::WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value)
+{
+    if (g_bench.recording) benchPut(BWriteVram, WriteArgs{psm, base, bw, x, y, value}); // GHS-TRACE
+    drainAll();
+    forgetUploads(0u, UINT32_MAX);
+    invalidateDecodedTextures();
+    m_bands[0]->backend->WriteVram(psm, base, bw, x, y, value);
+}
+
+void GSThreadedBackend::SnapshotVram(std::vector<uint8_t> &out) const
+{
+    drainAll();
+    m_bands[0]->backend->SnapshotVram(out);
+}
+
+GSTransferSnapshot GSThreadedBackend::GetTransferSnapshot() const
+{
+    drainAll();
+    return m_bands[0]->backend->GetTransferSnapshot();
+}
diff --git a/ps2xRuntime/src/lib/gs/gs_threaded_backend.h b/ps2xRuntime/src/lib/gs/gs_threaded_backend.h
new file mode 100644
index 0000000..906d72b
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_threaded_backend.h
@@ -0,0 +1,206 @@
+﻿#pragma once
+
+#include "runtime/gs/gs_backend.h"
+
+#include <algorithm>
+#include <array>
+#include <iterator>
+#include <map>
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <utility>
+#include <unordered_map>
+#include <vector>
+
+// Runs the CPU rasterizer on worker threads, like the real GS next to the EE. The screen is split
+// into horizontal bands, one worker and one backend instance (own CLUT and page caches, shared VRAM)
+// per band; every draw goes to the bands it touches with its scissor narrowed to the band, so bands
+// write disjoint pixels and keep their draw order. CLUT loads go to every band. VRAM writes from
+// transfers/uploads and everything that reads results (present, readback, sync, snapshots) first
+// wait until all bands are idle. In Gregory Horror Show's rooms the rasterizer was ~half of each
+// frame on the game thread.
+class GSThreadedBackend final : public GSRasterBackend
+{
+public:
+    // makeInstance creates one backend per band; band 0's instance also handles transfers/present.
+    GSThreadedBackend(const std::function<std::unique_ptr<GSRasterBackend>()> &makeInstance, int bands);
+    ~GSThreadedBackend() override;
+
+    void Initialize(uint8_t *vram, uint32_t vramSize) override;
+    void Reset() override;
+
+    void Submit(const GSPrimitiveBatch &batch) override;
+    void LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut) override;
+    void BeginTransfer(const GSTransferCommand &command) override;
+    void UploadImage(const uint8_t *data, uint32_t sizeBytes) override;
+
+    void Flush() override;
+    void TextureFlush() override;
+    void Sync(GSSyncReason reason) override;
+    PresentationFrame Present(const GSPresentationRequest &request) override;
+
+    bool ClearFramebuffer(const GSContext &context, uint32_t rgba) override;
+    uint32_t ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes) override;
+
+    uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const override;
+    void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) override;
+    void SnapshotVram(std::vector<uint8_t> &out) const override;
+    GSTransferSnapshot GetTransferSnapshot() const override;
+
+private:
+    struct PendingCommand
+    {
+        enum Kind : uint8_t { Primitive, ClutLoad, TextureFlush } kind = Primitive;
+        PendingCommand() = default;
+        explicit PendingCommand(const GSPrimitiveBatch &primitive) : batch(primitive) {} // no zero-fill first
+        GSPrimitiveBatch batch{};
+        GSTex0Reg tex0{};
+        GSTexClutReg texclut{};
+        uint32_t rangeBegin = 0u, rangeEnd = UINT32_MAX; // TextureFlush: VRAM bytes whose decoded texels to drop
+        bool keepTopByteTextures = false;                // TextureFlush: a CT24/Z24 draw (T8H/T4H texels unchanged)
+        std::shared_ptr<const std::array<uint32_t, 256>> clutValues; // ClutLoad: raw entries resolved from upload data
+    };
+    // Small recent uploads (palettes) with their data, newest last (caller thread): while nothing else wrote
+    // their bytes, a CLUT load reading only them is resolved here, so no band reads that VRAM and the next
+    // palette upload needs no barrier (Gregory Horror Show uploads a 16-colour palette per object).
+    struct UploadRecord
+    {
+        GSTransferCommand command{};
