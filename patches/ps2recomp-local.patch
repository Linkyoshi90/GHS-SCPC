+    void ghsDrawResolutionSettings()
+    {
+        const int monitor = GetCurrentMonitor();
+        const int mw = GetMonitorWidth(monitor), mh = GetMonitorHeight(monitor);
+        const int sw = GetScreenWidth(), sh = GetScreenHeight();
+        const int scale = ghsGsScale();
+        std::vector<GhsMode> modes;
+        for (const GhsMode &m : kGhsModes)
+            if (m.w <= mw && m.h <= mh)
+                modes.push_back(m);
+        if (mw > 0 && mh > 0 && std::none_of(modes.begin(), modes.end(), [&](const GhsMode &m) { return m.w == mw && m.h == mh; }))
+            modes.push_back({mw, mh});
+        // The monitor's aspect ratio first, then the others by how close they are to it; small to large within one.
+        float current = 1.25f;
+        const std::string currentName = ghsAspectName(std::max(mw, 1), std::max(mh, 1), &current);
+        const auto distance = [&](const GhsMode &m)
+        {
+            float ratio = 1.0f;
+            const std::string name = ghsAspectName(m.w, m.h, &ratio);
+            return name == currentName ? 0.0f : std::fabs(std::log(ratio / current)) + 0.001f;
+        };
+        std::stable_sort(modes.begin(), modes.end(), [&](const GhsMode &a, const GhsMode &b)
+                         {
+            const float da = distance(a), db = distance(b);
+            if (std::fabs(da - db) > 1e-4f)
+                return da < db;
+            if (ghsAspectName(a.w, a.h) != ghsAspectName(b.w, b.h))
+                return ghsAspectName(a.w, a.h) < ghsAspectName(b.w, b.h);
+            return a.w * a.h < b.w * b.h; });
+
+        ImGui::Text("Resolution");
+        ImGui::TextDisabled("Window %dx%d, monitor %dx%d (%s)", sw, sh, mw, mh, ghsAspectName(std::max(mw, 1), std::max(mh, 1)).c_str());
+        if (scale > 0)
+            ImGui::Text("Rendering %dx%d (%dx)", 640 * scale, 512 * scale, scale);
+        else
+            ImGui::TextDisabled("Rendering 640x512: render scaling needs the GPU GS\n(it is off: GHS_GS_GPU=0 / launch.ps1 -Cpu, or no D3D11 compute device).");
+        bool chosen = false;
+        int chosenW = 0, chosenH = 0;
+        if (ImGui::BeginListBox("##resolutions", ImVec2(-FLT_MIN, 9.0f * ImGui::GetTextLineHeightWithSpacing())))
+        {
+            std::string lastAspect;
+            for (const GhsMode &m : modes)
+            {
+                const std::string aspect = ghsAspectName(m.w, m.h);
+                if (aspect != lastAspect)
+                {
+                    ImGui::SeparatorText(aspect.c_str());
+                    lastAspect = aspect;
+                }
+                char label[96];
+                const int n = ghsScaleFor(m.w, m.h);
+                if (scale > 0)
+                    std::snprintf(label, sizeof(label), "%dx%d%s   renders %dx (%dx%d)##%dx%d", m.w, m.h, (m.w == mw && m.h == mh) ? " (full screen)" : "", n,
+                                  640 * n, 512 * n, m.w, m.h);
+                else
+                    std::snprintf(label, sizeof(label), "%dx%d%s##%dx%d", m.w, m.h, (m.w == mw && m.h == mh) ? " (full screen)" : "", m.w, m.h);
+                if (ImGui::Selectable(label, m.w == sw && m.h == sh))
+                {
+                    chosen = true;
+                    chosenW = m.w;
+                    chosenH = m.h;
+                }
+            }
+            ImGui::EndListBox();
+        }
+        if (chosen)
+        {
+            ghsApplyWindow(chosenW, chosenH);
+            g_ghsWindowW = chosenW;
+            g_ghsWindowH = chosenH;
+            if (scale > 0)
+            {
+                g_ghsRenderScale = ghsScaleFor(chosenW, chosenH);
+                ghsGsSetScale(g_ghsRenderScale);
+            }
+            ghsSaveSettings();
+        }
+        if (scale > 0 && ImGui::Checkbox("Smooth shadows (render scale 2x and up)", &g_ghsSmoothShadows))
+        {
+            ghsGsSetSmoothShadows(g_ghsSmoothShadows);
+            ghsSaveSettings();
+        }
+        if (scale > 0) // or the render scale alone
+        {
+            int pick = scale;
+            ImGui::Text("Render scale");
+            for (int n = 1; n <= 4; ++n)
+            {
+                ImGui::SameLine();
+                char name[8];
+                std::snprintf(name, sizeof(name), "%dx", n);
+                if (ImGui::RadioButton(name, &pick, n) && pick != scale)
+                {
+                    g_ghsRenderScale = pick;
+                    ghsGsSetScale(pick);
+                    ghsSaveSettings();
+                }
+            }
+        }
+    }
