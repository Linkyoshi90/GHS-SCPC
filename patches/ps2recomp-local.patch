+        case 0x22: op.fn = (flags ? &fmac<Add, I, true, true> : &fmac<Add, I, true, false>); break;
+        case 0x23: op.fn = (flags ? &fmac<MulAdd, I, true, true> : &fmac<MulAdd, I, true, false>); break;
+        case 0x24: op.fn = (flags ? &fmac<Sub, Q, true, true> : &fmac<Sub, Q, true, false>); break;
+        case 0x25: op.fn = (flags ? &fmac<MulSub, Q, true, true> : &fmac<MulSub, Q, true, false>); break;
+        case 0x26: op.fn = (flags ? &fmac<Sub, I, true, true> : &fmac<Sub, I, true, false>); break;
+        case 0x27: op.fn = (flags ? &fmac<MulSub, I, true, true> : &fmac<MulSub, I, true, false>); break;
+        case 0x28: op.fn = (flags ? &fmac<Add, Vec, true, true> : &fmac<Add, Vec, true, false>); break;
+        case 0x29: op.fn = (flags ? &fmac<MulAdd, Vec, true, true> : &fmac<MulAdd, Vec, true, false>); break;
+        case 0x2A: op.fn = (flags ? &fmac<Mul, Vec, true, true> : &fmac<Mul, Vec, true, false>); break;
+        case 0x2C: op.fn = (flags ? &fmac<Sub, Vec, true, true> : &fmac<Sub, Vec, true, false>); break;
