+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_detail.h
@@ -2,6 +2,7 @@
 #define PS2_VU1_DETAIL_H
 
 #include <cstdint>
+#include <cstring>
 
 // Instruction field extraction helpers
 static inline uint8_t DEST(uint32_t i) { return (uint8_t)((i >> 21) & 0xF); }
@@ -26,4 +27,30 @@ static inline int16_t IMM15(uint32_t i)
     return (int16_t)(int32_t)((int32_t)(raw << 17) >> 17);
 }
 
+// PS2 FPU operand rule (inline copy of VU1Interpreter::normalizeOperand, called for every operand
+// read): denormals read as signed zero, Inf/NaN as signed max float.
+#if defined(_MSC_VER)
+#define VU_FORCEINLINE __forceinline // called per operand in the VU1 fast paths; MSVC stopped inlining it there
+#else
+#define VU_FORCEINLINE inline __attribute__((always_inline))
+#endif
+static VU_FORCEINLINE float vuNormalizeOperand(float value)
+{
+    uint32_t bits;
+    std::memcpy(&bits, &value, sizeof(bits));
+    const uint32_t exponent = (bits >> 23) & 0xFFu;
+    if (exponent == 0u)
+        bits &= 0x80000000u;
+    else if (exponent == 0xFFu)
+        bits = (bits & 0x80000000u) | 0x7F7FFFFFu;
+    std::memcpy(&value, &bits, sizeof(value));
+    return value;
+}
+
+// Inline copy of VU1Interpreter::broadcast (a cross-file call in every broadcast FMAC instruction).
+static inline float vuBroadcast(const float *vf, uint8_t bc)
+{
+    return vuNormalizeOperand(vf[bc & 3u]);
+}
+
 #endif
diff --git a/ps2xRuntime/src/lib/vu/ps2_vu1_fast.h b/ps2xRuntime/src/lib/vu/ps2_vu1_fast.h
