+// Compiles the jobs in parallel (the kernels take very different times; one thread each).
+static void CompileKernels(std::vector<KernelJob> &jobs, UINT flags)
+{
+    std::vector<std::thread> threads;
+    for (KernelJob &job : jobs)
+        threads.emplace_back([&job, flags]()
+                             { job.hr = D3DCompile(kShader, std::strlen(kShader), "gs_gpu_backend", job.defines, nullptr, kEntry[job.kernel], "cs_5_0",
+                                                   flags, 0, &job.code, &job.errors); });
+    for (std::thread &t : threads)
+        t.join();
+}
