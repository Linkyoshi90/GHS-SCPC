+void ghsLoadSettings()
+{
+    if (FILE *f = std::fopen("ghs_settings.ini", "r"))
+    {
+        int fast = 1, mode = 0, mouse = 1;
+        if (std::fscanf(f, "fast_controls=%d\ninput_mode=%d\nmouse_look=%d", &fast, &mode, &mouse) >= 2)
+        {
+            g_ghsFastControls = fast != 0;
+            g_ghsInputMode = (mode >= 0 && mode <= 2) ? mode : 0;
+            g_ghsMouseLook = mouse != 0;
+        }
+        int scale = 0, w = 0, h = 0;
+        if (std::fscanf(f, " render_scale=%d window=%dx%d", &scale, &w, &h) == 3)
+        {
+            g_ghsRenderScale = (scale >= 1 && scale <= 4) ? scale : 0;
+            g_ghsWindowW = w > 0 ? w : 0;
+            g_ghsWindowH = h > 0 ? h : 0;
+        }
+        std::rewind(f);
+        char line[64];
+        for (int on = 0; std::fgets(line, sizeof(line), f);)
+            if (std::sscanf(line, "anim_interp=%d", &on) == 1)
+                g_ghsAnimInterp = on != 0;
+            else if (std::sscanf(line, "smooth_shadows=%d", &on) == 1)
+                g_ghsSmoothShadows = on != 0;
+            else if (std::sscanf(line, "widescreen=%d", &on) == 1)
+                g_ghsWidescreen = on != 0;
+            else if (std::sscanf(line, "jp_voice=%d", &on) == 1)
+                g_ghsJpVoice = on != 0;
+            else if (float v = 0.0f; std::sscanf(line, "mouse_speed=%f", &v) == 1)
+                g_ghsMouseSpeed = std::clamp(v, 0.1f, 5.0f);
+            else if (std::sscanf(line, "rumble=%d", &on) == 1)
+                g_ghsRumble = on != 0;
+            else if (float v = 0.0f; std::sscanf(line, "stick_deadzone=%f", &v) == 1)
+                g_ghsStickDeadzone = std::clamp(v, 0.0f, 0.9f);
+            else
+            {
+                char id[32] = {};
+                int a = 0, b = 0;
+                if (std::sscanf(line, "key_%31[^=]=%d,%d", id, &a, &b) == 3)
+                    for (int k = 0; k < kGhsKeyActionCount; ++k)
+                        if (std::strcmp(id, g_ghsKeyActionInfo[k].id) == 0)
+                        {
+                            g_ghsKeys[k][0] = (a > 0 && a < 512) ? a : 0;
+                            g_ghsKeys[k][1] = (b > 0 && b < 512) ? b : 0;
+                        }
+                if (std::sscanf(line, "pad_%31[^=]=%d", id, &a) == 2)
+                    for (int k = 0; k < kGhsKeyActionCount; ++k)
+                        if (std::strcmp(id, g_ghsKeyActionInfo[k].id) == 0 && g_ghsKeyActionInfo[k].padDefault >= 0)
+                            g_ghsPadButtons[k] = (a > 0 && a <= GAMEPAD_BUTTON_RIGHT_THUMB) ? a : 0;
+            }
+        std::fclose(f);
+    }
+    if (const char *env = std::getenv("GHS_ANIM_INTERP"))
+        g_ghsAnimInterp = std::atoi(env) != 0;
+    if (const char *env = std::getenv("GHS_WIDESCREEN"))
+        g_ghsWidescreen = std::atoi(env) != 0;
+    if (const char *env = std::getenv("GHS_JP_VOICE"))
+        g_ghsJpVoice = std::atoi(env) != 0;
+}
+
+void ghsSaveSettings()
+{
+    // A temporary file replaced into place: a crash halfway through left an empty or cut file (all defaults).
+    if (FILE *f = std::fopen("ghs_settings.ini.tmp", "w"))
+    {
+        std::fprintf(f, "fast_controls=%d\ninput_mode=%d\nmouse_look=%d\nrender_scale=%d\nwindow=%dx%d\n", g_ghsFastControls ? 1 : 0, g_ghsInputMode,
+                     g_ghsMouseLook ? 1 : 0, g_ghsRenderScale, g_ghsWindowW, g_ghsWindowH);
+        std::fprintf(f, "anim_interp=%d\n", g_ghsAnimInterp ? 1 : 0);
+        std::fprintf(f, "smooth_shadows=%d\n", g_ghsSmoothShadows ? 1 : 0);
+        std::fprintf(f, "widescreen=%d\n", g_ghsWidescreen ? 1 : 0);
+        std::fprintf(f, "jp_voice=%d\n", g_ghsJpVoice ? 1 : 0);
+        std::fprintf(f, "mouse_speed=%.2f\nstick_deadzone=%.2f\nrumble=%d\n", g_ghsMouseSpeed, g_ghsStickDeadzone, g_ghsRumble ? 1 : 0);
+        for (int k = 0; k < kGhsKeyActionCount; ++k)
+            std::fprintf(f, "key_%s=%d,%d\n", g_ghsKeyActionInfo[k].id, g_ghsKeys[k][0], g_ghsKeys[k][1]);
+        for (int k = 0; k < kGhsKeyActionCount; ++k)
+            if (g_ghsKeyActionInfo[k].padDefault >= 0)
+                std::fprintf(f, "pad_%s=%d\n", g_ghsKeyActionInfo[k].id, g_ghsPadButtons[k]);
+        const bool written = std::ferror(f) == 0;
+        std::error_code ec;
+        if (std::fclose(f) == 0 && written)
+            std::filesystem::rename("ghs_settings.ini.tmp", "ghs_settings.ini", ec);
+        else
+            std::filesystem::remove("ghs_settings.ini.tmp", ec);
+    }
+}
