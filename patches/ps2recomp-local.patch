+    // GHS-TRACE: GHS_PADFILE=<path> holds a hex mask of held PS2 buttons (1 = pressed, same bit
+    // layout as PAD_*), so scripts can press buttons without keyboard focus. Re-read every 25 ms.
+    uint32_t ghsPadFileMask()
+    {
+        static const char *s_padFile = std::getenv("GHS_PADFILE");
+        static auto s_lastRead = std::chrono::steady_clock::time_point{};
+        static uint32_t s_fileMask = 0u;
+        if (!s_padFile)
+            return 0u;
+        const auto now = std::chrono::steady_clock::now();
+        if (now - s_lastRead >= std::chrono::milliseconds(25))
+        {
+            s_lastRead = now;
+            s_fileMask = 0u;
+            if (FILE *f = std::fopen(s_padFile, "rb"))
+            {
+                unsigned int mask = 0u;
+                if (std::fscanf(f, "%x", &mask) == 1)
+                    s_fileMask = mask;
+                std::fclose(f);
+            }
+        }
+        return s_fileMask;
+    }
