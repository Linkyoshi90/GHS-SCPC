+        case 0x08: case 0x09: case 0x0A: case 0x0B: op.fn = (flags ? &fmac<MulAdd, Bc, true, true> : &fmac<MulAdd, Bc, true, false>); break;
+        case 0x0C: case 0x0D: case 0x0E: case 0x0F: op.fn = (flags ? &fmac<MulSub, Bc, true, true> : &fmac<MulSub, Bc, true, false>); break;
