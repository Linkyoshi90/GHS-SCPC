+#include "spu2.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace ps2x::iop::detail
+{
+    namespace
+    {
+        constexpr uint32_t kRamHalfwords = 0x100000u; // 2 MB
+        constexpr uint32_t kAddressMask = kRamHalfwords - 1u;
+        constexpr uint32_t kCoreStride = 0x400u;
+        constexpr uint32_t kVoiceAddressBase = 0x1C0u;
+        constexpr uint32_t kVoiceAddressStride = 0xCu;
+        constexpr uint32_t kVmixl = 0x188u, kVmixr = 0x190u;
+        constexpr uint32_t kKon = 0x1A0u, kKoff = 0x1A4u;
+        constexpr uint32_t kTsa = 0x1A8u, kStd = 0x1ACu, kAdmas = 0x1B0u;
+        constexpr uint32_t kEndx = 0x340u, kStatx = 0x344u;
+        constexpr uint32_t kVolumes = 0x760u, kVolumeStride = 0x28u; // MVOL +0/+2, AVOL (external in) +8/+A, BVOL (AutoDMA in) +C/+E
+
+        // PSX/PS2 envelope step (ADSR and volume sweeps): every `cycles` samples the level moves by
+        // `step`; exponential increase slows above 0x6000, exponential decrease scales with the level.
+        void stepLevel(int rate, bool decrease, bool exponential, int32_t &level, uint32_t &counter)
+        {
+            const int shift = rate >> 2;
+            int32_t step = decrease ? (-8 + (rate & 3)) : (7 - (rate & 3));
+            uint32_t cycles = 1u << std::max(0, shift - 11);
+            step *= 1 << std::max(0, 11 - shift);
+            if (exponential && !decrease && level > 0x6000)
+                cycles *= 4u;
+            if (exponential && decrease)
+                step = (step * level) >> 15;
+            if (++counter >= cycles)
+            {
+                counter = 0;
+                level = std::clamp(level + step, 0, 0x7FFF);
+            }
+        }
+
+        int16_t clamp16(int32_t value)
+        {
+            return static_cast<int16_t>(std::clamp(value, -32768, 32767));
+        }
+    }
+
+    Spu2::Spu2()
+        : m_ram(kRamHalfwords)
+    {
+        reset();
+    }
+
+    void Spu2::reset()
+    {
+        m_regs.fill(0u);
+        std::fill(m_ram.begin(), m_ram.end(), uint16_t{0});
+        m_cores = {};
+        m_cycle = 0;
+        m_started = false;
+    }
+
+    uint32_t Spu2::address(uint32_t hiOffset) const
+    {
+        return ((static_cast<uint32_t>(reg(hiOffset)) & 0xFu) << 16u | reg(hiOffset + 2u)) & kAddressMask;
+    }
+
+    void Spu2::setAddress(uint32_t hiOffset, uint32_t value)
+    {
+        reg(hiOffset) = static_cast<uint16_t>((value >> 16u) & 0xFu);
+        reg(hiOffset + 2u) = static_cast<uint16_t>(value);
+    }
+
+    uint16_t Spu2::read16(uint32_t phys) const
+    {
+        const uint32_t offset = phys - kBase;
+        if (offset < kVolumes)
+        {
+            const int core = static_cast<int>(offset / kCoreStride);
+            const uint32_t local = offset % kCoreStride;
+            const Core &c = m_cores[core];
+            if (local < 0x180u && (local & 0xFu) == 0xAu) // ENVX
+                return static_cast<uint16_t>(c.voices[local >> 4u].level);
+            if (local < 0x180u && (local & 0xFu) == 0xCu) // VOLXL
+                return static_cast<uint16_t>(c.voices[local >> 4u].volumeLeft.level);
+            if (local < 0x180u && (local & 0xFu) == 0xEu) // VOLXR
+                return static_cast<uint16_t>(c.voices[local >> 4u].volumeRight.level);
+            if (local >= kVoiceAddressBase && local < kVoiceAddressBase + 24u * kVoiceAddressStride)
+            {
+                const uint32_t field = (local - kVoiceAddressBase) % kVoiceAddressStride;
+                const Voice &voice = c.voices[(local - kVoiceAddressBase) / kVoiceAddressStride];
+                if (field == 8u) // NAXH
+                    return static_cast<uint16_t>(voice.nax >> 16u);
+                if (field == 10u)
+                    return static_cast<uint16_t>(voice.nax);
+            }
+            if (local == kEndx)
+                return static_cast<uint16_t>(c.endx);
+            if (local == kEndx + 2u)
+                return static_cast<uint16_t>(c.endx >> 16u);
+        }
+        return reg(offset);
+    }
+
+    void Spu2::write16(uint32_t phys, uint16_t value)
+    {
+        const uint32_t offset = phys - kBase;
+        reg(offset) = value;
+        if (offset >= kVolumes)
+            return;
+        const int core = static_cast<int>(offset / kCoreStride);
+        const uint32_t local = offset % kCoreStride;
+        const uint32_t coreBase = static_cast<uint32_t>(core) * kCoreStride;
+        Core &c = m_cores[core];
+
+        if (local >= kVoiceAddressBase && local < kVoiceAddressBase + 24u * kVoiceAddressStride)
+        {
+            const uint32_t field = (local - kVoiceAddressBase) % kVoiceAddressStride;
+            const uint32_t voiceBase = local - field;
+            Voice &voice = c.voices[(local - kVoiceAddressBase) / kVoiceAddressStride];
+            if (field == 4u || field == 6u) // LSAX
+            {
+                voice.lsa = address(coreBase + voiceBase + 4u);
+                voice.lsaWritten = true;
+                voice.loopManual = true;
+            }
+            else if (field == 8u || field == 10u) // NAX
+            {
+                voice.nax = address(coreBase + voiceBase + 8u);
+                voice.pos = 28;
+                voice.blockStarted = false;
+            }
+            return;
+        }
+
+        switch (local)
+        {
+        case kKon:
+            keyOn(core, 0, value);
+            break;
+        case kKon + 2u:
+            keyOn(core, 16, value & 0xFFu);
+            break;
+        case kKoff:
+            keyOff(core, 0, value);
+            break;
+        case kKoff + 2u:
+            keyOff(core, 16, value & 0xFFu);
+            break;
+        case kStd: // manual transfer: one halfword to sound RAM at TSA
+        {
+            const uint32_t tsa = address(coreBase + kTsa);
+            m_ram[tsa] = value;
+            setAddress(coreBase + kTsa, (tsa + 1u) & kAddressMask);
+            break;
+        }
+        case kEndx:
+            c.endx &= ~0xFFFFu;
+            break;
+        case kEndx + 2u:
+            c.endx &= 0xFFFFu;
+            break;
+        default:
+            break;
+        }
+    }
+
+    void Spu2::dma(int core, uint8_t *ram, size_t bytes, bool toDevice)
+    {
+        const uint32_t coreBase = static_cast<uint32_t>(core) * kCoreStride;
+        reg(coreBase + kStatx) |= 0x80u;
+        Core &c = m_cores[core];
+        if (toDevice && (reg(coreBase + kAdmas) & 3u) != 0u)
+        {
+            queueInputBlocks(c, ram, bytes);
+            return;
+        }
+
+        uint32_t tsa = address(coreBase + kTsa);
+        for (size_t i = 0; i + 1u < bytes; i += 2u)
+        {
+            if (toDevice)
+                std::memcpy(&m_ram[tsa], ram + i, 2u);
+            else
+                std::memcpy(ram + i, &m_ram[tsa], 2u);
+            tsa = (tsa + 1u) & kAddressMask;
+        }
+        setAddress(coreBase + kTsa, tsa);
+    }
+
+    void Spu2::autoDmaRing(int core, const uint8_t *iopRam, uint32_t base, uint32_t size, uint32_t offset)
+    {
+        Core &c = m_cores[core & 1];
+        c.input.clear();
+        c.ringRam = size >= 0x400u ? iopRam : nullptr;
+        c.ringBase = base;
+        c.ringSize = size;
+        c.ringRead = size != 0u ? offset % size : 0u;
+        c.ringSincePoll = 0u;
+    }
+
+    uint32_t Spu2::autoDmaPoll(int core)
+    {
+        Core &c = m_cores[core & 1];
+        c.ringSincePoll = 0u;
+        return c.ringRead;
+    }
+
+    void Spu2::pullRingBlock(Core &c)
+    {
+        constexpr uint32_t kIopRamMask = 0x1FFFFFu; // 2 MB
+        // Up to one block short of a lap past the last poll: the game measures playback modulo the ring, so a
+        // lap between two polls would be lost. (Half a ring was too little: GHS's movie thread pauses its
+        // polling for 26-41 ms a few times a second, and its ring is 64 ms.)
+        if (c.ringSincePoll + 0x400u >= c.ringSize)
+            return; // the game has not polled for almost a lap: starve rather than lap the ring
+        std::array<uint8_t, 0x400> block;
+        for (uint32_t i = 0; i < 0x400u; ++i)
+            block[i] = c.ringRam[(c.ringBase + (c.ringRead + i) % c.ringSize) & kIopRamMask];
+        c.ringRead = (c.ringRead + 0x400u) % c.ringSize;
+        c.ringSincePoll += 0x400u;
+        queueInputBlocks(c, block.data(), block.size());
+    }
+
+    // AutoDMA blocks: 0x200 bytes left (256 samples), then 0x200 bytes right.
+    void Spu2::queueInputBlocks(Core &c, const uint8_t *blocks, size_t bytes)
+    {
+        for (size_t block = 0; block + 0x400u <= bytes; block += 0x400u)
+        {
+            for (size_t i = 0; i < 256u; ++i)
+            {
+                int16_t left, right;
+                std::memcpy(&left, blocks + block + i * 2u, 2u);
+                std::memcpy(&right, blocks + block + 0x200u + i * 2u, 2u);
+                c.input.emplace_back(left, right);
+            }
+        }
+        while (c.input.size() > 48000u) // more than 1 s queued: drop the oldest
+            c.input.pop_front();
+    }
+
+    void Spu2::keyOn(int core, int firstVoice, uint16_t bits)
+    {
+        const uint32_t coreBase = static_cast<uint32_t>(core) * kCoreStride;
+        for (int i = 0; i < 16 && firstVoice + i < 24; ++i)
+        {
+            if ((bits & (1u << i)) == 0u)
+                continue;
+            const int index = firstVoice + i;
+            Voice &voice = m_cores[core].voices[index];
+            const uint32_t addressBase = coreBase + kVoiceAddressBase + static_cast<uint32_t>(index) * kVoiceAddressStride;
+            const uint32_t ssa = address(addressBase);
+            const bool manualLoop = voice.lsaWritten;
+            const uint32_t lsa = voice.lsa;
+            const Sweep volumeLeft = voice.volumeLeft, volumeRight = voice.volumeRight; // VOLX isn't reset by key on
+            voice = Voice{};
+            voice.volumeLeft = volumeLeft;
+            voice.volumeRight = volumeRight;
+            voice.phase = Phase::Attack;
+            voice.nax = ssa;
+            voice.loopManual = manualLoop;
+            voice.lsa = manualLoop ? lsa : ssa;
+            m_cores[core].endx &= ~(1u << index);
+            static const bool traceKeyOn = std::getenv("GHS_SPU2KON") != nullptr; // GHS-TRACE
+            if (traceKeyOn)
+                std::fprintf(stderr, "[GHS-KON] t=%.3f c%d v%d ssa=0x%x lsa=0x%x%s pitch=0x%x adsr=0x%x/0x%x\n",
+                             static_cast<double>(m_cycle) / (48000.0 * kCyclesPerSample), core, index, ssa, voice.lsa,
+                             manualLoop ? "m" : "", reg(coreBase + static_cast<uint32_t>(index) * 0x10u + 4u),
+                             reg(coreBase + static_cast<uint32_t>(index) * 0x10u + 6u), reg(coreBase + static_cast<uint32_t>(index) * 0x10u + 8u));
+        }
+    }
+
+    void Spu2::keyOff(int core, int firstVoice, uint16_t bits)
+    {
+        for (int i = 0; i < 16 && firstVoice + i < 24; ++i)
+        {
+            Voice &voice = m_cores[core].voices[firstVoice + i];
+            if ((bits & (1u << i)) != 0u && voice.phase != Phase::Off)
+            {
+                voice.phase = Phase::Release;
+                voice.envCounter = 0;
+            }
+        }
+    }
+
+    void Spu2::decodeBlock(Voice &voice)
+    {
+        static constexpr int32_t kFilter0[5] = {0, 60, 115, 98, 122};
+        static constexpr int32_t kFilter1[5] = {0, 0, -52, -55, -60};
+        const uint16_t header = m_ram[voice.nax];
+        int shift = header & 0xF;
+        if (shift > 12)
+            shift = 9;
+        const int filter = std::min((header >> 4) & 0x7, 4);
+        voice.blockFlags = static_cast<uint8_t>(header >> 8u);
+        if ((voice.blockFlags & 4u) != 0u && !voice.loopManual)
+            voice.lsa = voice.nax;
+        for (int i = 0; i < 28; ++i)
+        {
+            const uint16_t word = m_ram[(voice.nax + 1u + static_cast<uint32_t>(i / 4)) & kAddressMask];
+            const int32_t nibble = static_cast<int16_t>(static_cast<uint16_t>(((word >> ((i % 4) * 4)) & 0xFu) << 12u));
+            int32_t sample = (nibble >> shift) + ((voice.prev1 * kFilter0[filter] + voice.prev2 * kFilter1[filter] + 32) >> 6);
+            sample = clamp16(sample);
+            voice.prev2 = voice.prev1;
+            voice.prev1 = sample;
+            voice.decoded[static_cast<size_t>(i)] = static_cast<int16_t>(sample);
+        }
+        voice.nax = (voice.nax + 8u) & kAddressMask;
+        voice.pos = 0;
+        voice.blockStarted = true;
+    }
+
+    int16_t Spu2::nextSample(int core, int voiceIndex, Voice &voice)
+    {
+        if (voice.pos >= 28)
+        {
+            if (voice.blockStarted && (voice.blockFlags & 1u) != 0u) // end of the sample
+            {
+                m_cores[core].endx |= 1u << voiceIndex;
+                if ((voice.blockFlags & 2u) != 0u)
+                {
+                    voice.nax = voice.lsa;
+                }
+                else
+                {
+                    voice.phase = Phase::Off;
+                    voice.level = 0;
+                    return 0;
+                }
+            }
+            decodeBlock(voice);
+        }
+        return voice.decoded[static_cast<size_t>(voice.pos++)];
+    }
+
+    // PSX/PS2 ADSR: every `cycles` samples the level moves by `step` (exponential modes scale it).
+    void Spu2::tickEnvelope(int core, int voiceIndex, Voice &voice)
+    {
+        const uint32_t base = static_cast<uint32_t>(core) * kCoreStride + static_cast<uint32_t>(voiceIndex) * 0x10u;
+        const uint16_t adsr1 = reg(base + 6u);
+        const uint16_t adsr2 = reg(base + 8u);
+        int rate = 0;
+        bool decrease = false;
+        bool exponential = false;
+        switch (voice.phase)
+        {
+        case Phase::Attack:
+            rate = (adsr1 >> 8) & 0x7F;
+            exponential = (adsr1 & 0x8000u) != 0u;
+            break;
+        case Phase::Decay:
+            rate = ((adsr1 >> 4) & 0xF) << 2;
+            decrease = exponential = true;
+            break;
+        case Phase::Sustain:
+            rate = (adsr2 >> 6) & 0x7F;
+            decrease = (adsr2 & 0x4000u) != 0u;
+            exponential = (adsr2 & 0x8000u) != 0u;
+            break;
+        case Phase::Release:
+            rate = (adsr2 & 0x1F) << 2;
+            decrease = true;
+            exponential = (adsr2 & 0x20u) != 0u;
+            break;
+        case Phase::Off:
+            return;
+        }
+
+        stepLevel(rate, decrease, exponential, voice.level, voice.envCounter);
+
+        if (voice.phase == Phase::Attack && voice.level >= 0x7FFF)
+        {
+            voice.phase = Phase::Decay;
+        }
+        else if (voice.phase == Phase::Decay && voice.level <= ((adsr1 & 0xF) + 1) * 0x800)
+        {
+            voice.phase = Phase::Sustain;
+        }
+        else if (voice.phase == Phase::Release && voice.level <= 0)
+        {
+            voice.phase = Phase::Off;
+            voice.level = 0;
+        }
+    }
+
+    // Voice/master volume register: fixed (bit 15 clear, bits 0-14 signed) or a sweep that moves
+    // the current volume (bit 14 exponential, 13 decrease, 12 inverted phase, 0-6 rate).
+    int32_t Spu2::sweepVolume(uint16_t value, Sweep &sweep)
+    {
+        if ((value & 0x8000u) == 0u)
+        {
+            sweep.level = static_cast<int16_t>(static_cast<uint16_t>(value << 1u));
+            sweep.counter = 0;
+            return sweep.level;
+        }
+        int32_t magnitude = std::abs(sweep.level);
+        stepLevel(value & 0x7F, (value & 0x2000u) != 0u, (value & 0x4000u) != 0u, magnitude, sweep.counter);
+        sweep.level = (value & 0x1000u) != 0u ? -magnitude : magnitude;
+        return sweep.level;
+    }
+
+    // Reverb (PSX algorithm, SPU2 register names), one step at 24 kHz. Work area [ESA, EEA] in sound
+    // RAM; address registers are offsets into it from the moving buffer position.
+    void Spu2::reverbStep(int core, int32_t inLeft, int32_t inRight, int32_t &outLeft, int32_t &outRight)
+    {
+        const uint32_t coreBase = static_cast<uint32_t>(core) * kCoreStride;
+        const uint32_t esa = address(coreBase + 0x2E0u);
+        const uint32_t eea = ((static_cast<uint32_t>(reg(coreBase + 0x33Cu)) & 0xFu) << 16u) | 0xFFFFu;
+        if (eea <= esa)
+        {
+            outLeft = outRight = 0;
+            return;
+        }
+        const uint32_t size = eea - esa + 1u;
+        Core &c = m_cores[core];
+        c.reverbPos = (c.reverbPos + 1u) % size;
+        const auto at = [&](uint32_t offset)
+        { return esa + (offset + c.reverbPos) % size; };
+        const auto off = [&](uint32_t reg32)
+        { return address(coreBase + reg32); };
+        const auto rd = [&](uint32_t offset) -> int32_t
+        { return static_cast<int16_t>(m_ram[at(offset)]); };
+        const auto wr = [&](uint32_t offset, int32_t value)
+        { m_ram[at(offset)] = static_cast<uint16_t>(clamp16(value)); };
+        const uint32_t volumes = kVolumes + static_cast<uint32_t>(core) * kVolumeStride;
+        const auto coef = [&](uint32_t offset) -> int32_t
+        { return static_cast<int16_t>(reg(volumes + offset)); };
+        const int32_t iirAlpha = coef(0x14u), accA = coef(0x16u), accB = coef(0x18u), accC = coef(0x1Au), accD = coef(0x1Cu);
+        const int32_t iirCoef = coef(0x1Eu), fbAlpha = coef(0x20u), fbX = coef(0x22u);
+        const int32_t inL = (inLeft * coef(0x24u)) >> 15, inR = (inRight * coef(0x26u)) >> 15;
+
+        const auto iir = [&](uint32_t dest, uint32_t src, int32_t in)
+        {
+            const uint32_t d = off(dest), previous = (d + size - 1u) % size;
+            wr(d, (((in + ((rd(off(src)) * iirCoef) >> 15) - rd(previous)) * iirAlpha) >> 15) + rd(previous));
+        };
+        iir(0x2ECu, 0x304u, inL); // IIR_DEST_A0 <- IIR_SRC_A0 (same side)
+        iir(0x2F0u, 0x308u, inR); // IIR_DEST_A1 <- IIR_SRC_A1
+        iir(0x30Cu, 0x328u, inL); // IIR_DEST_B0 <- IIR_SRC_B1 (other side)
+        iir(0x310u, 0x324u, inR); // IIR_DEST_B1 <- IIR_SRC_B0
+
+        int32_t l = (rd(off(0x2F4u)) * accA + rd(off(0x2FCu)) * accB + rd(off(0x314u)) * accC + rd(off(0x31Cu)) * accD) >> 15;
+        int32_t r = (rd(off(0x2F8u)) * accA + rd(off(0x300u)) * accB + rd(off(0x318u)) * accC + rd(off(0x320u)) * accD) >> 15;
+        const uint32_t fbA = off(0x2E4u), fbB = off(0x2E8u);
+        const auto allPass = [&](int32_t value, uint32_t dest, uint32_t delay, int32_t gain)
+        {
+            const uint32_t d = off(dest);
+            const int32_t delayed = rd((d + size - (delay % size)) % size);
+            value = clamp16(value - ((delayed * gain) >> 15));
+            wr(d, value);
+            return static_cast<int32_t>(clamp16(((value * gain) >> 15) + delayed));
+        };
+        l = allPass(l, 0x32Cu, fbA, fbAlpha); // MIX_DEST_A0
+        r = allPass(r, 0x330u, fbA, fbAlpha); // MIX_DEST_A1
+        l = allPass(l, 0x334u, fbB, fbX);     // MIX_DEST_B0
+        r = allPass(r, 0x338u, fbB, fbX);     // MIX_DEST_B1
+        outLeft = l;
+        outRight = r;
+    }
+
+    void Spu2::mixOne(int32_t &left, int32_t &right)
+    {
+        int32_t extLeft = 0, extRight = 0; // core 0 output feeds core 1's external input
+        for (int core = 0; core < 2; ++core)
+        {
+            const uint32_t coreBase = static_cast<uint32_t>(core) * kCoreStride;
+            const auto mask32 = [&](uint32_t offset)
+            { return reg(coreBase + offset) | (static_cast<uint32_t>(reg(coreBase + offset + 2u)) << 16u); };
+            const uint32_t dryLeftMask = mask32(kVmixl), dryRightMask = mask32(kVmixr);
+            const uint32_t wetLeftMask = mask32(kVmixl + 4u), wetRightMask = mask32(kVmixr + 4u);
+            Core &c = m_cores[core];
+            int32_t dryLeft = 0, dryRight = 0, wetLeft = 0, wetRight = 0;
+            for (int index = 0; index < 24; ++index)
+            {
+                Voice &voice = c.voices[index];
+                if (voice.phase == Phase::Off)
+                    continue;
+                const uint32_t base = coreBase + static_cast<uint32_t>(index) * 0x10u;
+                voice.counter += std::min<uint32_t>(reg(base + 4u), 0x3FFFu);
+                while (voice.counter >= 0x1000u && voice.phase != Phase::Off)
+                {
+                    voice.counter -= 0x1000u;
+                    voice.history = {voice.history[1], voice.history[2], voice.history[3], nextSample(core, index, voice)};
+                }
+                if (voice.phase == Phase::Off)
+                    continue;
+                // Catmull-Rom between history[1] and history[2].
+                const float t = static_cast<float>(voice.counter) / 4096.0f;
+                const float p0 = static_cast<float>(voice.history[0]), p1 = static_cast<float>(voice.history[1]);
+                const float p2 = static_cast<float>(voice.history[2]), p3 = static_cast<float>(voice.history[3]);
+                const float interpolated = p1 + 0.5f * t * (p2 - p0 + t * (2.0f * p0 - 5.0f * p1 + 4.0f * p2 - p3 + t * (3.0f * (p1 - p2) + p3 - p0)));
+                tickEnvelope(core, index, voice);
+                const int32_t sample = (static_cast<int32_t>(std::clamp(interpolated, -32768.0f, 32767.0f)) * voice.level) >> 15;
+                const int32_t outLeft = (sample * sweepVolume(reg(base), voice.volumeLeft)) >> 15;
+                const int32_t outRight = (sample * sweepVolume(reg(base + 2u), voice.volumeRight)) >> 15;
+                const uint32_t bit = 1u << index;
+                dryLeft += (dryLeftMask & bit) ? outLeft : 0;
+                dryRight += (dryRightMask & bit) ? outRight : 0;
+                wetLeft += (wetLeftMask & bit) ? outLeft : 0;
+                wetRight += (wetRightMask & bit) ? outRight : 0;
+            }
+
+            // MMIX gates each source into the dry and wet (reverb) paths. Core input volumes are plain
+            // 16-bit values (0x7FFF = full): BVOL for the AutoDMA input, AVOL for the external input.
+            const uint16_t mmix = reg(coreBase + 0x198u);
+            const uint32_t volumes = kVolumes + static_cast<uint32_t>(core) * kVolumeStride;
+            int32_t mixDryL = (mmix & 0x800u) ? dryLeft : 0, mixDryR = (mmix & 0x400u) ? dryRight : 0;
+            int32_t mixWetL = (mmix & 0x200u) ? wetLeft : 0, mixWetR = (mmix & 0x100u) ? wetRight : 0;
+            if (c.input.empty() && c.ringRam != nullptr)
+                pullRingBlock(c);
+            if (!c.input.empty())
+            {
+                const int32_t inL = (c.input.front().first * static_cast<int16_t>(reg(volumes + 12u))) >> 15;
+                const int32_t inR = (c.input.front().second * static_cast<int16_t>(reg(volumes + 14u))) >> 15;
+                c.input.pop_front();
+                mixDryL += (mmix & 0x80u) ? inL : 0;
+                mixDryR += (mmix & 0x40u) ? inR : 0;
+                mixWetL += (mmix & 0x20u) ? inL : 0;
+                mixWetR += (mmix & 0x10u) ? inR : 0;
+            }
+            const int32_t exL = (extLeft * static_cast<int16_t>(reg(volumes + 8u))) >> 15;
+            const int32_t exR = (extRight * static_cast<int16_t>(reg(volumes + 10u))) >> 15;
+            mixDryL += (mmix & 0x8u) ? exL : 0;
+            mixDryR += (mmix & 0x4u) ? exR : 0;
+            mixWetL += (mmix & 0x2u) ? exL : 0;
+            mixWetR += (mmix & 0x1u) ? exR : 0;
+
+            // Reverb runs at 24 kHz: average two input samples, interpolate the output back to 48 kHz.
+            int32_t revL = 0, revR = 0;
+            if ((reg(coreBase + 0x19Au) & 0x80u) != 0u) // ATTR: effects enabled
+            {
+                if (c.reverbOdd)
+                {
+                    c.reverbPrevLeft = c.reverbLeft;
+                    c.reverbPrevRight = c.reverbRight;
+                    reverbStep(core, (mixWetL + c.reverbInLeft) / 2, (mixWetR + c.reverbInRight) / 2, c.reverbLeft, c.reverbRight);
+                    revL = c.reverbPrevLeft;
+                    revR = c.reverbPrevRight;
+                }
+                else
+                {
+                    c.reverbInLeft = mixWetL;
+                    c.reverbInRight = mixWetR;
+                    revL = (c.reverbPrevLeft + c.reverbLeft) / 2;
+                    revR = (c.reverbPrevRight + c.reverbRight) / 2;
+                }
+                c.reverbOdd = !c.reverbOdd;
+                revL = (revL * static_cast<int16_t>(reg(volumes + 4u))) >> 15; // EVOL
+                revR = (revR * static_cast<int16_t>(reg(volumes + 6u))) >> 15;
+            }
+            extLeft = (clamp16(mixDryL + revL) * sweepVolume(reg(volumes), c.masterLeft)) >> 15;
+            extRight = (clamp16(mixDryR + revR) * sweepVolume(reg(volumes + 2u), c.masterRight)) >> 15;
+        }
+        left = extLeft;
+        right = extRight;
+    }
+
+    void Spu2::render(uint64_t iopCycle, std::vector<int16_t> &out)
+    {
+        if (!m_started || iopCycle < m_cycle || iopCycle - m_cycle > 48000ull * kCyclesPerSample)
+        {
+            m_started = true;
+            m_cycle = iopCycle; // first call, or more than 1 s behind: don't render a backlog
+            return;
+        }
+        while (m_cycle + kCyclesPerSample <= iopCycle)
+        {
+            int32_t left = 0, right = 0;
+            mixOne(left, right);
+            out.push_back(clamp16(left));
+            out.push_back(clamp16(right));
+            m_cycle += kCyclesPerSample;
+        }
+    }
+}
diff --git a/ps2xIOP/src/emulator/core/spu2.h b/ps2xIOP/src/emulator/core/spu2.h
new file mode 100644
index 0000000..f064669
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/spu2.h
@@ -0,0 +1,116 @@
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <deque>
+#include <utility>
+#include <vector>
+
+namespace ps2x::iop::detail
+{
+    // PS2 sound chip (SPU2): two cores with 24 ADPCM voices each, 2 MB sound RAM, DMA and the
+    // AutoDMA PCM input (libsd sceSdBlockTrans streams). Output: 48 kHz stereo.
+    // ponytail: no noise, pitch modulation or SPU IRQ yet (Gregory Horror Show never sets NON/PMON
+    // or the IRQ enable); add them when a game needs them. Reverb runs at 24 kHz with averaging and
+    // linear resampling instead of the hardware's FIR filters.
+    class Spu2
+    {
+    public:
+        static constexpr uint32_t kBase = 0x1F900000u;
+        static constexpr uint32_t kRegisterBytes = 0x800u;
+        static constexpr uint32_t kCyclesPerSample = 768u; // 36.864 MHz IOP clock / 48 kHz
+
+        Spu2();
+        void reset();
+
+        [[nodiscard]] static bool handles(uint32_t phys) noexcept { return phys >= kBase && phys < kBase + kRegisterBytes; }
+        [[nodiscard]] uint16_t read16(uint32_t phys) const;
+        void write16(uint32_t phys, uint16_t value);
+
+        // IOP DMA channel 4 (core 0) / 7 (core 1). toDevice: `bytes` from `ram` into sound RAM at
+        // TSA, or into the core's PCM input while AutoDMA (ADMAS) is on; otherwise sound RAM -> ram.
+        void dma(int core, uint8_t *ram, size_t bytes, bool toDevice);
+
+        // GHS: AutoDMA from an IOP RAM ring outside the IOP DMA engine (PS2Recomp's EE-side sceSdRemote
+        // BlockTrans stub): the core reads the next 0x400-byte block (0x200 bytes left, then 0x200 right)
+        // whenever its input runs dry, so the stream runs on the SPU2's own clock. size 0 stops it.
+        void autoDmaRing(int core, const uint8_t *iopRam, uint32_t base, uint32_t size, uint32_t offset);
+        // Ring offset the core reads next. Each poll lets the core read up to one block short of a full lap
+        // further, so a very late poll starves the stream instead of losing a lap of the game's audio clock.
+        [[nodiscard]] uint32_t autoDmaPoll(int core);
+
+        // Renders up to `iopCycle`, appending interleaved 16-bit stereo samples to `out`.
+        void render(uint64_t iopCycle, std::vector<int16_t> &out);
+
+    private:
+        enum class Phase : uint8_t
+        {
+            Off,
+            Attack,
+            Decay,
+            Sustain,
+            Release,
+        };
+
+        struct Sweep
+        {
+            int32_t level = 0; // current volume (VOLX), signed
+            uint32_t counter = 0;
+        };
+
+        struct Voice
+        {
+            Phase phase = Phase::Off;
+            int32_t level = 0;          // ENVX, 0..0x7FFF
+            uint32_t envCounter = 0;
+            uint32_t nax = 0;           // next block (halfword address)
+            uint32_t lsa = 0;           // loop start
+            bool lsaWritten = false;    // LSAX written since the last key on
+            bool loopManual = false;    // loop start set by the game, block flags don't move it
+            bool blockStarted = false;
+            uint8_t blockFlags = 0;
+            int pos = 28;               // next sample in `decoded`
+            int32_t prev1 = 0, prev2 = 0;
+            std::array<int16_t, 28> decoded{};
+            std::array<int32_t, 4> history{};
+            uint32_t counter = 0;       // pitch phase, 0x1000 = one sample
+            Sweep volumeLeft, volumeRight;
+        };
+
+        struct Core
+        {
+            std::array<Voice, 24> voices;
+            uint32_t endx = 0;
+            std::deque<std::pair<int16_t, int16_t>> input; // AutoDMA PCM
+            const uint8_t *ringRam = nullptr;               // autoDmaRing source (IOP RAM), null = none
+            uint32_t ringBase = 0, ringSize = 0, ringRead = 0, ringSincePoll = 0;
+            Sweep masterLeft, masterRight;
+            uint32_t reverbPos = 0;
+            bool reverbOdd = false;
+            int32_t reverbInLeft = 0, reverbInRight = 0;
+            int32_t reverbLeft = 0, reverbRight = 0, reverbPrevLeft = 0, reverbPrevRight = 0;
+        };
+
+        [[nodiscard]] uint16_t &reg(uint32_t offset) { return m_regs[(offset & (kRegisterBytes - 1u)) >> 1u]; }
+        [[nodiscard]] uint16_t reg(uint32_t offset) const { return m_regs[(offset & (kRegisterBytes - 1u)) >> 1u]; }
+        [[nodiscard]] uint32_t address(uint32_t hiOffset) const;
+        void setAddress(uint32_t hiOffset, uint32_t value);
+
+        void queueInputBlocks(Core &c, const uint8_t *blocks, size_t bytes);
+        void pullRingBlock(Core &c);
+        void keyOn(int core, int firstVoice, uint16_t bits);
+        void keyOff(int core, int firstVoice, uint16_t bits);
+        int16_t nextSample(int core, int voiceIndex, Voice &voice);
+        void decodeBlock(Voice &voice);
+        void tickEnvelope(int core, int voiceIndex, Voice &voice);
+        static int32_t sweepVolume(uint16_t value, Sweep &sweep);
+        void reverbStep(int core, int32_t inLeft, int32_t inRight, int32_t &outLeft, int32_t &outRight);
+        void mixOne(int32_t &left, int32_t &right);
+
+        std::array<uint16_t, kRegisterBytes / 2u> m_regs{};
+        std::vector<uint16_t> m_ram; // 1M halfwords
+        std::array<Core, 2> m_cores{};
+        uint64_t m_cycle = 0;
+        bool m_started = false;
+    };
+}
