+    static const int check3 = [] { const char *v = std::getenv("GHS_VU_CHECK3"); return v ? std::max(1, std::atoi(v)) : 0; }();
+    static uint64_t check3Calls = 0;
+    if (check2 && m_unit == Unit::VU1 && memory && vuCode == memory->getVU1Code())
+        VU1Fast::Driver::runChecked2(*this, vuData, dataSize, memory, body);
+    else if (check3 && m_unit == Unit::VU1 && memory && vuCode == memory->getVU1Code() && ++check3Calls % check3 == 0u)
+        VU1Fast::Driver::runChecked3(*this, vuData, dataSize, memory, body);
+    else if (check3 && m_unit == Unit::VU1)
+    {
+        g_vuAllFlags = false; // runChecked3 leaves it on
+        body(true);
+    }
+    else
+        body(true);
+    g_ghsRunNs += std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - ghsRunStart).count(); // GHS-TRACE
     m_state.cycles = m_cycle;
     if (useVuRounding && previousRoundingMode != -1)
         std::fesetround(previousRoundingMode);
