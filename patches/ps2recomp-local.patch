+        const auto vt = [&](uint32_t lane) { return static_cast<double>(vuNormalizeOperand(vft[lane])); };
+        const auto acc = [&](uint32_t lane) { return static_cast<double>(vuNormalizeOperand(state.acc[lane])); };
+        const double q = vuNormalizeOperand(state.q);
+        const double i = vuNormalizeOperand(state.i);
+
+        enum Form { Add, Sub, MulAdd, MulSub, Mul };
+        Form form;
+        int broadcast = -1;  // vt lane for every component, or -1 for the matching lane
+        double scalar = 0.0;
+        bool useScalar = false;
